#!/usr/bin/env python3
"""Run tokscale with an optionally Git-backed aggregate repository.

The remote repository is authoritative before each run.  Local changes are
discarded with reset/clean; after tokscale exits, changes are committed and a
plain fast-forward-only push is attempted.  This intentionally never rebases
or merges remote changes.
"""

from __future__ import annotations

import os
import shutil
import socket
import subprocess
import sys
from pathlib import Path


REPO_DIR = Path.home() / ".cache" / "tokscale-config-repo"
DEFAULT_GITIGNORE = """# The remote repository stores only device aggregates.
*
!.gitignore
!devices/
!devices/**
"""


def warn(message: str) -> None:
    print(f"tokscale wrapper: warning: {message}", file=sys.stderr)


def machine_hostname() -> str:
    hostname = socket.gethostname().strip()
    return " ".join(hostname.split()) or "unknown-host"


def git(*args: str, cwd: Path | None = None, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", *args],
        cwd=cwd,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=check,
    )


def fail_git(operation: str, result: subprocess.CompletedProcess[str]) -> int:
    detail = (result.stderr or result.stdout).strip()
    warn(f"{operation} failed{': ' + detail if detail else ''}")
    return 1


def remote_branch(repo: Path) -> str | None:
    result = git("ls-remote", "--symref", "origin", "HEAD", cwd=repo, check=False)
    if result.returncode != 0:
        return None
    for line in result.stdout.splitlines():
        if line.startswith("ref: refs/heads/") and line.endswith(" HEAD"):
            return line[len("ref: refs/heads/") : -len(" HEAD")]
    # Some valid remotes do not advertise a symbolic HEAD.  Use their first
    # branch in that case; an actually empty remote still returns None.
    heads = git("ls-remote", "--heads", "origin", cwd=repo, check=False)
    if heads.returncode == 0:
        for line in heads.stdout.splitlines():
            fields = line.split()
            if len(fields) == 2 and fields[1].startswith("refs/heads/"):
                return fields[1][len("refs/heads/") :]
    return None


def local_branch(repo: Path) -> str | None:
    result = git("symbolic-ref", "--quiet", "--short", "HEAD", cwd=repo, check=False)
    return result.stdout.strip() if result.returncode == 0 else None


def prepare_repo(remote: str) -> Path | None:
    REPO_DIR.parent.mkdir(parents=True, exist_ok=True)

    if not REPO_DIR.exists():
        result = subprocess.run(
            ["git", "clone", remote, str(REPO_DIR)],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        if result.returncode != 0:
            fail_git("clone", result)
            return None
    elif not (REPO_DIR / ".git").exists():
        warn(f"{REPO_DIR} exists but is not a Git checkout; refusing to replace it")
        return None

    try:
        current_remote_result = git("remote", "get-url", "origin", cwd=REPO_DIR, check=False)
        if current_remote_result.returncode != 0:
            git("remote", "add", "origin", remote, cwd=REPO_DIR)
        elif current_remote_result.stdout.strip() != remote:
            git("remote", "set-url", "origin", remote, cwd=REPO_DIR)
    except subprocess.CalledProcessError as exc:
        warn(f"cannot configure origin: {exc}")
        return None

    fetched = git("fetch", "origin", cwd=REPO_DIR, check=False)
    if fetched.returncode != 0:
        fail_git("fetch", fetched)
        return None

    branch = remote_branch(REPO_DIR)
    if branch:
        # The remote HEAD is the source of truth.  Remove ordinary untracked
        # files, but preserve ignored machine-local caches and lock files.
        reset = git("reset", "--hard", f"origin/{branch}", cwd=REPO_DIR, check=False)
        if reset.returncode != 0:
            fail_git("reset to remote HEAD", reset)
            return None
        cleaned = git("clean", "-fd", cwd=REPO_DIR, check=False)
        if cleaned.returncode != 0:
            fail_git("clean local changes", cleaned)
            return None
    else:
        # A reachable but empty bare repo has no HEAD/branch to reset to.
        # Bootstrap a conventional main branch locally; the post-run commit
        # will become the remote's first commit.
        branch = local_branch(REPO_DIR)
        if not branch:
            created = git("symbolic-ref", "HEAD", "refs/heads/main", cwd=REPO_DIR, check=False)
            if created.returncode != 0:
                fail_git("initialize main branch for empty remote", created)
                return None

    ignore = REPO_DIR / ".gitignore"
    if not ignore.exists():
        ignore.write_text(DEFAULT_GITIGNORE, encoding="utf-8")
        added = git("add", ".gitignore", cwd=REPO_DIR, check=False)
        if added.returncode != 0:
            fail_git("stage .gitignore", added)
            return None

    (REPO_DIR / "devices").mkdir(exist_ok=True)
    return REPO_DIR


def commit_and_push(repo: Path, branch: str | None) -> None:
    added = git("add", "--", ".gitignore", "devices", cwd=repo, check=False)
    if added.returncode != 0:
        fail_git("stage local changes", added)
        return

    status = git("diff", "--cached", "--quiet", cwd=repo, check=False)
    if status.returncode == 1:
        committed = git(
            "commit",
            "-m",
            f"chore: sync tokscale local state ({machine_hostname()})",
            cwd=repo,
            check=False,
        )
        if committed.returncode != 0:
            fail_git("commit", committed)
    elif status.returncode != 0:
        fail_git("check staged changes", status)

    if not branch:
        warn("cannot push: remote default branch is unavailable")
        return
    pushed = git("push", "origin", f"HEAD:refs/heads/{branch}", cwd=repo, check=False)
    if pushed.returncode != 0:
        fail_git("push (remote changed or unavailable; no merge/rebase attempted)", pushed)


def main() -> int:
    remote = os.environ.get("TOKSCALE_REMOTE", "").strip()
    child_env = os.environ.copy()

    if remote:
        repo = prepare_repo(remote)
        if repo is None:
            return 1
        try:
            result = subprocess.run(["bunx", "tokscale", *sys.argv[1:]], env=child_env)
        finally:
            # A failed command still gets its local config committed/pushed.
            commit_and_push(repo, remote_branch(repo) or local_branch(repo))
        return result.returncode

    return subprocess.run(["bunx", "tokscale", *sys.argv[1:]], env=child_env).returncode


if __name__ == "__main__":
    if shutil.which("git") is None or shutil.which("bunx") is None:
        warn("git and bunx must both be installed")
        raise SystemExit(1)
    raise SystemExit(main())
