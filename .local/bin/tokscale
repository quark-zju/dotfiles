#!/usr/bin/env python3
"""Run tokscale with an optionally Git-backed aggregate repository.

The remote repository is authoritative before each run.  Local changes are
discarded with reset/clean; after tokscale exits, changes are committed and a
plain fast-forward-only push is attempted.  This intentionally never rebases
or merges remote changes.
"""

from __future__ import annotations

import os
import shutil
import socket
import subprocess
import sys
from datetime import datetime, timezone
from html import escape
import json
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import unquote, urlparse

REPO_DIR = Path.home() / ".cache" / "tokscale-config-repo"
TOKSCALE_COMMAND = ["bunx", "tokscale@latest"]


def _day_totals(clients: list[dict[str, object]]) -> tuple[dict[str, object], dict[str, int]]:
    totals: dict[str, object] = {"tokens": 0, "cost": 0.0, "messages": 0}
    breakdown = {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "reasoning": 0}
    for item in clients:
        tokens = item.get("tokens") or {}
        totals["tokens"] = int(totals["tokens"]) + sum(int(tokens.get(key, 0) or 0) for key in breakdown)
        totals["cost"] = float(totals["cost"]) + float(item.get("cost", 0) or 0)
        totals["messages"] = int(totals["messages"]) + int(item.get("messages", 0) or 0)
        for key in breakdown:
            breakdown[key] += int(tokens.get(key, 0) or 0)
    return totals, breakdown


def _rebuild_day(day: dict[str, object], clients: list[dict[str, object]]) -> dict[str, object]:
    result = dict(day)
    clients = sorted(
        clients,
        key=lambda item: (
            str(item.get("client", "")),
            str(item.get("provider", "")),
            str(item.get("modelId", "")),
        ),
    )
    totals, breakdown = _day_totals(clients)
    result["clients"] = clients
    result["totals"] = totals
    result["tokenBreakdown"] = breakdown
    return result


def _summary(days: list[dict[str, object]]) -> dict[str, object]:
    total_tokens = sum(int((d.get("totals") or {}).get("tokens", 0) or 0) for d in days)
    total_cost = sum(float((d.get("totals") or {}).get("cost", 0) or 0) for d in days)
    clients = sorted({c.get("client") for d in days for c in d.get("clients") or [] if c.get("client")})
    models = sorted({c.get("modelId") for d in days for c in d.get("clients") or [] if c.get("modelId")})
    return {
        "totalTokens": total_tokens,
        "totalCost": total_cost,
        "totalDays": len(days),
        "activeDays": sum(1 for d in days if (d.get("totals") or {}).get("tokens", 0) > 0),
        "averagePerDay": total_tokens / len(days) if days else 0,
        "maxCostInSingleDay": max((float((d.get("totals") or {}).get("cost", 0) or 0) for d in days), default=0),
        "clients": clients,
        "models": models,
    }


def merge_device(existing: dict[str, object] | None, payload: dict[str, object]) -> dict[str, object]:
    """Merge a submit snapshot without mutating either input.

    Full-history submissions replace all dates for their scoped clients, while
    partial submissions replace only the client cells they actually contain.

    >>> p = {"device": {"id": "d"}, "scanScope": {"fullHistory": True}, "contributions": [{"date": "2026-01-01", "clients": [{"client": "claude", "tokens": {"input": 2, "output": 1}, "cost": 0.1, "messages": 1}]}]}
    >>> merge_device(None, p)["summary"]["totalTokens"]
    3
    >>> q = {"device": {"id": "d"}, "scanScope": {"fullHistory": False}, "summary": {"clients": ["claude"]}, "contributions": [{"date": "2026-01-01", "clients": [{"client": "claude", "tokens": {"input": 3, "output": 1}, "cost": 0.2, "messages": 1}]}]}
    >>> merge_device(merge_device(None, p), q)["summary"]["totalTokens"]
    4
    """
    from copy import deepcopy
    from datetime import date

    old = deepcopy(existing or {})
    incoming = deepcopy(payload)
    full_history = bool((incoming.get("scanScope") or {}).get("fullHistory"))
    scope = set((incoming.get("summary") or {}).get("clients") or [])
    scope.update(((incoming.get("scanScope") or {}).get("parserVersions") or {}).keys())
    for day in incoming.get("contributions") or []:
        scope.update(c.get("client") for c in day.get("clients") or [] if c.get("client"))
    days = {d["date"]: deepcopy(d) for d in old.get("contributions") or [] if isinstance(d, dict) and d.get("date")}
    if full_history:
        for key, day in list(days.items()):
            kept = [c for c in day.get("clients") or [] if c.get("client") not in scope]
            if kept:
                days[key] = _rebuild_day(day, kept)
            else:
                del days[key]
    for incoming_day in incoming.get("contributions") or []:
        key = incoming_day.get("date")
        if not key:
            continue
        old_day = days.get(key, {"date": key})
        new_clients = incoming_day.get("clients") or []
        names = {c.get("client") for c in new_clients if c.get("client")}
        kept = [c for c in old_day.get("clients") or [] if c.get("client") not in names]
        days[key] = _rebuild_day({**old_day, **incoming_day}, kept + new_clients)
    ordered = [
        _rebuild_day(days[key], days[key].get("clients") or [])
        for key in sorted(days, key=date.fromisoformat)
    ]
    result = old
    result.update({k: deepcopy(incoming[k]) for k in ("device", "meta", "scanScope", "mcpServers") if k in incoming})
    result["contributions"] = ordered
    result["summary"] = _summary(ordered)
    if "timeMetrics" in incoming:
        if full_history or not old.get("timeMetrics"):
            result["timeMetrics"] = incoming["timeMetrics"]
        else:
            result["timeMetrics"] = {k: max(int((old["timeMetrics"] or {}).get(k, 0) or 0), int((incoming["timeMetrics"] or {}).get(k, 0) or 0)) for k in ("totalActiveTimeMs", "longestContinuousMs", "maxConcurrentSessions", "sessionCount")}
    return result


def warn(message: str) -> None:
    print(f"tokscale wrapper: warning: {message}", file=sys.stderr)


def machine_hostname() -> str:
    hostname = socket.gethostname().strip()
    return " ".join(hostname.split()) or "unknown-host"


def git(*args: str, cwd: Path | None = None, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", *args],
        cwd=cwd,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=check,
    )


def fail_git(operation: str, result: subprocess.CompletedProcess[str]) -> int:
    detail = (result.stderr or result.stdout).strip()
    warn(f"{operation} failed{': ' + detail if detail else ''}")
    return 1


def remote_branch(repo: Path) -> str | None:
    result = git("ls-remote", "--symref", "origin", "HEAD", cwd=repo, check=False)
    if result.returncode != 0:
        return None
    for line in result.stdout.splitlines():
        if line.startswith("ref: refs/heads/") and line.endswith(" HEAD"):
            return line[len("ref: refs/heads/") : -len(" HEAD")]
    # Some valid remotes do not advertise a symbolic HEAD.  Use their first
    # branch in that case; an actually empty remote still returns None.
    heads = git("ls-remote", "--heads", "origin", cwd=repo, check=False)
    if heads.returncode == 0:
        for line in heads.stdout.splitlines():
            fields = line.split()
            if len(fields) == 2 and fields[1].startswith("refs/heads/"):
                return fields[1][len("refs/heads/") :]
    return None


def local_branch(repo: Path) -> str | None:
    result = git("symbolic-ref", "--quiet", "--short", "HEAD", cwd=repo, check=False)
    return result.stdout.strip() if result.returncode == 0 else None


def prepare_repo(remote: str) -> Path | None:
    REPO_DIR.parent.mkdir(parents=True, exist_ok=True)

    if not REPO_DIR.exists():
        result = subprocess.run(
            ["git", "clone", remote, str(REPO_DIR)],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        if result.returncode != 0:
            fail_git("clone", result)
            return None
    elif not (REPO_DIR / ".git").exists():
        warn(f"{REPO_DIR} exists but is not a Git checkout; refusing to replace it")
        return None

    try:
        current_remote_result = git("remote", "get-url", "origin", cwd=REPO_DIR, check=False)
        if current_remote_result.returncode != 0:
            git("remote", "add", "origin", remote, cwd=REPO_DIR)
        elif current_remote_result.stdout.strip() != remote:
            git("remote", "set-url", "origin", remote, cwd=REPO_DIR)
    except subprocess.CalledProcessError as exc:
        warn(f"cannot configure origin: {exc}")
        return None

    fetched = git("fetch", "origin", cwd=REPO_DIR, check=False)
    if fetched.returncode != 0:
        fail_git("fetch", fetched)
        return None

    branch = remote_branch(REPO_DIR)
    if branch:
        # The remote HEAD is the source of truth.  Remove ordinary untracked
        # files, but preserve ignored machine-local caches and lock files.
        reset = git("reset", "--hard", f"origin/{branch}", cwd=REPO_DIR, check=False)
        if reset.returncode != 0:
            fail_git("reset to remote HEAD", reset)
            return None
        cleaned = git("clean", "-fd", cwd=REPO_DIR, check=False)
        if cleaned.returncode != 0:
            fail_git("clean local changes", cleaned)
            return None
    else:
        # A reachable but empty bare repo has no HEAD/branch to reset to.
        # Bootstrap a conventional main branch locally; the post-run commit
        # will become the remote's first commit.
        branch = local_branch(REPO_DIR)
        if not branch:
            created = git("symbolic-ref", "HEAD", "refs/heads/main", cwd=REPO_DIR, check=False)
            if created.returncode != 0:
                fail_git("initialize main branch for empty remote", created)
                return None

    # This repository is an aggregate store, not a Tokscale config checkout.
    # Remove files tracked by the old config-repository design, leaving only
    # devices/ plus the hostname.json mapping. There is deliberately no
    # .gitignore: every tracked file should be a device file or the mapping.
    tracked = git("ls-files", "-z", cwd=REPO_DIR, check=False)
    if tracked.returncode != 0:
        fail_git("inspect tracked aggregate files", tracked)
        return None
    stale = [
        path
        for path in tracked.stdout.split("\0")
        if path and path != "hostname.json" and not path.startswith("devices/")
    ]
    if stale:
        removed = git("rm", "-f", "--", *stale, cwd=REPO_DIR, check=False)
        if removed.returncode != 0:
            fail_git("remove old config files from aggregate repo", removed)
            return None
    old_ignore = REPO_DIR / ".gitignore"
    if old_ignore.exists():
        try:
            old_ignore.unlink()
        except OSError as exc:
            warn(f"cannot remove obsolete .gitignore: {exc}")
            return None

    (REPO_DIR / "devices").mkdir(exist_ok=True)
    return REPO_DIR


def commit_and_push(repo: Path, branch: str | None) -> None:
    added = git("add", "--", "devices", "hostname.json", cwd=repo, check=False)
    if added.returncode != 0:
        fail_git("stage local changes", added)
        return

    status = git("diff", "--cached", "--quiet", cwd=repo, check=False)
    if status.returncode == 1:
        committed = git(
            "commit",
            "-m",
            f"chore: sync tokscale local state ({machine_hostname()})",
            cwd=repo,
            check=False,
        )
        if committed.returncode != 0:
            fail_git("commit", committed)
    elif status.returncode != 0:
        fail_git("check staged changes", status)

    if not branch:
        warn("cannot push: remote default branch is unavailable")
        return
    pushed = git("push", "origin", f"HEAD:refs/heads/{branch}", cwd=repo, check=False)
    if pushed.returncode != 0:
        fail_git("push (remote changed or unavailable; no merge/rebase attempted)", pushed)


def _record_hostname(repo: Path, device_id: str) -> None:
    """Record which host contributed a device snapshot in hostname.json.

    The device id is an opaque token, not the host that produced the data, so
    the git-backed repo keeps an explicit device -> hostname map.  The host
    running the wrapper is the one that submitted, so machine_hostname() is the
    authority here.
    """
    hostname = machine_hostname()
    path = repo / "hostname.json"
    mapping: dict[str, str] = {}
    if path.exists():
        try:
            value = json.loads(path.read_text(encoding="utf-8"))
            if isinstance(value, dict):
                mapping = dict(value)
        except (OSError, json.JSONDecodeError):
            pass
    if mapping.get(device_id) == hostname:
        return
    mapping[device_id] = hostname
    tmp = repo / ".hostname.json.tmp"
    tmp.write_text(json.dumps(mapping, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.replace(tmp, path)


class _SubmitHandler(BaseHTTPRequestHandler):
    repo: Path

    def do_POST(self) -> None:  # noqa: N802 - stdlib handler API
        if self.path != "/api/submit":
            self.send_error(404)
            return
        try:
            length = int(self.headers.get("Content-Length", "0"))
            payload = json.loads(self.rfile.read(length))
            device = payload.get("device") or {"id": "legacy"}
            device_id = str(device.get("id", "")).strip()
            if not device_id or any(c not in "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._:-" for c in device_id):
                raise ValueError("payload has no valid device.id")

            devices = self.repo / "devices"
            devices.mkdir(exist_ok=True)
            existing = None
            final = devices / f"{device_id}.json"
            if final.exists():
                existing = json.loads(final.read_text(encoding="utf-8"))
            state = merge_device(existing, payload)
            state["device"] = device
            state["receivedAt"] = datetime.now(timezone.utc).isoformat()
            tmp = devices / f".{device_id}.json.tmp"
            tmp.write_text(json.dumps(state, indent=2, sort_keys=True) + "\n", encoding="utf-8")
            os.replace(tmp, final)
            _record_hostname(self.repo, device_id)

            summary = state.get("summary") or {}
            body = {
                "submissionId": f"local-{device_id}",
                "username": "local",
                "metrics": {
                    "totalTokens": summary.get("totalTokens"),
                    "totalCost": summary.get("totalCost"),
                    "activeDays": summary.get("activeDays"),
                },
                "warnings": [],
            }
            encoded = json.dumps(body).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(encoded)))
            self.end_headers()
            self.wfile.write(encoded)
        except Exception as exc:  # keep the CLI-facing server failure explicit
            body = json.dumps({"error": str(exc)}).encode()
            self.send_response(400)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

    def log_message(self, _format: str, *_args: object) -> None:
        return


def _device_files(repo: Path) -> list[Path]:
    return sorted((repo / "devices").glob("*.json"), key=lambda path: path.name)


def _load_device(path: Path) -> dict[str, object] | None:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    return value if isinstance(value, dict) else None


def _number(value: object, *, decimals: int = 2) -> str:
    try:
        return f"{float(value or 0):,.{decimals}f}"
    except (TypeError, ValueError):
        return "0"


def _usage_payload(devices: list[tuple[str, dict[str, object]]], repo: Path) -> dict[str, object]:
    """Flatten the aggregate snapshots into rows the SPA can filter/group.

    Each client entry in a device's daily contribution becomes one row carrying
    the date, device id, harness (client), model id and the inclusive token /
    cost totals.  This lets the frontend aggregate by model, host or harness
    and apply a client-side power filter without further round-trips.  The
    device -> hostname map is loaded from hostname.json so the UI can group by
    host.
    """
    rows: list[dict[str, object]] = []
    clients: set[str] = set()
    models: set[str] = set()
    start: str | None = None
    end: str | None = None
    hosts: dict[str, str] = {}
    host_path = repo / "hostname.json"
    if host_path.exists():
        try:
            value = json.loads(host_path.read_text(encoding="utf-8"))
            if isinstance(value, dict):
                hosts = {str(key): str(val) for key, val in value.items()}
        except (OSError, json.JSONDecodeError):
            pass
    for device_id, data in devices:
        for day in data.get("contributions") or []:
            date = day.get("date")
            if not isinstance(date, str) or not date:
                continue
            if start is None or date < start:
                start = date
            if end is None or date > end:
                end = date
            for client in day.get("clients") or []:
                if not isinstance(client, dict):
                    continue
                harness = str(client.get("client") or "")
                model = str(client.get("modelId") or "")
                if not harness and not model:
                    continue
                clients.add(harness)
                models.add(model)
                tokens_map = client.get("tokens") or {}
                input_t = int(tokens_map.get("input", 0) or 0)
                output_t = int(tokens_map.get("output", 0) or 0)
                cache_read = int(tokens_map.get("cacheRead", 0) or 0)
                cache_write = int(tokens_map.get("cacheWrite", 0) or 0)
                reasoning = int(tokens_map.get("reasoning", 0) or 0)
                rows.append(
                    {
                        "d": date,
                        "v": device_id,
                        "c": harness,
                        "m": model,
                        "t": input_t + output_t + cache_read + cache_write + reasoning,
                        "k": float(client.get("cost", 0) or 0),
                        "b": {
                            "i": input_t,
                            "o": output_t,
                            "cr": cache_read,
                            "cw": cache_write,
                            "r": reasoning,
                        },
                    }
                )
    return {
        "range": {"start": start, "end": end},
        "devices": [device_id for device_id, _ in devices],
        "clients": sorted(clients),
        "models": sorted(models),
        "hosts": hosts,
        "rows": rows,
    }


def _profile_page(devices: list[tuple[str, dict[str, object]]], selected: str | None = None) -> str:
    selected_data = next((data for device_id, data in devices if device_id == selected), None)
    if selected_data is None and devices:
        selected, selected_data = devices[0]
    title = "Tokscale Local Profile"
    if selected:
        title = f"Tokscale · {selected}"
    links = "".join(
        f'<li><a href="/profile/{escape(device_id)}">{escape(device_id)}</a></li>'
        for device_id, _ in devices
    ) or "<li>No device snapshots found.</li>"
    if selected_data is None:
        content = "<p>No device data is available in the repository.</p>"
    else:
        summary = selected_data.get("summary") or {}
        contributions = selected_data.get("contributions") or []
        rows = "".join(
            "<tr>"
            f"<td>{escape(str(day.get('date', '')))}</td>"
            f"<td>{_number((day.get('totals') or {}).get('tokens'), decimals=0)}</td>"
            f"<td>${_number((day.get('totals') or {}).get('cost'))}</td>"
            f"<td>{_number((day.get('totals') or {}).get('messages'), decimals=0)}</td>"
            "</tr>"
            for day in contributions
        ) or "<tr><td colspan=4>No contributions.</td></tr>"
        content = f"""
        <h1>{escape(title)}</h1>
        <p class=muted>Device: <code>{escape(selected)}</code></p>
        <section class=cards>
          <div><b>{_number(summary.get('totalTokens'), decimals=0)}</b><span>tokens</span></div>
          <div><b>${_number(summary.get('totalCost'))}</b><span>cost</span></div>
          <div><b>{_number(summary.get('activeDays'), decimals=0)}</b><span>active days</span></div>
          <div><b>{escape(', '.join(summary.get('clients') or []))}</b><span>clients</span></div>
        </section>
        <h2>Daily usage</h2>
        <table><thead><tr><th>Date</th><th>Tokens</th><th>Cost</th><th>Messages</th></tr></thead>
        <tbody>{rows}</tbody></table>
        """
    return f"""<!doctype html>
<html><head><meta charset=utf-8><meta name=viewport content="width=device-width,initial-scale=1">
<title>{escape(title)}</title><style>
body{{font:15px system-ui,sans-serif;max-width:1050px;margin:2rem auto;padding:0 1rem;color:#202124;background:#fafafa}}
a{{color:#635bff;text-decoration:none}}nav{{float:right;width:180px}}main{{margin-right:210px}}.muted{{color:#6b7280}}
.cards{{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin:1.5rem 0}}
.cards div{{background:white;border:1px solid #e5e7eb;border-radius:10px;padding:15px}}.cards b,.cards span{{display:block}}
.cards b{{font-size:1.25rem}}.cards span{{color:#6b7280;font-size:.8rem;margin-top:4px}}
table{{width:100%;border-collapse:collapse;background:white}}th,td{{padding:9px;border-bottom:1px solid #e5e7eb;text-align:left}}code{{background:#eef2ff;padding:2px 5px;border-radius:4px}}
@media(max-width:700px){{nav,main{{float:none;width:auto;margin:0}}nav{{margin-bottom:2rem}}}}
</style></head><body><nav><b>Devices</b><ul>{links}</ul></nav><main>{content}</main></body></html>"""


