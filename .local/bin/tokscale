#!/usr/bin/env python3
"""Run tokscale with an optionally Git-backed config directory.

The remote repository is authoritative before each run.  Local changes are
discarded with reset/clean; after tokscale exits, changes are committed and a
plain fast-forward-only push is attempted.  This intentionally never rebases
or merges remote changes.
"""

from __future__ import annotations

import os
import shutil
import subprocess
import sys
from pathlib import Path


STATE_DIR = Path.home() / ".cache" / "tokscale-config-repo"
DEFAULT_GITIGNORE = """# Regenerable or machine-local Tokscale state
cache/
antigravity-cache/
trae-cache/
warp-cache/
cursor-cache/
*.lock
credentials.json
*-credentials.json
"""


def warn(message: str) -> None:
    print(f"tokscale wrapper: warning: {message}", file=sys.stderr)


def git(*args: str, cwd: Path | None = None, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", *args],
        cwd=cwd,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=check,
    )


def fail_git(operation: str, result: subprocess.CompletedProcess[str]) -> int:
    detail = (result.stderr or result.stdout).strip()
    warn(f"{operation} failed{': ' + detail if detail else ''}")
    return 1


def remote_branch(repo: Path) -> str | None:
    result = git("ls-remote", "--symref", "origin", "HEAD", cwd=repo, check=False)
    if result.returncode != 0:
        return None
    for line in result.stdout.splitlines():
        if line.startswith("ref: refs/heads/") and line.endswith(" HEAD"):
            return line[len("ref: refs/heads/") : -len(" HEAD")]
    return None


def prepare_repo(remote: str) -> Path | None:
    STATE_DIR.parent.mkdir(parents=True, exist_ok=True)

    if not STATE_DIR.exists():
        result = subprocess.run(
            ["git", "clone", remote, str(STATE_DIR)],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        if result.returncode != 0:
            fail_git("clone", result)
            return None
    elif not (STATE_DIR / ".git").exists():
        warn(f"{STATE_DIR} exists but is not a Git checkout; refusing to replace it")
        return None

    try:
        current_remote_result = git("remote", "get-url", "origin", cwd=STATE_DIR, check=False)
        if current_remote_result.returncode != 0:
            git("remote", "add", "origin", remote, cwd=STATE_DIR)
        elif current_remote_result.stdout.strip() != remote:
            git("remote", "set-url", "origin", remote, cwd=STATE_DIR)
    except subprocess.CalledProcessError as exc:
        warn(f"cannot configure origin: {exc}")
        return None

    branch = remote_branch(STATE_DIR)
    if not branch:
        warn("remote has no discoverable default branch or is unavailable")
        return None

    fetched = git("fetch", "origin", cwd=STATE_DIR, check=False)
    if fetched.returncode != 0:
        fail_git("fetch", fetched)
        return None

    # The remote HEAD is the source of truth.  Remove ordinary untracked
    # files, but preserve ignored machine-local caches and lock files.
    reset = git("reset", "--hard", f"origin/{branch}", cwd=STATE_DIR, check=False)
    if reset.returncode != 0:
        fail_git("reset to remote HEAD", reset)
        return None
    cleaned = git("clean", "-fd", cwd=STATE_DIR, check=False)
    if cleaned.returncode != 0:
        fail_git("clean local changes", cleaned)
        return None

    ignore = STATE_DIR / ".gitignore"
    if not ignore.exists():
        ignore.write_text(DEFAULT_GITIGNORE, encoding="utf-8")
        added = git("add", ".gitignore", cwd=STATE_DIR, check=False)
        if added.returncode != 0:
            fail_git("stage .gitignore", added)
            return None

    return STATE_DIR


def commit_and_push(repo: Path, branch: str | None) -> None:
    added = git("add", "-A", cwd=repo, check=False)
    if added.returncode != 0:
        fail_git("stage local changes", added)
        return

    status = git("diff", "--cached", "--quiet", cwd=repo, check=False)
    if status.returncode == 1:
        committed = git(
            "commit", "-m", "chore: sync tokscale local state", cwd=repo, check=False
        )
        if committed.returncode != 0:
            fail_git("commit", committed)
    elif status.returncode != 0:
        fail_git("check staged changes", status)

    if not branch:
        warn("cannot push: remote default branch is unavailable")
        return
    pushed = git("push", "origin", f"HEAD:refs/heads/{branch}", cwd=repo, check=False)
    if pushed.returncode != 0:
        fail_git("push (remote changed or unavailable; no merge/rebase attempted)", pushed)


def main() -> int:
    remote = os.environ.get("TOKSCALE_REMOTE", "").strip()
    child_env = os.environ.copy()

    if remote:
        repo = prepare_repo(remote)
        if repo is None:
            return 1
        child_env["TOKSCALE_CONFIG_DIR"] = str(repo)

        try:
            result = subprocess.run(["bunx", "tokscale", *sys.argv[1:]], env=child_env)
        finally:
            # A failed command still gets its local config committed/pushed.
            commit_and_push(repo, remote_branch(repo))
        return result.returncode

    return subprocess.run(["bunx", "tokscale", *sys.argv[1:]], env=child_env).returncode


if __name__ == "__main__":
    if shutil.which("git") is None or shutil.which("bunx") is None:
        warn("git and bunx must both be installed")
        raise SystemExit(1)
    raise SystemExit(main())
