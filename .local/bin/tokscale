<div id="root"></div>
<script type="module">
import React, { useState, useMemo, useRef, useEffect } from "https://esm.sh/react@18.3.1";
import { createRoot } from "https://esm.sh/react-dom@18.3.1/client";
import htm from "https://esm.sh/htm@3.1.1";
const html = htm.bind(React.createElement);

/* ---------- formatting ---------- */
function fmtTokens(n) {
  n = Number(n) || 0;
  const a = Math.abs(n);
  if (a >= 1e9) return (n / 1e9).toFixed(1) + "B";
  if (a >= 1e6) return (n / 1e6).toFixed(1) + "M";
  if (a >= 1e3) return (n / 1e3).toFixed(1) + "K";
  return String(Math.round(n));
}
function fmtMoney(n) { return "$" + Number(n || 0).toFixed(2); }
function monthDay(date) {
  const d = new Date(date + "T00:00:00Z");
  return d.toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
}
function shortMonth(date) {
  const d = new Date(date + "T00:00:00Z");
  return d.toLocaleDateString("en-US", { month: "short", timeZone: "UTC" });
}
function enumerateDates(a, b) {
  const out = [];
  const d = new Date(a + "T00:00:00Z");
  const end = new Date(b + "T00:00:00Z");
  while (d <= end) { out.push(d.toISOString().slice(0, 10)); d.setUTCDate(d.getUTCDate() + 1); }
  return out;
}
function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }

/* ---------- power filter ----------
 * Tokens like:  model:gpt-5 device:dev_x harness:codex   plus bare words.
 * Whitespace-separated AND.  `key:value` is a substring match on one field;
 * bare words match any of model/device/harness.
 */
function parseFilter(str, hosts = {}) {
  const hostOf = (r) => (hosts && hosts[r.v]) || r.v;
  const terms = (str || "").split(/\s+/).filter(Boolean);
  const conds = [];
  for (const t of terms) {
    const m = /^(\w+):(.+)$/.exec(t);
    if (m) {
      const f = m[1].toLowerCase();
      const v = m[2].toLowerCase();
      if (f === "host") { conds.push((r) => String(hostOf(r)).toLowerCase().includes(v)); continue; }
      const k = f === "harness" || f === "client" ? "c" : f === "device" ? "v" : f === "model" ? "m" : null;
      conds.push((r) => (k ? String(r[k]).toLowerCase().includes(v) : true));
    } else {
      const v = t.toLowerCase();
      conds.push((r) => [r.c, r.v, r.m, hostOf(r)].some((x) => String(x).toLowerCase().includes(v)));
    }
  }
  return conds.length ? (r) => conds.every((c) => c(r)) : () => true;
}

/* ---------- chart data ---------- */
function trailingAverage(vals, w) {
  const out = [];
  const window = Math.max(1, w || 30);
  let sum = 0;
  for (let i = 0; i < vals.length; i++) { sum += vals[i]; if (i >= window) sum -= vals[i - window]; out.push(sum / Math.min(window, i + 1)); }
  return out;
}

function buildUsage(rows, metric, groupBy, smooth, hosts = {}) {
  const hostOf = (r) => (hosts && hosts[r.v]) || r.v;
  const keyOf = groupBy === "model" ? (r) => r.m : groupBy === "harness" ? (r) => r.c : (r) => hostOf(r);
  const val = metric === "cost" ? (r) => r.k : (r) => r.t;
  const byDate = new Map();
  let min = null, max = null;
  for (const r of rows) {
    const d = r.d;
    let m = byDate.get(d);
    if (!m) { m = new Map(); byDate.set(d, m); }
    const k = keyOf(r) || "(none)";
    m.set(k, (m.get(k) || 0) + val(r));
    if (min === null || d < min) min = d;
    if (max === null || d > max) max = d;
  }
  if (!min || !max) return null;
  const dates = enumerateDates(min, max);
  const keyTot = new Map();
  for (const [d, m] of byDate) for (const [k, v] of m) keyTot.set(k, (keyTot.get(k) || 0) + v);
  const desc = [...keyTot.entries()].sort((a, b) => b[1] - a[1]).map(([k]) => k);
  const MAX = 12;
  const top = desc.slice(0, MAX - 1);
  const rest = desc.slice(MAX - 1);
  const series = [];
  for (const k of top) {
    series.push({ key: k, label: k, values: dates.map((d) => byDate.get(d)?.get(k) || 0) });
  }
  if (rest.length) {
    series.push({ key: "__other__", label: "Other (" + rest.length + ")", values: dates.map((d) => { let s = 0; for (const k of rest) s += byDate.get(d)?.get(k) || 0; return s; }) });
  }
  series.forEach((s) => {
    s.total = s.values.reduce((a, b) => a + b, 0);
    s.color = colorFor(s.key, series.indexOf(s), groupBy);
  });
  series.sort((a, b) => b.total - a.total);

  const display = smooth ? series.map((s) => ({ ...s, values: trailingAverage(s.values, 30) })) : series;
  const perDateTotal = dates.map((d, i) => display.reduce((s, x) => s + x.values[i], 0));
  const yMax = Math.max(1, ...perDateTotal);
  return { dates, series: display, perDateTotal, yMax, min, max };
}

/* ---------- colors ---------- */
const PALETTE = ["#5b8def", "#3fb68b", "#e08a3c", "#c95d74", "#9a6ff0", "#4fbfc9", "#c9a227", "#6f9d3c", "#d45c5c", "#5c7ea6", "#a1662f", "#7f6fbf"];
const HARNESS_COLORS = { claude: "#d97757", codex: "#37b28a", opencode: "#3b7bd6", kimi: "#c9b500", copilot: "#6f9d3c", dsh: "#9a6ff0", gemini: "#4fbfc9", grok: "#c95d74", cursor: "#5c7ea6" };
function colorFor(key, index, groupBy) {
  if (key === "__other__") return "#6b7280";
  if (groupBy === "harness" && HARNESS_COLORS[key]) return HARNESS_COLORS[key];
  return PALETTE[index % PALETTE.length];
}

/* ---------- stacked area ---------- */
function UsageChart({ rows, metric, groupBy, smooth, hosts = {} }) {
  const data = useMemo(() => (rows.length ? buildUsage(rows, metric, groupBy, smooth, hosts) : null), [rows, metric, groupBy, smooth, hosts]);
  const wrapRef = useRef(null);
  const [hover, setHover] = useState(null);

  if (!data) return html`<div className="empty">No data matches the current filter.</div>`;

  const { dates, series, yMax } = data;
  const W = 940, H = 300, padL = 56, padR = 16, padT = 16, padB = 30;
  const plotW = W - padL - padR, plotH = H - padT - padB;
  const n = dates.length;
  const isBar = !smooth;                       // daily => stacked bars; 30d avg => stacked area
  const xAt = (i) => padL + ((i + 0.5) * plotW) / n;  // slot centres
  const yAt = (v) => padT + plotH - (v / yMax) * plotH;
  const xs = dates.map((_, i) => xAt(i));

  // Build stacked geometries (ascending total so the largest sits on top).
  // The running total resets every day, so one day never carries into the next.
  const asc = [...series].reverse();

  const barRects = [];
  if (isBar) {
    const bw = Math.max(1, Math.min(30, (plotW / n) * 0.72));
    for (let i = 0; i < n; i++) {
      let cum = 0;
      for (const s of asc) {
        const v1 = cum + s.values[i];
        if (v1 > cum) {
          const yTop = yAt(v1), yBot = yAt(cum);
          barRects.push({ s, i, x: xAt(i) - bw / 2, y: yTop, h: yBot - yTop, w: bw });
        }
        cum = v1;
      }
    }
  }

  const bands = [];
  if (!isBar) {
    const cum = new Array(n).fill(0);
    for (const s of asc) {
      const yBottom = [], yTop = [];
      for (let i = 0; i < n; i++) { yBottom.push(yAt(cum[i])); cum[i] += s.values[i]; yTop.push(yAt(cum[i])); }
      let d = `M ${xs[0]},${yTop[0]}`;
      for (let i = 1; i < n; i++) d += ` L ${xs[i]},${yTop[i]}`;
      for (let i = n - 1; i >= 0; i--) d += ` L ${xs[i]},${yBottom[i]}`;
      d += " Z";
      bands.push({ s, d });
    }
    bands.reverse(); // restore descending order for render (later = higher on top)
  }

  const ylabel = (v) => (metric === "cost" ? "$" + Math.round(v) : fmtTokens(v));
  const ticks = [];
  for (let i = 0; i <= 4; i++) ticks.push((yMax * i) / 4);
  const labelStep = Math.max(1, Math.ceil(n / 8));

  const activeIdx = hover ? clamp(hover.i, 0, n - 1) : null;
  const active = activeIdx === null ? null : {
    idx: activeIdx,
    rows: series.map((s) => ({ s, value: s.values[activeIdx] })).filter(({ value }) => value > 0).sort((a, b) => b.value - a.value),
    total: series.reduce((sum, s) => sum + s.values[activeIdx], 0),
  };

  function onMove(e) {
    const rect = wrapRef.current.getBoundingClientRect();
    const scale = rect.width / W;                       // viewBox width -> rendered px
    const plotLeftPx = padL * scale;                    // offset of plot area incl. y-axis text
    const slotWpx = (plotW * scale) / n;
    const raw = ((e.clientX - rect.left) - plotLeftPx) / slotWpx;
    const i = isBar ? clamp(Math.floor(raw), 0, n - 1) : clamp(Math.round(raw - 0.5), 0, n - 1);
    setHover({ i, x: e.clientX - rect.left, y: e.clientY - rect.top });
  }

  const tooltip = active && html`<div className="tt" style=${{ left: clamp(hover.x + 16, 12, wrapRef.current.clientWidth - 230), top: clamp(hover.y + 8, 12, wrapRef.current.clientHeight - 190) }}>
    <div className="tt-date">${monthDay(dates[active.idx])}</div>
    <div className="tt-total"><span>Total ${metric === "cost" ? "cost" : "tokens"}</span><b>${metric === "cost" ? fmtMoney(active.total) : fmtTokens(active.total)}</b></div>
    <div className="tt-list">
      ${active.rows.map(({ s, value }) => html`<div key=${s.key} className="tt-row">
        <span className="dot" style=${{ background: s.color }}></span>
        <span className="lbl">${s.label}</span><span className="val">${metric === "cost" ? fmtMoney(value) : fmtTokens(value)}</span>
      </div>`)}
    </div>
  </div>`;

  return html`<div className="chart-wrap" ref=${wrapRef} onMouseMove=${onMove} onMouseLeave=${() => setHover(null)}>
    ${tooltip}
    <svg viewBox="0 0 ${W} ${H}" className="chart" preserveAspectRatio="xMidYMid meet">
      ${ticks.map((tv) => {
        const y = yAt(tv);
        return html`<g key=${tv}>
          <line x1=${padL} y1=${y} x2=${W - padR} y2=${y} stroke="rgba(255,255,255,.06)"/>
          <text x=${padL - 8} y=${y} textAnchor="end" dominantBaseline="middle" className="ytick">${ylabel(tv)}</text>
        </g>`;
      })}
      ${isBar
        ? barRects.map((b) => html`<rect key=${b.s.key + "-" + b.i} x=${b.x} y=${b.y} width=${b.w} height=${Math.max(0, b.h)} fill=${b.s.color} fillOpacity="0.9"/>`)
        : bands.map(({ s, d }) => html`<path key=${s.key} d=${d} fill=${s.color} fillOpacity="0.72" stroke=${s.color} strokeOpacity="0.5" strokeWidth="1"/>`)}
      ${activeIdx !== null ? html`<line x1=${xAt(activeIdx)} y1=${padT} x2=${xAt(activeIdx)} y2=${padT + plotH} stroke="rgba(255,255,255,.35)" strokeDasharray="3 3"/>` : null}
      ${dates.map((d, i) => (i % labelStep === 0 ? html`<text key=${d} x=${xAt(i)} y=${H - 8} textAnchor="middle" className="xtick">${monthDay(d)}</text>` : null))}
    </svg>
    <div className="legend">
      ${series.map((s) => html`<span key=${s.key} className="legend-item">
        <span className="dot" style=${{ background: s.color }}></span>
        <span className="legend-label">${s.label}</span>
        <span className="legend-val">${metric === "cost" ? fmtMoney(s.total) : fmtTokens(s.total)}</span>
      </span>`)}
    </div>
  </div>`;
}

/* ---------- contributions heatmap ---------- */
function buildHeatmap(rows, metric) {
  const byDate = new Map();
  let min = null, max = null;
  for (const r of rows) {
    const d = r.d;
    byDate.set(d, (byDate.get(d) || 0) + (metric === "cost" ? r.k : r.t));
    if (min === null || d < min) min = d;
    if (max === null || d > max) max = d;
  }
  if (!min || !max) return { weeks: [], activeDays: 0, min, max };
  const start = new Date(min + "T00:00:00Z");
  const calStart = new Date(start);
  calStart.setUTCDate(calStart.getUTCDate() - start.getUTCDay());
  const end = new Date(max + "T00:00:00Z");
  const calEnd = new Date(end);
  calEnd.setUTCDate(calEnd.getUTCDate() + (6 - end.getUTCDay()));

  const weeks = [];
  const cur = new Date(calStart);
  while (cur <= calEnd) {
    const week = [];
    for (let i = 0; i < 7; i++) { week.push(new Date(cur)); cur.setUTCDate(cur.getUTCDate() + 1); }
    weeks.push(week);
  }
  const vals = [...byDate.values()].filter((v) => v > 0).sort((a, b) => a - b);
  const q = (p) => vals.length ? vals[Math.min(vals.length - 1, Math.floor(p * (vals.length - 1)))] : 1;
  const q1 = q(0.25), q2 = q(0.5), q3 = q(0.75);
  const level = (v) => (v <= 0 ? 0 : v <= q1 ? 1 : v <= q2 ? 2 : v <= q3 ? 3 : 4);

  const monthMarkers = [];
  let lastMonth = null;
  weeks.forEach((week, wi) => {
    const first = week.find((d) => { const k = d.toISOString().slice(0, 10); return k >= min && k <= max; });
    if (first) {
      const mo = first.toISOString().slice(0, 7);
      if (lastMonth === null || mo !== lastMonth) { monthMarkers.push({ week: wi, label: shortMonth(first.toISOString().slice(0, 10)) }); lastMonth = mo; }
    }
  });

  let activeDays = 0;
  for (const v of byDate.values()) if (v > 0) activeDays += 1;
  return { weeks, byDate, level, monthMarkers, activeDays, min, max };
}

const CELL_COLORS = ["#161b22", "#0d3a66", "#155a94", "#2077c1", "#3f9ce0"];
const DAY_LABELS = [null, "Mon", null, "Wed", null, "Fri", null];

function dayDetail(date, rows, metric) {
  const day = rows.filter((r) => r.d === date);
  let tokens = 0, cost = 0;
  const b = { i: 0, o: 0, cr: 0, cw: 0, r: 0 };
  const harness = new Map();
  for (const r of day) {
    tokens += r.t; cost += r.k;
    if (r.b) { b.i += r.b.i || 0; b.o += r.b.o || 0; b.cr += r.b.cr || 0; b.cw += r.b.cw || 0; b.r += r.b.r || 0; }
    const c = r.c || "(none)";
    harness.set(c, (harness.get(c) || 0) + (metric === "cost" ? r.k : r.t));
  }
  const harnesses = [...harness.entries()].sort((a, b2) => b2[1] - a[1]).slice(0, 5)
    .map(([name, value]) => ({ name, value, color: HARNESS_COLORS[name] || "#5b8def" }));
  return { tokens, cost, b, harnesses };
}

function ContributionHeatmap({ rows, metric }) {
  const data = useMemo(() => buildHeatmap(rows, metric), [rows, metric]);
  const wrapRef = useRef(null);
  const [hover, setHover] = useState(null);
  if (!data.weeks.length) return html`<div className="empty">No data matches the current filter.</div>`;
  const { weeks, byDate, level, monthMarkers, activeDays, min, max } = data;
  const N = weeks.length;
  const columns = `30px repeat(${N}, 11px)`;

  const detail = hover ? dayDetail(hover.date, rows, metric) : null;
  const breakdown = detail ? [
    ["Input", detail.b.i], ["Output", detail.b.o], ["Cache read", detail.b.cr],
    ["Cache write", detail.b.cw], ["Reasoning", detail.b.r],
  ].filter(([, v]) => v > 0) : [];

  function move(d, e) {
    const rect = wrapRef.current.getBoundingClientRect();
    setHover({ date: d, x: e.clientX - rect.left, y: e.clientY - rect.top });
  }

  const tooltip = detail && html`<div className="tt hm-tt" style=${{ left: clamp(hover.x + 14, 8, wrapRef.current.clientWidth - 230), top: clamp(hover.y + 6, 8, Math.max(8, wrapRef.current.clientHeight - 230)) }}>
    <div className="tt-date">${monthDay(hover.date)}</div>
    <div className="tt-total"><span>Total ${metric === "cost" ? "cost" : "tokens"}</span><b>${metric === "cost" ? fmtMoney(detail.cost) : fmtTokens(detail.tokens)}</b></div>
    ${metric === "tokens" && breakdown.length ? html`<div className="tt-break">
      ${breakdown.map(([label, v]) => html`<div key=${label} className="tt-row no-dot"><span className="lbl">${label}</span><span className="val">${fmtTokens(v)}</span></div>`)}
    </div>` : null}
    ${detail.harnesses.length ? html`<div className="tt-group">
      <div className="tt-sec">Clients</div>
      <div className="tt-break">
        ${detail.harnesses.map((h) => html`<div key=${h.name} className="tt-row">
          <span className="dot" style=${{ background: h.color }}></span>
          <span className="lbl">${h.name}</span><span className="val">${metric === "cost" ? fmtMoney(h.value) : fmtTokens(h.value)}</span>
        </div>`)}
      </div>
    </div>` : null}
  </div>`;

  return html`<div className="hm">
    <div className="hm-body" ref=${wrapRef}>
      ${tooltip}
      <div className="hm-grid" style=${{ gridTemplateColumns: columns, gridTemplateRows: `14px repeat(7, 11px)` }}>
        ${monthMarkers.map((m) => html`<span key=${m.week + "-" + m.label} className="hm-month" style=${{ gridColumn: m.week + 2, gridRow: 1 }}>${m.label}</span>`)}
        ${DAY_LABELS.map((l, di) => html`<span key=${di} className="hm-day" style=${{ gridColumn: 1, gridRow: di + 2 }}>${l || ""}</span>`)}
        ${weeks.flatMap((week, wi) => week.map((d, di) => {
          const key = d.toISOString().slice(0, 10);
          const inRange = key >= min && key <= max;
          const v = inRange ? (byDate.get(key) || 0) : 0;
          const lv = inRange && v > 0 ? level(v) : 0;
          return html`<div key=${key} className="hm-cell" style=${{ gridColumn: wi + 2, gridRow: di + 2, background: CELL_COLORS[lv], visibility: inRange ? "visible" : "hidden" }} onMouseMove=${inRange ? (e) => move(key, e) : null} onMouseLeave=${inRange ? () => setHover(null) : null}></div>`;
        }))}
      </div>
    </div>
    <div className="hm-foot">
      <span className="muted">${activeDays} active ${activeDays === 1 ? "day" : "days"}</span>
      <span className="hm-legend"><span className="muted">Less</span>${CELL_COLORS.map((c, i) => html`<span key=${i} className="hm-swatch" style=${{ background: c }}></span>`)}<span className="muted">More</span></span>
    </div>
  </div>`;
}

/* ---------- controls ---------- */
function Segmented({ value, options, onChange }) {
  return html`<div className="seg">
    ${options.map((o) => html`<button key=${o.value} className=${value === o.value ? "active" : ""} onClick=${() => onChange(o.value)}>${o.label}</button>`)}
  </div>`;
}

function Controls({ metric, setMetric, groupBy, setGroupBy, filter, setFilter, smooth, setSmooth }) {
  return html`<div className="controls">
    <label className="ctl"><span className="ctl-label">Metric</span>
      <${Segmented} value=${metric} onChange=${setMetric} options=${[{ value: "tokens", label: "Tokens" }, { value: "cost", label: "Cost" }]} />
    </label>
    <label className="ctl"><span className="ctl-label">Group by</span>
      <select value=${groupBy} onChange=${(e) => setGroupBy(e.target.value)}>
        <option value="model">Model</option>
        <option value="host">Host</option>
        <option value="harness">Harness</option>
      </select>
    </label>
    <label className="ctl grow"><span className="ctl-label">Power filter</span>
      <input className="filter" type="text" value=${filter} onChange=${(e) => setFilter(e.target.value)} placeholder="host:x13 model:gpt-5 harness:codex ..." spellCheck={false} />
    </label>
    <label className="ctl"><span className="ctl-label">Display</span>
      <${Segmented} value=${smooth ? "on" : "off"} onChange=${(v) => setSmooth(v === "on")} options=${[{ value: "off", label: "Daily (bars)" }, { value: "on", label: "30d avg" }]} />
    </label>
  </div>`;
}

/* ---------- app ---------- */
function App() {
  const [payload, setPayload] = useState(null);
  const [error, setError] = useState(null);
  const [metric, setMetric] = useState("tokens");
  const [groupBy, setGroupBy] = useState("model");
  const [filter, setFilter] = useState("");
  const [smooth, setSmooth] = useState(false);

  useEffect(() => {
    fetch("/api/usage").then((r) => r.json()).then(setPayload).catch((e) => setError(String(e)));
  }, []);

  const rows = payload?.rows || [];
  const hosts = payload?.hosts || {};
  const pred = useMemo(() => parseFilter(filter, hosts), [filter, hosts]);
  const filtered = useMemo(() => rows.filter(pred), [rows, pred]);

  const stats = useMemo(() => {
    let tokens = 0, cost = 0; const days = new Set();
    for (const r of filtered) { tokens += r.t; cost += r.k; days.add(r.d); }
    return { tokens, cost, days: days.size, start: payload?.range?.start, end: payload?.range?.end };
  }, [filtered, payload]);

  return html`<div className="page">
    <header className="head">
      <div><h1>Tokscale Aggregate</h1><p className="muted">Model usage across all hosts, from the git-backed snapshot.</p></div>
      <div className="stats">
        <div className="stat"><b>${fmtTokens(stats.tokens)}</b><span>total tokens</span></div>
        <div className="stat"><b>${fmtMoney(stats.cost)}</b><span>total cost</span></div>
        <div className="stat"><b>${stats.days}</b><span>active days</span></div>
        <div className="stat"><b>${stats.start ? monthDay(stats.start) : "–"} – ${stats.end ? monthDay(stats.end) : "–"}</b><span>date range</span></div>
      </div>
    </header>

    <${Controls} metric=${metric} setMetric=${setMetric} groupBy=${groupBy} setGroupBy=${setGroupBy} filter=${filter} setFilter=${setFilter} smooth=${smooth} setSmooth=${setSmooth} />

    ${error ? html`<div className="empty">Failed to load /api/usage: ${error}</div>` : null}
    ${!payload && !error ? html`<div className="empty">Loading…</div>` : null}

    <section className="card">
      <div className="card-head"><h2>Usage over time</h2><span className="muted">Grouped by ${groupBy} · ${smooth ? "30-day average" : "daily bars"}</span></div>
      <${UsageChart} rows=${filtered} metric=${metric} groupBy=${groupBy} smooth=${smooth} hosts=${hosts} />
    </section>

    <section className="card">
      <div className="card-head"><h2>Contributions</h2><span className="muted">${metric === "cost" ? "Cost" : "Token"} density by day</span></div>
      <${ContributionHeatmap} rows=${filtered} metric=${metric} />
    </section>
  </div>`;
}

if (typeof document !== "undefined") createRoot(document.getElementById("root")).render(html`<${App} />`);

export { App, UsageChart, ContributionHeatmap, buildUsage, buildHeatmap, parseFilter };

</script>
</body></html>
"""


class _WebHandler(BaseHTTPRequestHandler):
    repo: Path

    def do_GET(self) -> None:  # noqa: N802 - stdlib handler API
        parsed = urlparse(self.path)
        path = unquote(parsed.path).rstrip("/")
        if path == "":
            path = "/"
        devices = [(file.stem, data) for file in _device_files(self.repo) if (data := _load_device(file))]
        if path == "/api/devices":
            body = json.dumps({device_id: data for device_id, data in devices}, sort_keys=True).encode()
            content_type = "application/json"
        elif path == "/api/usage":
            body = json.dumps(_usage_payload(devices, self.repo), sort_keys=True).encode()
            content_type = "application/json"
        elif path in {"/", "/profile"}:
            body = _APP_HTML.encode()
            content_type = "text/html; charset=utf-8"
        elif path.startswith("/profile/") and path.count("/") == 2:
            device_id = path.rsplit("/", 1)[1]
            if not any(device_id == known_id for known_id, _ in devices):
                self.send_error(404)
                return
            body = _profile_page(devices, device_id).encode()
            content_type = "text/html; charset=utf-8"
        else:
            self.send_error(404)
            return
        self.send_response(200)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, _format: str, *_args: object) -> None:
        return


def run_web() -> int:
    remote = os.environ.get("TOKSCALE_REMOTE", "").strip()
    if not remote:
        warn("web mode requires TOKSCALE_REMOTE")
        return 1
    repo = prepare_repo(remote)
    if repo is None:
        return 1
    handler = type("WebHandler", (_WebHandler,), {"repo": repo})
    host = os.environ.get("TOKSCALE_WEB_HOST", "127.0.0.1")
    try:
        port = int(os.environ.get("TOKSCALE_WEB_PORT", "8000"))
    except ValueError:
        warn("TOKSCALE_WEB_PORT must be an integer")
        return 1
    try:
        server = ThreadingHTTPServer((host, port), handler)
    except OSError as exc:
        warn(f"cannot start web server on {host}:{port}: {exc}")
        return 1
    print(f"Tokscale aggregate dashboard: http://{host}:{server.server_port}/")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
    return 0


def run_dummy_submit(repo: Path) -> None:
    handler = type("SubmitHandler", (_SubmitHandler,), {"repo": repo})
    server = ThreadingHTTPServer(("127.0.0.1", 0), handler)
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    env = os.environ.copy()
    env["TOKSCALE_API_URL"] = f"http://127.0.0.1:{server.server_port}"
    # The dummy server deliberately does not authenticate, but the CLI still
    # requires some token-shaped value before it will construct the request.
    env.setdefault("TOKSCALE_API_TOKEN", "tt_local_dummy")
    try:
        result = subprocess.run([*TOKSCALE_COMMAND, "submit"], env=env)
        if result.returncode != 0:
            warn(f"dummy submit exited with status {result.returncode}")
    finally:
        server.shutdown()
        thread.join(timeout=5)


def main() -> int:
    remote = os.environ.get("TOKSCALE_REMOTE", "").strip()
    child_env = os.environ.copy()

    if sys.argv[1:] and sys.argv[1].lower() in {"web", "serve", "srv"}:
        return run_web()

    # Arguments select an explicit tokscale subcommand (for example
    # `submit` or `autosubmit`).  Those commands must remain untouched and
    # must not trigger this wrapper's aggregate synchronization flow.
    if sys.argv[1:]:
        return subprocess.run([*TOKSCALE_COMMAND, *sys.argv[1:]], env=child_env).returncode

    if remote:
        repo = prepare_repo(remote)
        if repo is None:
            return 1
        try:
            result = subprocess.run([*TOKSCALE_COMMAND], env=child_env)
        finally:
            # Submit the host's current data to the local aggregator after the
            # requested command exits, even when that command failed.
            run_dummy_submit(repo)
            # A failed command still gets the aggregate committed/pushed.
            commit_and_push(repo, remote_branch(repo) or local_branch(repo))
        return result.returncode

    return subprocess.run([*TOKSCALE_COMMAND], env=child_env).returncode


if __name__ == "__main__":
    if shutil.which("git") is None or shutil.which("bunx") is None:
        warn("git and bunx must both be installed")
        raise SystemExit(1)
    raise SystemExit(main())
