#!/usr/bin/env python3

import json
import os
import shlex
import subprocess
import sys
from pathlib import Path

ROOT_DIR = Path(__file__).resolve().parents[2]
ETT = ROOT_DIR / "bin/ett"


def focused_node(node):
    if node.get("focused"):
        return node
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        if result := focused_node(child):
            return result
    return None


def process_stat(pid):
    stat = Path(f"/proc/{pid}/stat").read_text()
    fields = stat[stat.rfind(")") + 2 :].split()
    return {
        "ppid": int(fields[1]),
        "pgrp": int(fields[2]),
        "tpgid": int(fields[5]),
    }


def descendants(pid):
    result = []
    pending = [pid]
    while pending:
        current = pending.pop()
        result.append(current)
        try:
            children = (
                Path(f"/proc/{current}/task/{current}/children").read_text().split()
            )
        except OSError:
            continue
        pending.extend(int(child) for child in children)
    return result


def process_args(pid):
    return [
        os.fsdecode(arg)
        for arg in Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
        if arg
    ]


def process_environment(pid):
    return dict(
        os.fsdecode(entry).split("=", 1)
        for entry in Path(f"/proc/{pid}/environ").read_bytes().split(b"\0")
        if b"=" in entry
    )


def local_context():
    try:
        completed = subprocess.run(
            ["swaymsg", "-t", "get_tree", "-r"],
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
        node = focused_node(json.loads(completed.stdout))
        if node is None:
            return None, None
        pid = node["pid"]

        # Sway reports foot's PID, whose direct child is the shell. The shell's
        # cwd follows cd even while it is waiting for a foreground command.
        if node.get("app_id") == "foot":
            children = Path(f"/proc/{pid}/task/{pid}/children").read_text().split()
            pid = children[0]

        cwd = Path(os.readlink(f"/proc/{pid}/cwd"))
        if not cwd.is_dir():
            cwd = None

        foreground_pgrp = process_stat(pid)["tpgid"]
        for candidate in descendants(pid):
            try:
                if process_stat(candidate)["pgrp"] != foreground_pgrp:
                    continue
                args = process_args(candidate)
                script_index = next(
                    index
                    for index, arg in enumerate(args)
                    if Path(arg).expanduser().resolve() == ETT
                )
                host = args[script_index + 1]
                environment = process_environment(candidate)
                return cwd, {
                    "client_pid": process_stat(candidate)["ppid"],
                    "et_bin": environment.get("ET_BIN"),
                    "host": host,
                }
            except (IndexError, OSError, StopIteration):
                continue
        return cwd, None
    except (
        IndexError,
        json.JSONDecodeError,
        KeyError,
        OSError,
        subprocess.CalledProcessError,
    ):
        return None, None


def remote_cwd(client_pid):
    import os

    expected = ("SSH_CLIENT_PID=%d" % client_pid).encode()
    shells = {"bash", "dash", "fish", "sh", "zsh"}
    try:
        with os.scandir("/proc") as entries:
            pids = sorted(
                (int(entry.name) for entry in entries if entry.name.isdigit()),
                reverse=True,
            )
    except OSError:
        return None

    for pid in pids:
        try:
            with open("/proc/%d/comm" % pid, encoding="utf-8") as stream:
                if stream.read().strip() not in shells:
                    continue
            with open("/proc/%d/environ" % pid, "rb") as stream:
                if expected not in stream.read().split(b"\0"):
                    continue
            cwd = os.readlink("/proc/%d/cwd" % pid)
            if os.path.isdir(cwd):
                return cwd
        except OSError:
            continue
    return None


def main():
    home = Path.home()
    cwd, remote = local_context()
    cwd = cwd or home
    command = []

    if remote is not None:
        sys.path.insert(0, str(ROOT_DIR / ".local/lib/python"))
        import ssh_sync

        if remote["et_bin"]:
            os.environ["ET_BIN"] = remote["et_bin"]
        os.environ["SSH_SYNC_ET_COMMAND"] = shlex.join(
            [str(ETT), "{host}", "-c", "{command}"]
        )
        try:
            directory = ssh_sync.call_remote(
                remote["host"],
                remote_cwd,
                remote["client_pid"],
                call_timeout=5,
            )
        except Exception:
            directory = None

        # Keep ett's -c from being interpreted as a foot option.
        command = ["--", str(ETT), remote["host"]]
        if directory:
            remote_command = "printf '\\033[2A\\033[J'; "
            remote_command += "cd -- %s 2>/dev/null || cd; " % shlex.quote(directory)
            remote_command += 'exec "${SHELL:-/bin/sh}" -l'
            command += ["-c", remote_command]

    os.execv(
        "/usr/bin/foot",
        ["foot", f"--working-directory={cwd}", *sys.argv[1:], *command],
    )


if __name__ == "__main__":
    main()
