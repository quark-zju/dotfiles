{
  "description": "Model-specific context and desktop notifications for Codex turns.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/bin/codex-hooks/codex-model-context.py",
            "timeout": 3,
            "additionalContextLimit": 100
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/bin/codex-hooks/codex-notify.py",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/bin/codex-hooks/codex-notify.py",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ]
  }
}
