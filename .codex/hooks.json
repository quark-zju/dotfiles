{
  "description": "Desktop notifications for completed Codex turns.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/bin/scripts/codex-notify.py",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/bin/scripts/codex-notify.py",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ]
  }
}
