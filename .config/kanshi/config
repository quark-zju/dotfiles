profile docked-t32p {
    output "Lenovo Group Limited LEN T32p-20 *" enable position 0,0
    output eDP-1 enable position 3840,0
    ...output "*" disable
    exec ~/bin/scripts/sway-arrange-workspaces internal
}

profile external {
    output eDP-1 enable position 0,0
    output "*" enable position 1920,0
    exec ~/bin/scripts/sway-arrange-workspaces external
}

profile laptop {
    output eDP-1 enable
}
