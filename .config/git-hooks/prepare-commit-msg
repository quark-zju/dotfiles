        def test_kimi_code_env_ignores_stale_and_unrelated_sessions(self):
            session_id = "session_01234567-89ab-cdef-0123-456789abcdef"
            records = [
                self.kimi_prompt_record("prompt"),
                {
                    "type": "llm.request",
                    "model": "kimi-k3",
                    "modelAlias": "moonshot-ai/kimi-k3",
                },
            ]
            old_env = os.environ.copy()
            try:
                with tempfile.TemporaryDirectory() as home:
                    work_dir = pathlib.Path(home) / "repo"
                    work_dir.mkdir()
                    wire_file = self.write_kimi_session(
                        home, session_id, work_dir, records
                    )
                    os.environ["HOME"] = home

                    # Transcript older than the freshness window is ignored.
                    stale = time.time() - agent_utils.KIMI_SESSION_MAX_AGE_SECONDS - 60
                    os.utime(wire_file, (stale, stale))
                    self.assertEqual(agent_utils.get_kimi_code_env(str(work_dir)), {})

                    # Fresh transcript in an unrelated directory is ignored.
                    fresh = time.time()
                    os.utime(wire_file, (fresh, fresh))
                    other_dir = pathlib.Path(home) / "other"
                    other_dir.mkdir()
                    self.assertEqual(agent_utils.get_kimi_code_env(str(other_dir)), {})
            finally:
                os.environ.clear()
                os.environ.update(old_env)

