        def write_kimi_session(
            self, home, session_id, work_dir, records, cwd_key="workDir"
        ):
            session_dir = (
                pathlib.Path(home)
                / ".kimi-code"
                / "sessions"
                / "wd_repo_0123456789ab"
                / session_id
            )
            wire_dir = session_dir / "agents" / "main"
            wire_dir.mkdir(parents=True)
            (session_dir / "state.json").write_text(
                json.dumps({cwd_key: str(work_dir)})
            )
            wire_file = wire_dir / "wire.jsonl"
            wire_file.write_text(
                "\n".join(json.dumps(record) for record in records) + "\n"
            )
            return wire_file

        def kimi_prompt_record(self, text):
            return {
                "type": "turn.prompt",
                "input": [{"type": "text", "text": text}],
                "origin": {"kind": "user"},
            }

        def kimi_bash_record(self, command):
            return {
                "type": "context.append_loop_event",
                "event": {
                    "type": "tool.call",
                    "name": "Bash",
                    "args": {"command": command},
                },
            }

        def dsh_record(self, record_type, data):
            return {"type": record_type, "data": data}

        def dsh_session_record(self, work_dir):
            return {
                "type": "session",
                "version": 0,
                "id": "session-test",
                "createdAt": 1788317802332,
                "cwd": str(work_dir),
                "delegationDepth": 0,
                "agentPreset": "standard",
            }

        def dsh_user_message(self, text, source_kind="user"):
            return self.dsh_record(
                "user/message",
                {
                    "content": [{"type": "text", "text": text}],
                    "source": {"kind": source_kind},
                    "role": "user",
                    "id": "msg-1",
                },
            )

        def dsh_bash_call(self, command):
            return self.dsh_record(
                "tool/call",
                {
                    "turn": 1,
                    "step": 1,
                    "callId": "call_00_test",
                    "name": "bash",
                    "arguments": json.dumps({"command": command}),
                },
            )

        def dsh_model_header(self, model="deepseek-v4-flash"):
            return self.dsh_record(
                "request/header",
                {
                    "header": {
                        "config": {
                            "provider": "deepseek-official",
                            "model": model,
                            "maxTokens": 256000,
                            "reasoningEffort": "high",
                        }
                    }
                },
            )

        def write_dsh_session(self, home, session_id, work_dir, records):
            munged = "--" + str(work_dir).lstrip("/").replace("/", "-") + "--"
            session_dir = pathlib.Path(home) / ".dsh" / "sessions" / munged / session_id
            session_dir.mkdir(parents=True)
            session_file = session_dir / "session.jsonl.zstd"
            payload = "\n".join(json.dumps(record) for record in records) + "\n"
            session_file.write_bytes(agent_utils.zstd_compress(payload.encode("utf-8")))
            return session_file

