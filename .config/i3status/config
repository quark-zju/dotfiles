general {
#  output_format = "dzen2"
  colors = false
  interval = 5
}

order  = "wireless _first_"
# order += "disk /"
# order += "run_watch DHCP"
# order += "run_watch VPN"
order += "ethernet _first_"
order += "battery 0"
order += "cpu_temperature 0"
order += "load"
order += "time"

wireless _first_ {
  format_up = "W: %quality at %essid, %bitrate"
  format_down = "W: down"
}

ethernet _first_ {
  # if you use %speed, i3status requires root privileges
  format_up = "E: %speed"
  format_down = "E: down"
}

battery 0 {
  # format = "%status %percentage %remaining"
  format = "%status%remaining"
}

# run_watch DHCP {
#   pidfile = "/var/run/dhclient*.pid"
# }

# run_watch VPN {
#   pidfile = "/var/run/vpnc/pid"
# }

time {
  format = "%a %Y-%m-%d %H:%M"
}

load {
  format = "%1min"
}

cpu_temperature 0 {
  format = "%degrees °C"
}

