{
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "python3 ~/bin/codex-hooks/codex-notify.py",
            "timeout": 3,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "python3 ~/bin/codex-hooks/codex-notify.py",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "python3 ~/bin/codex-hooks/codex-notify.py",
            "timeout": 3,
            "type": "command"
          }
        ]
      }
    ]
  }
}
