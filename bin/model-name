#!/usr/bin/env python3

"""Print the model name detected for the current agent session."""

import os
import sys

_LIB = os.path.abspath(
    os.path.join(os.path.dirname(os.path.realpath(__file__)), "../.local/lib/python")
)
if _LIB not in sys.path:
    sys.path.insert(0, _LIB)

import agent_utils  # noqa: E402


def main():
    print(agent_utils.get_agent_env().get("Agent-Model", ""))


if __name__ == "__main__":
    main()
