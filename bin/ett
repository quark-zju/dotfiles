#!/bin/bash

# et (eternalterminal.dev) wrapper to use a "master" connection for auth, instead of ssh.
# The first "master" connection requires ssh auth or manual auth from another connected session.
# Set ET_AUTO_SSH_AUTH=1 to run ssh directly, using a GUI SSH_ASKPASS when needed.
# It defaults to 1 when zenity is available; set it to 0 to disable.

# Note: ET_BIN could be a shell sequence, like "LD_PRELOAD=force_ipv6.so my_ssh -et".
export ET_BIN="${ET_BIN:-/bin/et}"
export ET_NO_TELEMETRY=1
export ET_AUTO_SSH_AUTH="${ET_AUTO_SSH_AUTH-1}"
if ! command -v zenity >/dev/null; then
	ET_AUTO_SSH_AUTH=0
fi

ET_HOSTPORT="$1"
ET_HOST="${ET_HOSTPORT%%:*}"                 # strip out ":port"
ET_BIN_HASH="$(printf '%s' "$ET_BIN" | cksum | awk '{print $1}')"
export SESSION_NAME="et-ssh-${ET_HOST//./_}-${ET_BIN_HASH}" # tmux session name cannot have "."

build_et_args() {
	local client_init=" export SSH_CLIENT_PID=$PPID"
	local interactive_init=" printf '\033[2A\033[J'; exec env SSH_CLIENT_PID=$PPID \"\${SHELL:-/bin/sh}\" -l"
	local has_command=0
	local -a args=()

	# et cannot set a dynamic environment variable for one connection. Prefix
	# its startup command instead; -e keeps an otherwise interactive shell open.
	while (($#)); do
		if [[ "$1" == -c || "$1" == --command ]]; then
			has_command=1
			args+=("$1")
			shift
			args+=("$client_init; $1")
			shift
		elif [[ "$1" == --command=* ]]; then
			has_command=1
			args+=("--command=$client_init; ${1#--command=}")
			shift
		else
			args+=("$1")
			shift
		fi
	done
	if ((!has_command)); then
		# Start a new shell so SSH_CLIENT_PID is part of its initial environment
		# and can be read reliably through /proc/PID/environ.
		args+=(-c "$interactive_init")
	fi
	printf -v ET_ARGS ' %q' "${args[@]}"
}

build_et_args "$@"

if tmux has-session -t $SESSION_NAME 2>/dev/null; then
	echo Authenticating via the existing master session >/dev/stderr
	# Authenticate via the existing tmux session, by using a customized ssh script
	# When run by 'et' as 'ssh', we got:
	# $1: hostname.com
	# $2: echo 'something' | etterminal --verbose=0
	ET_SSH_DIR="$HOME/.cache/et-ssh/attach"
	mkdir -p "$ET_SSH_DIR"
	cat >"$ET_SSH_DIR/ssh" <<'EOF'
#!/bin/bash
[[ "$1" == "-G" ]] && exec /usr/bin/ssh "$@"
old_idpasskey="$(tmux capture-pane -t "$SESSION_NAME" -p | grep IDPASSKEY | tail -1)"
tmux send-keys -t $SESSION_NAME " ${@: -1}" C-m
for ((i = 0; i < 200; i++)); do
  idpasskey="$(tmux capture-pane -t "$SESSION_NAME" -p | grep IDPASSKEY | tail -1)"
  if [[ -n "$idpasskey" && "$idpasskey" != "$old_idpasskey" ]]; then
    # etterminal prints the key before the router finishes registering it.
    sleep "${ET_SSH_REGISTRATION_DELAY:-1}"
    echo "$idpasskey"
    exit
  fi
  sleep 0.05
done
exit 1
EOF
	chmod +x "$ET_SSH_DIR/ssh"
	export PATH="$ET_SSH_DIR:$PATH"
	bash -lc "$ET_BIN$ET_ARGS"
elif [[ "${ET_REQUIRE_MASTER:-}" == 1 && "${ET_AUTO_SSH_AUTH:-}" != 1 ]]; then
	echo "No ET master session named $SESSION_NAME; run the interactive wrapper first" >/dev/stderr
	exit 1
else
	ET_SSH_DIR="$HOME/.cache/et-ssh/new-session"
	mkdir -p "$ET_SSH_DIR"
	cat >"$ET_SSH_DIR/ssh" <<'EOF'
#!/bin/bash
[[ "$1" == "-G" ]] && exec /usr/bin/ssh "$@"
if [[ "${ET_AUTO_SSH_AUTH:-}" == 1 ]]; then
  export SSH_ASKPASS="${SSH_ASKPASS:-${BASH_SOURCE[0]%/*}/ssh-askpass}"
  export SSH_ASKPASS_REQUIRE=force
  exec /usr/bin/ssh "$@"
fi
{
  echo 'Run from client:'
  printf '  ssh %s %q\n\n' "${@: -2:1}" "${@: -1}"
  echo 'Or, run from a connected session:'
  printf '  %s\n\n' "${@: -1}"
  echo
  echo 'Input output:'
} >/dev/tty
read i
echo "$i"
EOF
	chmod +x "$ET_SSH_DIR/ssh"
	cat >"$ET_SSH_DIR/ssh-askpass" <<'EOF'
#!/bin/bash
if [[ "$SSH_ASKPASS_PROMPT" == confirm ]]; then
  zenity --question --title='SSH confirmation' --text="$1" || exit
  echo yes
else
  exec zenity --password --title='SSH authentication' --text="$1"
fi
EOF
	chmod +x "$ET_SSH_DIR/ssh-askpass"
	if [[ "${ET_AUTO_SSH_AUTH:-}" == 1 ]]; then
		echo Starting detached master session >/dev/stderr
		MASTER_ARGS=()
		SKIP_ARG=0
		for arg in "$@"; do
			if ((SKIP_ARG)); then
				SKIP_ARG=0
			elif [[ "$arg" == -c || "$arg" == --command ]]; then
				SKIP_ARG=1
			elif [[ "$arg" != --command=* ]]; then
				MASTER_ARGS+=("$arg")
			fi
		done
		MASTER_READY=ETT_MASTER_READY
		MASTER_ARGS+=(-c "echo $MASTER_READY; exec \"\${SHELL:-/bin/sh}\" -l")
		printf -v MASTER_ET_ARGS ' %q' "${MASTER_ARGS[@]}"
		printf -v MASTER_PATH %q "$ET_SSH_DIR:$PATH"
		tmux new-session -d -s "$SESSION_NAME" \
			"ET_AUTO_SSH_AUTH=1 PATH=$MASTER_PATH $ET_BIN$MASTER_ET_ARGS" 2>/dev/null || true
		while tmux has-session -t "$SESSION_NAME" 2>/dev/null; do
			if tmux capture-pane -t "$SESSION_NAME" -p | grep -Fq "$MASTER_READY"; then
				exec "$0" "$@"
			fi
			sleep 0.1
		done
		echo "ET master session exited before becoming ready" >/dev/stderr
		exit 1
	fi
	echo Starting master session >/dev/stderr
	echo Run:
	echo PATH="$ET_SSH_DIR:"'$'"PATH" tmux new-session -s $SESSION_NAME "'""$ET_BIN$ET_ARGS""'"
	PATH="$ET_SSH_DIR:$PATH" tmux new-session -s $SESSION_NAME "$ET_BIN$ET_ARGS || sleep 30"
fi

# vim: set ts=2 sw=2 et
