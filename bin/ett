#!/bin/bash

# et (eternalterminal.dev) wrapper to use a "master" connection for auth, instead of ssh.
# The first "master" connection requires ssh auth or manual auth from another connected session.
# Set ET_AUTO_SSH_AUTH=1 to run ssh directly, using a GUI SSH_ASKPASS when needed.

# Note: ET_BIN could be a shell sequence, like "LD_PRELOAD=force_ipv6.so my_ssh -et".
export ET_BIN="${ET_BIN:-/bin/et}"
export ET_NO_TELEMETRY=1

ET_HOSTPORT="$1"
ET_HOST="${ET_HOSTPORT%%:*}"                 # strip out ":port"
ET_BIN_HASH="$(printf '%s' "$ET_BIN" | cksum | awk '{print $1}')"
export SESSION_NAME="et-ssh-${ET_HOST//./_}-${ET_BIN_HASH}" # tmux session name cannot have "."
printf -v ET_ARGS ' %q' "$@"

if tmux has-session -t $SESSION_NAME 2>/dev/null; then
	echo Authenticating via the existing master session >/dev/stderr
	# Authenticate via the existing tmux session, by using a customized ssh script
	# When run by 'et' as 'ssh', we got:
	# $1: hostname.com
	# $2: echo 'something' | etterminal --verbose=0
	ET_SSH_DIR="$HOME/.cache/et-ssh/attach"
	mkdir -p "$ET_SSH_DIR"
	cat >"$ET_SSH_DIR/ssh" <<'EOF'
#!/bin/bash
[[ "$1" == "-G" ]] && exec /usr/bin/ssh "$@"
tmux send-keys -t $SESSION_NAME " ${@: -1}" C-m
sleep 0.5
tmux capture-pane -t $SESSION_NAME -p | grep IDPASSKEY | tail -1
EOF
	chmod +x "$ET_SSH_DIR/ssh"
	export PATH="$ET_SSH_DIR:$PATH"
	bash -lc "$ET_BIN$ET_ARGS"
elif [[ "${ET_REQUIRE_MASTER:-}" == 1 && "${ET_AUTO_SSH_AUTH:-}" != 1 ]]; then
	echo "No ET master session named $SESSION_NAME; run the interactive wrapper first" >/dev/stderr
	exit 1
else
	ET_SSH_DIR="$HOME/.cache/et-ssh/new-session"
	mkdir -p "$ET_SSH_DIR"
	cat >"$ET_SSH_DIR/ssh" <<'EOF'
#!/bin/bash
[[ "$1" == "-G" ]] && exec /usr/bin/ssh "$@"
if [[ "${ET_AUTO_SSH_AUTH:-}" == 1 ]]; then
  export SSH_ASKPASS="${SSH_ASKPASS:-${BASH_SOURCE[0]%/*}/ssh-askpass}"
  export SSH_ASKPASS_REQUIRE=force
  exec /usr/bin/ssh "$@"
fi
{
  echo 'Run from client:'
  printf '  ssh %s %q\n\n' "${@: -2:1}" "${@: -1}"
  echo 'Or, run from a connected session:'
  printf '  %s\n\n' "${@: -1}"
  echo
  echo 'Input output:'
} >/dev/tty
read i
echo "$i"
EOF
	chmod +x "$ET_SSH_DIR/ssh"
	cat >"$ET_SSH_DIR/ssh-askpass" <<'EOF'
#!/bin/bash
if [[ "$SSH_ASKPASS_PROMPT" == confirm ]]; then
  /usr/bin/zenity --question --title='SSH confirmation' --text="$1" || exit
  echo yes
else
  exec /usr/bin/zenity --password --title='SSH authentication' --text="$1"
fi
EOF
	chmod +x "$ET_SSH_DIR/ssh-askpass"
	if [[ "${ET_AUTO_SSH_AUTH:-}" == 1 && ! -t 0 ]]; then
		echo Authenticating directly via ssh >/dev/stderr
		export PATH="$ET_SSH_DIR:$PATH"
		exec bash -lc "$ET_BIN$ET_ARGS"
	fi
	echo Starting master session >/dev/stderr
	echo Run:
	echo PATH="$ET_SSH_DIR:"'$'"PATH" tmux new-session -s $SESSION_NAME "'""$ET_BIN$ET_ARGS""'"
	PATH="$ET_SSH_DIR:$PATH" tmux new-session -s $SESSION_NAME "$ET_BIN$ET_ARGS || sleep 30"
fi

# vim: set ts=2 sw=2 et
