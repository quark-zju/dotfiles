#!/usr/bin/env python3
"""Browse a public-inbox v2 mirror through an on-demand SQLite index.

  pi-mail [ls] [--days N] [-a AUTHOR] [-g SUBJECT]    list recent mails
  pi-mail show  SEL... [--days N] [-v]                print the mail(s)
  pi-mail reply SEL [-o FILE]                         edit a reply draft (or write FILE)
  pi-mail tree  SEL... [--days N]                     thread tree(s)
  pi-mail fetch                                       update every registered inbox
  pi-mail stats                                       show index statistics
  pi-mail config edit                                 edit the Python configuration
  pi-mail tui                                         browse related threads

SEL is a commit hash shown by `ls`/`tree`, a Message-ID, a lore URL, or
otherwise a regex matched against subjects within --days. `show` and `tree`
accept multiple selectors and handle every match; `reply` needs exactly one.
`reply` drops your own addresses from Cc; add extra ones with
`git config --global --add pimail.self ADDRESS`.
Without `-o`, it keeps a Git-tracked draft under the XDG state directory and
opens $EDITOR (or nvim). With `-o`, it only writes the generated template.
The inbox defaults to ~/public-inbox/git/git (override with $PI_INBOX).
Update every inbox recorded in the index with `pi-mail fetch`.
"""

import argparse
import email
import email.policy
import email.utils
import glob
import io
import os
import re
import runpy
import shlex
import sqlite3
import subprocess
import sys
import tempfile
import time
from datetime import datetime

INBOX = os.path.expanduser(os.environ.get("PI_INBOX", "~/public-inbox/git/git"))
CACHE = os.path.join(os.path.expanduser(os.environ.get("XDG_CACHE_HOME", "~/.cache")),
                     "pi-mail", "index.sqlite3")
CONFIG = os.path.join(os.path.expanduser(os.environ.get("XDG_CONFIG_HOME", "~/.config")),
                      "pi-mail", "config.py")
STATE_DIR = os.path.join(os.path.expanduser(
    os.environ.get("XDG_STATE_HOME", "~/.local/state")), "pi-mail")
STATE_DB = os.path.join(STATE_DIR, "state.sqlite3")
DRAFT_DIR = os.path.join(STATE_DIR, "draft")
POLICY = email.policy.default
THREAD_HEADERS = {b"message-id", b"in-reply-to", b"references"}
BYTE_IDS = re.compile(rb"<([^>]+)>")
CONFIG_TEMPLATE = '''\
def prepare_reply_body(body, headers):
    """Post-process the body generated by `pi-mail reply`."""
    return body
'''


def epochs():
    dirs = glob.glob(os.path.join(INBOX, "*.git"))
    if not dirs:
        sys.exit(f"no epochs under {INBOX}")
    return sorted(dirs, key=lambda d: int(os.path.basename(d).split(".")[0]), reverse=True)


def git(gitdir, *args):
    return subprocess.run(["git", f"--git-dir={gitdir}", *args],
                          capture_output=True, text=True, check=True).stdout


def ids(header):
    return re.findall(r"<([^>]+)>", str(header or ""))


def first_id(header):
    found = ids(header)
    return found[0] if found else None


class Blobs:
    """Read `<commit>:m` blobs through one `git cat-file --batch` per epoch."""

    def __init__(self):
        self.procs = {}

    def read(self, gitdir, commit):
        p = self.procs.get(gitdir)
        if p is None:
            p = self.procs[gitdir] = subprocess.Popen(
                ["git", f"--git-dir={gitdir}", "cat-file", "--batch"],
                stdin=subprocess.PIPE, stdout=subprocess.PIPE)
        p.stdin.write(f"{commit}:m\n".encode())
        p.stdin.flush()
        hdr = p.stdout.readline().split()
        if len(hdr) < 3:
            return None
        data = p.stdout.read(int(hdr[2]))
        p.stdout.read(1)
        return data


def thread_ids(data):
    """Extract thread IDs without parsing unrelated mail headers."""
    values = {}
    current = None
    for line in io.BytesIO(data):
        line = line.rstrip(b"\r\n")
        if not line:
            break
        if line[:1] in (b" ", b"\t"):
            if current is not None:
                values[current] += b" " + line.strip()
            continue
        name, separator, value = line.partition(b":")
        name = name.lower()
        if separator and name in THREAD_HEADERS and name not in values:
            values[name] = value.strip()
            current = name
        else:
            current = None

    def extract(name):
        return [value.decode("ascii", "replace")
                for value in BYTE_IDS.findall(values.get(name, b""))]

    return extract(b"message-id"), extract(b"in-reply-to"), extract(b"references")


class Progress:
    def __init__(self, start=None):
        self.count = 0
        self.start = start or time.perf_counter()
        self.tty = sys.stderr.isatty()

    def update(self, timestamp):
        self.count += 1
        if self.tty and (self.count == 1 or self.count % 100 == 0):
            date = datetime.fromtimestamp(timestamp).strftime("%Y-%m-%d")
            sys.stderr.write(f"\rIndexing {self.count} messages ({date})")
            sys.stderr.flush()

    def finish(self):
        elapsed = time.perf_counter() - self.start
        prefix = "\r" if self.tty else ""
        print(f"{prefix}Indexed {self.count} messages in {elapsed:.1f} seconds.", file=sys.stderr)


class Index:
    SCHEMA = """
        CREATE TABLE epochs (
            id INTEGER PRIMARY KEY,
            path TEXT NOT NULL UNIQUE,
            tip_oid TEXT,
            oldest_indexed_oid TEXT,
            oldest_indexed_time INTEGER,
            indexed_since_time INTEGER,
            history_complete INTEGER NOT NULL DEFAULT 0
        );
        CREATE TABLE strings (
            id INTEGER PRIMARY KEY,
            value TEXT NOT NULL UNIQUE
        );
        CREATE TABLE messages (
            id INTEGER PRIMARY KEY,
            epoch_id INTEGER NOT NULL REFERENCES epochs(id),
            git_commit_oid TEXT NOT NULL UNIQUE,
            message_sid INTEGER NOT NULL REFERENCES strings(id),
            parent_sid INTEGER REFERENCES strings(id),
            thread_sid INTEGER NOT NULL REFERENCES strings(id),
            commit_time INTEGER NOT NULL,
            author_sid INTEGER NOT NULL REFERENCES strings(id),
            subject TEXT NOT NULL
        );
        CREATE INDEX messages_message_sid ON messages(message_sid);
        CREATE INDEX messages_thread_sid ON messages(thread_sid);
        CREATE INDEX messages_author_sid ON messages(author_sid);
        CREATE INDEX messages_commit_time ON messages(commit_time DESC);
        PRAGMA user_version = 1;
    """

    def __init__(self):
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        self.db = sqlite3.connect(CACHE, timeout=30)
        self.db.execute("PRAGMA foreign_keys = ON")
        self.db.execute("PRAGMA busy_timeout = 30000")
        version = self.db.execute("PRAGMA user_version").fetchone()[0]
        if version == 0:
            self.db.executescript(self.SCHEMA)
        elif version != 1:
            sys.exit(f"unsupported index version {version}; remove {CACHE} to rebuild")
        self.gitdirs = [os.path.realpath(path) for path in epochs()]
        with self.db:
            self.db.executemany("INSERT OR IGNORE INTO epochs(path) VALUES (?)",
                                ((path,) for path in self.gitdirs))
        rows = self.db.execute(
            f"SELECT id, path FROM epochs WHERE path IN ({','.join('?' * len(self.gitdirs))})",
            self.gitdirs).fetchall()
        ids = {path: epoch_id for epoch_id, path in rows}
        self.epoch_ids = [ids[path] for path in self.gitdirs]

    @property
    def scope(self):
        return ",".join("?" * len(self.epoch_ids))

    @staticmethod
    def _log_entries(gitdir, rev, since=None):
        args = ["log", "--first-parent", "--format=%H%x00%an%x00%at%x00%s"]
        if since is not None:
            args.append(f"--since=@{since}")
        args.append(rev)
        out = git(gitdir, *args)
        entries = []
        for line in out.splitlines():
            commit, author, timestamp, subject = line.split("\0", 3)
            entries.append((commit, author, int(timestamp), subject))
        return entries

    @staticmethod
    def _log_entry(gitdir, commit):
        out = git(gitdir, "log", "-1", "--format=%H%x00%an%x00%at%x00%s", commit)
        oid, author, timestamp, subject = out.rstrip("\n").split("\0", 3)
        return oid, author, int(timestamp), subject

    def _unindexed(self, entries):
        if not entries:
            return []
        existing = set()
        oids = [entry[0] for entry in entries]
        for start in range(0, len(oids), 500):
            chunk = oids[start:start + 500]
            rows = self.db.execute(
                f"SELECT git_commit_oid FROM messages WHERE git_commit_oid IN "
                f"({','.join('?' * len(chunk))})", chunk)
            existing.update(row[0] for row in rows)
        return [entry for entry in entries if entry[0] not in existing]

    def _index_entries(self, gitdir, epoch_id, entries, blobs, progress):
        rows = []
        values = set()
        for commit, author, timestamp, subject in entries:
            message_ids, in_reply_to, refs = thread_ids(blobs.read(gitdir, commit) or b"")
            # Broken mail occasionally has an empty Message-ID. Keep it in the
            # index under an internal identity so it does not block the batch.
            message_id = (message_ids or [f"oid:{commit}"])[0]
            parent = (in_reply_to or [None])[0] or (refs or [None])[-1]
            thread = refs[0] if refs else message_id
            rows.append((commit, message_id, parent, thread, timestamp, author, subject))
            values.update((message_id, thread, author))
            if parent:
                values.add(parent)
            progress.update(timestamp)

        self.db.executemany("INSERT OR IGNORE INTO strings(value) VALUES (?)",
                            ((value,) for value in values))
        string_ids = {}
        values = list(values)
        for start in range(0, len(values), 500):
            chunk = values[start:start + 500]
            found = self.db.execute(
                f"SELECT id, value FROM strings WHERE value IN ({','.join('?' * len(chunk))})",
                chunk)
            string_ids.update((value, sid) for sid, value in found)
        self.db.executemany(
            "INSERT INTO messages(epoch_id, git_commit_oid, message_sid, parent_sid, "
            "thread_sid, commit_time, author_sid, subject) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
            ((epoch_id, commit, string_ids[message_id],
              string_ids[parent] if parent else None, string_ids[thread], timestamp,
              string_ids[author], subject)
             for commit, message_id, parent, thread, timestamp, author, subject in rows))

    def sync(self, days):
        started = time.perf_counter()
        cutoff = int(time.time()) - days * 86400
        plans = []
        for gitdir, epoch_id in zip(self.gitdirs, self.epoch_ids):
            tip, oldest, oldest_time, covered, complete = self.db.execute(
                "SELECT tip_oid, oldest_indexed_oid, oldest_indexed_time, "
                "indexed_since_time, history_complete FROM epochs WHERE id = ?",
                (epoch_id,)).fetchone()
            head = git(gitdir, "rev-parse", "HEAD").strip()
            reset = False
            if tip and tip != head:
                ancestor = subprocess.run(
                    ["git", f"--git-dir={gitdir}", "merge-base", "--is-ancestor", tip, head])
                if ancestor.returncode:
                    tip = oldest = oldest_time = covered = None
                    complete = 0
                    reset = True

            entries = []
            if tip and tip != head:
                entries.extend(self._log_entries(gitdir, f"{tip}..{head}"))

            if not complete and (covered is None or cutoff < covered):
                if oldest:
                    parents = git(gitdir, "log", "-1", "--format=%P", oldest).split()
                    start = parents[0] if parents else None
                else:
                    start = head
                older = self._log_entries(gitdir, start, cutoff) if start else []
                entries.extend(older)
                covered = cutoff
                if older:
                    oldest, _, oldest_time, _ = older[-1]
                    complete = not bool(git(gitdir, "log", "-1", "--format=%P", oldest).strip())
                elif start is None:
                    complete = 1

            unique = []
            seen = set()
            for entry in entries:
                if entry[0] not in seen:
                    seen.add(entry[0])
                    unique.append(entry)
            entries = unique if reset else self._unindexed(unique)
            plans.append((gitdir, epoch_id, reset, entries, head, oldest,
                          oldest_time, covered, complete))

        count = sum(len(plan[3]) for plan in plans)
        progress = Progress(started) if count else None
        blobs = Blobs()
        try:
            with self.db:
                for (gitdir, epoch_id, reset, entries, head, oldest,
                     oldest_time, covered, complete) in plans:
                    if reset:
                        self.db.execute("DELETE FROM messages WHERE epoch_id = ?", (epoch_id,))
                    if entries:
                        self._index_entries(gitdir, epoch_id, entries, blobs, progress)
                    self.db.execute(
                        "UPDATE epochs SET tip_oid = ?, oldest_indexed_oid = ?, "
                        "oldest_indexed_time = ?, indexed_since_time = ?, history_complete = ? "
                        "WHERE id = ?",
                        (head, oldest, oldest_time, covered, complete, epoch_id))
        except Exception:
            if progress and progress.tty:
                print(file=sys.stderr)
            raise
        if progress:
            progress.finish()

    def recent(self, days):
        cutoff = int(time.time()) - days * 86400
        yield from self.db.execute(
            f"SELECT e.path, m.git_commit_oid, a.value, m.commit_time, m.subject "
            f"FROM messages m JOIN epochs e ON e.id = m.epoch_id "
            f"JOIN strings a ON a.id = m.author_sid "
            f"WHERE m.epoch_id IN ({self.scope}) AND m.commit_time >= ? "
            f"ORDER BY m.commit_time DESC, m.id DESC",
            (*self.epoch_ids, cutoff))

    def update_dirs(self):
        found = set()
        for path, in self.db.execute("SELECT path FROM epochs"):
            directory = os.path.dirname(path)
            while not os.path.isfile(os.path.join(directory, "Makefile")):
                parent = os.path.dirname(directory)
                if parent == directory:
                    sys.exit(f"no Makefile found above registered epoch {path}")
                directory = parent
            found.add(directory)
        return sorted(found)

    def stats(self):
        messages = self.db.execute("SELECT count(*) FROM messages").fetchone()[0]
        epochs = self.db.execute(
            "SELECT path, tip_oid, oldest_indexed_oid, history_complete "
            "FROM epochs ORDER BY path").fetchall()
        return messages, epochs

    def resolve(self, sel, days):
        """Return [(gitdir, commit)] for a hash, Message-ID, lore URL, or subject regex."""
        match = re.search(r"lore\.kernel\.org/[^/]+/([^/]+)", sel)
        key = (match.group(1) if match else sel).strip().strip("<>")
        if re.fullmatch(r"[0-9a-f]{7,40}", key):
            found = self.db.execute(
                f"SELECT e.path, m.git_commit_oid FROM messages m "
                f"JOIN epochs e ON e.id = m.epoch_id "
                f"WHERE m.epoch_id IN ({self.scope}) AND m.git_commit_oid GLOB ?",
                (*self.epoch_ids, key + "*")).fetchall()
            if found:
                return found
            for gitdir, epoch_id in zip(self.gitdirs, self.epoch_ids):
                check = subprocess.run(
                    ["git", f"--git-dir={gitdir}", "cat-file", "-e", f"{key}^{{commit}}"],
                    capture_output=True)
                if check.returncode == 0:
                    commit = git(gitdir, "rev-parse", f"{key}^{{commit}}").strip()
                    entries = self._unindexed([self._log_entry(gitdir, commit)])
                    if entries:
                        progress = Progress()
                        with self.db:
                            self._index_entries(gitdir, epoch_id, entries, Blobs(), progress)
                        progress.finish()
                    return [(gitdir, commit)]

        cutoff = int(time.time()) - days * 86400
        if "@" in key:
            found = self.db.execute(
                f"SELECT e.path, m.git_commit_oid FROM messages m "
                f"JOIN epochs e ON e.id = m.epoch_id "
                f"JOIN strings s ON s.id = m.message_sid "
                f"WHERE m.epoch_id IN ({self.scope}) AND m.commit_time >= ? AND s.value = ? "
                f"ORDER BY m.commit_time DESC",
                (*self.epoch_ids, cutoff, key)).fetchall()
        else:
            found = [(gitdir, commit) for gitdir, commit, _, _, subject in self.recent(days)
                     if re.search(key, subject, re.I)]
        if not found:
            sys.exit(f"{sel} not found within {days} days; try --days")
        return found

    def thread_target(self, commit):
        return self.db.execute(
            f"SELECT message_sid, thread_sid FROM messages "
            f"WHERE epoch_id IN ({self.scope}) AND git_commit_oid = ?",
            (*self.epoch_ids, commit)).fetchone()

    def thread_nodes(self, thread_sid, days):
        cutoff = int(time.time()) - days * 86400
        rows = self.db.execute(
            f"SELECT m.message_sid, m.git_commit_oid, a.value, m.commit_time, "
            f"m.subject, m.parent_sid FROM messages m "
            f"JOIN strings a ON a.id = m.author_sid "
            f"WHERE m.epoch_id IN ({self.scope}) AND m.thread_sid = ? "
            f"AND m.commit_time >= ?",
            (*self.epoch_ids, thread_sid, cutoff))
        return {message_sid: (commit, author, timestamp, subject, parent_sid)
                for message_sid, commit, author, timestamp, subject, parent_sid in rows}

    def related_messages(self, name, address):
        """Return complete threads containing mail confirmed by both name and Message-ID."""
        rows = self.db.execute(
            f"WITH related(thread_sid) AS ("
            f"  SELECT DISTINCT m.thread_sid FROM messages m "
            f"  JOIN strings a ON a.id = m.author_sid "
            f"  JOIN strings mid ON mid.id = m.message_sid "
            f"  WHERE m.epoch_id IN ({self.scope}) "
            f"  AND a.value = ? COLLATE NOCASE "
            f"  AND instr(lower(mid.value), lower(?)) > 0"
            f") "
            f"SELECT thread.value, mid.value, parent.value, e.path, "
            f"m.git_commit_oid, a.value, m.commit_time, m.subject, "
            f"(a.value = ? COLLATE NOCASE "
            f" AND instr(lower(mid.value), lower(?)) > 0) "
            f"FROM messages m "
            f"JOIN related r ON r.thread_sid = m.thread_sid "
            f"JOIN epochs e ON e.id = m.epoch_id "
            f"JOIN strings thread ON thread.id = m.thread_sid "
            f"JOIN strings mid ON mid.id = m.message_sid "
            f"LEFT JOIN strings parent ON parent.id = m.parent_sid "
            f"JOIN strings a ON a.id = m.author_sid "
            f"WHERE m.epoch_id IN ({self.scope}) "
            f"ORDER BY m.commit_time, m.id",
            (*self.epoch_ids, name, address, name, address, *self.epoch_ids))
        keys = ("thread", "message_id", "parent", "gitdir", "commit", "author",
                "timestamp", "subject", "own")
        return [dict(zip(keys, row)) for row in rows]

    def recent_messages(self, days, name, address):
        """Return complete threads active within the cutoff, regardless of author."""
        cutoff = int(time.time()) - days * 86400
        rows = self.db.execute(
            f"WITH recent(thread_sid) AS ("
            f"  SELECT DISTINCT m.thread_sid FROM messages m "
            f"  WHERE m.epoch_id IN ({self.scope}) AND m.commit_time >= ?"
            f") "
            f"SELECT thread.value, mid.value, parent.value, e.path, "
            f"m.git_commit_oid, a.value, m.commit_time, m.subject, "
            f"(a.value = ? COLLATE NOCASE "
            f" AND instr(lower(mid.value), lower(?)) > 0) "
            f"FROM messages m "
            f"JOIN recent r ON r.thread_sid = m.thread_sid "
            f"JOIN epochs e ON e.id = m.epoch_id "
            f"JOIN strings thread ON thread.id = m.thread_sid "
            f"JOIN strings mid ON mid.id = m.message_sid "
            f"LEFT JOIN strings parent ON parent.id = m.parent_sid "
            f"JOIN strings a ON a.id = m.author_sid "
            f"WHERE m.epoch_id IN ({self.scope}) "
            f"ORDER BY m.commit_time, m.id",
            (*self.epoch_ids, cutoff, name, address, *self.epoch_ids))
        keys = ("thread", "message_id", "parent", "gitdir", "commit", "author",
                "timestamp", "subject", "own")
        return [dict(zip(keys, row)) for row in rows]

    def messages_for_commits(self, commits, name, address):
        """Return complete threads containing any of the given commits."""
        thread_sids = set()
        for start in range(0, len(commits), 500):
            chunk = commits[start:start + 500]
            rows = self.db.execute(
                f"SELECT DISTINCT thread_sid FROM messages "
                f"WHERE epoch_id IN ({self.scope}) AND git_commit_oid IN "
                f"({','.join('?' * len(chunk))})",
                (*self.epoch_ids, *chunk))
            thread_sids.update(row[0] for row in rows)

        result = []
        thread_sids = list(thread_sids)
        for start in range(0, len(thread_sids), 500):
            chunk = thread_sids[start:start + 500]
            rows = self.db.execute(
                f"SELECT thread.value, mid.value, parent.value, e.path, "
                f"m.git_commit_oid, a.value, m.commit_time, m.subject, "
                f"(a.value = ? COLLATE NOCASE "
                f" AND instr(lower(mid.value), lower(?)) > 0) "
                f"FROM messages m "
                f"JOIN epochs e ON e.id = m.epoch_id "
                f"JOIN strings thread ON thread.id = m.thread_sid "
                f"JOIN strings mid ON mid.id = m.message_sid "
                f"LEFT JOIN strings parent ON parent.id = m.parent_sid "
                f"JOIN strings a ON a.id = m.author_sid "
                f"WHERE m.epoch_id IN ({self.scope}) AND m.thread_sid IN "
                f"({','.join('?' * len(chunk))}) "
                f"ORDER BY m.commit_time, m.id",
                (name, address, *self.epoch_ids, *chunk))
            keys = ("thread", "message_id", "parent", "gitdir", "commit", "author",
                    "timestamp", "subject", "own")
            result.extend(dict(zip(keys, row)) for row in rows)
        return result

    def message_location(self, commit):
        row = self.db.execute(
            f"SELECT e.path, m.git_commit_oid FROM messages m "
            f"JOIN epochs e ON e.id = m.epoch_id "
            f"WHERE m.epoch_id IN ({self.scope}) AND m.git_commit_oid = ?",
            (*self.epoch_ids, commit)).fetchone()
        if row is None:
            sys.exit(f"{commit} is not in the index")
        return row


def describe(gitdir, commit):
    author, ts, subject = git(gitdir, "log", "-1", "--format=%an%x00%at%x00%s", commit).rstrip("\n").split("\0", 2)
    return f"{commit[:10]} {local_time(int(ts))} {author[:20]:20} {subject}"


def load(gitdir, commit):
    return email.message_from_bytes(Blobs().read(gitdir, commit), policy=POLICY)


def local_time(ts):
    return datetime.fromtimestamp(ts).strftime("%m-%d %H:%M")


def format_size(size):
    for unit in ("bytes", "KiB", "MiB", "GiB"):
        if size < 1024 or unit == "GiB":
            return f"{size:.0f} {unit}" if unit == "bytes" else f"{size:.1f} {unit}"
        size /= 1024


def resolve_many(index, sels, days):
    found = []
    seen = set()
    for sel in sels:
        for match in index.resolve(sel, days):
            if match not in seen:
                seen.add(match)
                found.append(match)
    return found


def cmd_ls(args):
    for gitdir, commit, author, ts, subject in args.index.recent(args.days):
        if args.author and args.author.casefold() not in author.casefold():
            continue
        if args.grep and not re.search(args.grep, subject, re.I):
            continue
        print(f"{commit[:10]} {local_time(ts)} {author[:20]:20} {subject}")


def cmd_fetch(args):
    for directory in args.index.update_dirs():
        subprocess.run(["make", "update"], cwd=directory, check=True)
    args.index.sync(args.days)


def cmd_stats(args):
    messages, epochs = args.index.stats()
    print(f"Database: {os.path.abspath(CACHE)}")
    print(f"Size: {format_size(os.path.getsize(CACHE))}")
    print(f"Messages: {messages}")
    print("Epochs:")
    for path, tip, oldest, complete in epochs:
        print(f"  {path}")
        print(f"    Tip: {tip or 'unknown'}")
        print(f"    Oldest indexed: {oldest or 'none'}")
        print(f"    Complete: {'yes' if complete else 'no'}")


def cmd_show(args):
    for gitdir, commit in resolve_many(args.index, args.sels, args.days):
        if args.verbose:
            sys.stdout.write(f"From {commit} Mon Sep 17 00:00:00 2001\n")
        message = load(gitdir, commit)
        text = message.as_string(unixfrom=False).rstrip("\n")
        headers, separator, body = text.partition("\n\n")
        if not args.verbose:
            subject = message["Subject"]
            headers = subject.fold(policy=POLICY).rstrip("\n") if subject else "Subject:"
        if sys.stdout.isatty():
            body = re.sub(r"(?m)^>.*$", "\x1b[36m\\g<0>\x1b[0m", body)
        sys.stdout.write(headers + separator + body + "\n\n")


def self_addresses():
    """Addresses to drop from Cc: sendemail.from, user.email, and any pimail.self."""
    found = set()
    for key in ("sendemail.from", "user.email", "pimail.self"):
        r = subprocess.run(["git", "config", "--get-all", key], capture_output=True, text=True)
        found |= {a.lower() for _, a in email.utils.getaddresses(r.stdout.splitlines()) if a}
    return found


def prepare_reply_body(body, headers):
    if not os.path.exists(CONFIG):
        return body
    hook = runpy.run_path(CONFIG).get("prepare_reply_body")
    if hook is None:
        return body
    if not callable(hook):
        sys.exit(f"prepare_reply_body in {CONFIG} is not callable")
    body = hook(body, headers)
    if not isinstance(body, str):
        sys.exit(f"prepare_reply_body in {CONFIG} did not return a string")
    return body


def reply_text(m):
    msgid = first_id(m["Message-ID"])
    if not msgid:
        raise ValueError("mail has no Message-ID; cannot reply")
    sender = email.utils.getaddresses([str(m["Reply-To"] or m["From"])])
    seen = {a.lower() for _, a in sender} | self_addresses()
    cc = []
    for name, addr in email.utils.getaddresses([str(m["To"] or ""), str(m["Cc"] or "")]):
        if addr and addr.lower() not in seen:
            seen.add(addr.lower())
            cc.append(email.utils.formataddr((name, addr)))
    subject = re.sub(r"^(re:\s*)+", "", str(m["Subject"]), flags=re.I)
    refs = " ".join(f"<{r}>" for r in ids(m["References"]) + [msgid])
    name = email.utils.parseaddr(str(m["From"]))[0] or str(m["From"])
    part = m.get_body(preferencelist=("plain",))
    body = part.get_content() if part else ""
    headers = {
        "To": ", ".join(email.utils.formataddr(a) for a in sender),
        **({"Cc": ", ".join(cc)} if cc else {}),
        "Subject": f"Re: {subject}",
        "In-Reply-To": f"<{msgid}>",
        "References": refs,
        "MIME-Version": "1.0",
        "Content-Type": "text/plain; charset=UTF-8",
        "Content-Transfer-Encoding": "8bit",
    }
    body = "\n".join([
        f"On {m['Date']}, {name} wrote:",
        *(("> " + l).rstrip() for l in body.rstrip().splitlines()),
        "",
    ])
    body = prepare_reply_body(body, headers)
    lines = ["From git Mon Sep 17 00:00:00 2001",
             *(f"{key}: {value}" for key, value in headers.items()), "", body]
    return "\n".join(lines)


def cmd_reply(args):
    found = args.index.resolve(args.sel, args.days)
    if len(found) > 1:
        print("\n".join(describe(*f) for f in found), file=sys.stderr)
        sys.exit(f"{len(found)} mails match; pick one by commit hash")
    if args.output:
        try:
            text = reply_text(load(*found[0]))
        except ValueError as error:
            sys.exit(f"{found[0][1]} {error}")
        with open(args.output, "w") as out:
            out.write(text)
    else:
        try:
            create_draft(args.index, found[0][1])
        except ValueError as error:
            sys.exit(str(error))
        cmd_draft_edit(argparse.Namespace(commit=found[0][1]))


def cmd_config(args):
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    try:
        with open(CONFIG, "x") as f:
            f.write(CONFIG_TEMPLATE)
    except FileExistsError:
        pass
    editor = os.environ.get("VISUAL") or os.environ.get("EDITOR") or "vi"
    try:
        command = shlex.split(editor)
    except ValueError as error:
        sys.exit(f"invalid editor: {error}")
    if not command:
        sys.exit("editor is empty")
    subprocess.run([*command, CONFIG], check=True)


class MailState:
    SCHEMA = """
        CREATE TABLE message_state (
            git_commit_oid TEXT PRIMARY KEY,
            is_read INTEGER NOT NULL DEFAULT 0,
            archived INTEGER NOT NULL DEFAULT 0,
            updated_at INTEGER NOT NULL
        );
        PRAGMA user_version = 1;
    """

    def __init__(self):
        os.makedirs(STATE_DIR, exist_ok=True)
        self.db = sqlite3.connect(STATE_DB, timeout=30)
        self.db.execute("PRAGMA busy_timeout = 30000")
        self.db.execute("PRAGMA journal_mode = WAL")
        version = self.db.execute("PRAGMA user_version").fetchone()[0]
        if version == 0:
            self.db.executescript(self.SCHEMA)
        elif version != 1:
            sys.exit(f"unsupported state version {version}; remove {STATE_DB} to rebuild")

    def get(self, commits):
        result = {}
        for start in range(0, len(commits), 500):
            chunk = commits[start:start + 500]
            if not chunk:
                continue
            rows = self.db.execute(
                f"SELECT git_commit_oid, is_read, archived FROM message_state "
                f"WHERE git_commit_oid IN ({','.join('?' * len(chunk))})", chunk)
            result.update((commit, {"read": bool(read), "archived": bool(archived)})
                          for commit, read, archived in rows)
        return result

    def set(self, commit, field, value=True):
        columns = {"read": "is_read", "archived": "archived"}
        column = columns[field]
        now = int(time.time())
        with self.db:
            self.db.execute(
                f"INSERT INTO message_state(git_commit_oid, {column}, updated_at) "
                f"VALUES (?, ?, ?) ON CONFLICT(git_commit_oid) DO UPDATE SET "
                f"{column} = excluded.{column}, updated_at = excluded.updated_at",
                (commit, int(value), now))

    def mark_read(self, commits):
        now = int(time.time())
        with self.db:
            self.db.executemany(
                "INSERT INTO message_state(git_commit_oid, is_read, updated_at) "
                "VALUES (?, 1, ?) ON CONFLICT(git_commit_oid) DO UPDATE SET "
                "is_read = 1, updated_at = excluded.updated_at",
                ((commit, now) for commit in commits))

    def archived_commits(self):
        return [commit for commit, in self.db.execute(
            "SELECT git_commit_oid FROM message_state WHERE archived = 1")]

    def close(self):
        self.db.close()


def sendemail_identity():
    result = subprocess.run(["git", "config", "--get", "sendemail.from"],
                            capture_output=True, text=True)
    name, address = email.utils.parseaddr(result.stdout.strip())
    if result.returncode or not name or not address:
        sys.exit("sendemail.from must contain both a name and an email address")
    return name, address


def draft_path(commit):
    if not re.fullmatch(r"[0-9a-f]{40}", commit):
        sys.exit(f"invalid mail commit: {commit}")
    return os.path.join(DRAFT_DIR, commit + ".eml")


def ensure_draft_repo():
    if not os.path.isdir(os.path.join(DRAFT_DIR, ".git")):
        os.makedirs(DRAFT_DIR, exist_ok=True)
        subprocess.run(["git", "init", "-q", DRAFT_DIR], check=True)


def record_draft_change(commit, message):
    path = draft_path(commit)
    subprocess.run(["git", "-C", DRAFT_DIR, "add", "-A", "--", os.path.basename(path)],
                   check=True)
    changed = subprocess.run(["git", "-C", DRAFT_DIR, "diff", "--cached", "--quiet"])
    if changed.returncode == 1:
        subprocess.run(["git", "-C", DRAFT_DIR, "commit", "-q", "-m", message], check=True)
    elif changed.returncode:
        sys.exit("cannot inspect draft repository changes")


def editor_command():
    try:
        command = shlex.split(os.environ.get("EDITOR") or "nvim")
    except ValueError as error:
        sys.exit(f"invalid EDITOR: {error}")
    if not command:
        sys.exit("EDITOR is empty")
    return command


def create_draft(index, commit):
    path = draft_path(commit)
    if os.path.exists(path):
        return path
    ensure_draft_repo()
    try:
        text = reply_text(load(*index.message_location(commit)))
    except ValueError as error:
        raise ValueError(f"{commit} {error}") from error
    with open(path, "x") as out:
        out.write(text)
    return path


def cmd_draft_edit(args):
    path = draft_path(args.commit)
    if not os.path.isfile(path):
        sys.exit(f"draft does not exist: {path}")
    subprocess.run([*editor_command(), path], check=False)
    record_draft_change(args.commit, f"Edit reply to {args.commit[:12]}")


def cmd_draft_send(args):
    path = draft_path(args.commit)
    if not os.path.isfile(path):
        sys.exit(f"draft does not exist: {path}")
    try:
        result = subprocess.run(["git", "send-email", path])
        returncode = result.returncode
    except OSError as error:
        print(error, file=sys.stderr)
        returncode = 1
    if returncode:
        try:
            input("\nSend failed. Press Enter to close this window...")
        except EOFError:
            pass
        raise SystemExit(returncode)
    os.unlink(path)
    record_draft_change(args.commit, f"Send reply to {args.commit[:12]}")


def delete_draft(commit):
    path = draft_path(commit)
    if not os.path.isfile(path):
        raise FileNotFoundError(f"draft does not exist: {path}")
    record_draft_change(commit, f"Save reply to {commit[:12]} before deletion")
    os.unlink(path)
    record_draft_change(commit, f"Delete reply to {commit[:12]}")


def cmd_view_mail(args):
    message = load(*args.index.message_location(args.commit))
    part = message.get_body(preferencelist=("plain", "html"))
    if part is None:
        text = message.as_string(unixfrom=False).rstrip("\n")
        _, _, body = text.partition("\n\n")
    else:
        body = part.get_content().rstrip("\n")
    headers = []
    for name in ("From", "Subject"):
        value = message[name]
        headers.append(value.fold(policy=POLICY).rstrip("\n") if value else f"{name}:")
    path = None
    try:
        with tempfile.NamedTemporaryFile(
                "w", suffix=".eml", prefix=f"pi-mail-{args.commit[:10]}-", delete=False) as out:
            path = out.name
            out.write("\n".join(headers) + "\n\n" + body + "\n")
        subprocess.run([*editor_command(), path], check=False)
    finally:
        if path:
            try:
                os.unlink(path)
            except FileNotFoundError:
                pass


def cmd_tui(args):
    # Keep Textual and Rich out of the startup path for every CLI command.
    try:
        from rich.segment import Segment
        from rich.text import Text
        from textual.app import App, ComposeResult
        from textual.binding import Binding
        from textual.containers import Grid
        from textual.css.query import NoMatches
        from textual.strip import Strip
        from textual.widgets import (Button, Footer, Header, Input, Static, TabbedContent,
                                     TabPane, Tree)
    except ImportError:
        sys.exit("pi-mail tui requires Textual (pip install textual)")

    name, address = sendemail_identity()
    state = MailState()
    program = os.path.realpath(__file__)

    class MailTree(Tree):
        GUIDE_DEPTH = 2
        BINDINGS = [Binding("enter", "open_mail", show=False)]

        def on_mount(self):
            self.guide_depth = self.GUIDE_DEPTH

        def render_line(self, y):
            line = super().render_line(y)
            if y == self.cursor_line:
                style = self.get_component_rich_style("tree--cursor")
                return Strip(Segment.apply_style(line, post_style=style), line.cell_length)
            return line

        def action_open_mail(self):
            if self.cursor_node and self.cursor_node.data:
                self.app.action_view()

    class PiMailApp(App):
        TITLE = "pi-mail"
        AUTHOR_COLUMN = 22  # Align through five levels of tree indentation.
        CSS = """
        TabbedContent { height: 1fr; }
        Tree { height: 1fr; }
        Tree > .tree--highlight-line { background: transparent; }
        Tree > .tree--highlight { background: $surface-lighten-1; }
        #actions { height: 2; grid-size: 4 2; }
        #actions Button { min-width: 12; }
        #search { height: 1; }
        #status { height: 1; padding: 0 1; }
        """
        BINDINGS = [
            Binding("j", "next_mail", "Next"),
            Binding("k", "previous_mail", "Previous"),
            Binding("o", "view", "Open"),
            Binding("r", "reply", "Reply"),
            Binding("I", "toggle_read", "Read/Unread"),
            Binding("shift+i", "toggle_read", show=False),
            Binding("e", "archive", "Archive"),
            Binding("s", "send", "Send"),
            Binding("d", "delete", "Delete"),
            Binding("f", "fetch", "Fetch"),
            Binding("R", "all_read", "All read"),
            Binding("shift+r", "all_read", show=False),
            Binding("/", "search", "Search"),
            Binding("escape", "clear_search", show=False),
            Binding("q", "quit", "Quit"),
        ]

        def __init__(self):
            super().__init__()
            self.records = []
            self.tab_records = {}
            self.searches = {"home": "", "recent": "", "archive": ""}
            self.search_open = False
            self.fetch_process = None
            self.terminals = []

        def check_action(self, action, parameters):
            if self.search_open and action != "clear_search":
                return False
            return True

        def compose(self) -> ComposeResult:
            yield Header()
            with TabbedContent(initial="home-pane", id="tabs"):
                with TabPane("Home", id="home-pane"):
                    yield MailTree("Home", id="home-tree")
                with TabPane("Recent", id="recent-pane"):
                    yield MailTree("Recent", id="recent-tree")
                with TabPane("Archive", id="archive-pane"):
                    yield MailTree("Archive", id="archive-tree")
            with Grid(id="actions"):
                yield Button("View", id="view", compact=True)
                yield Button("Reply", id="reply", compact=True)
                yield Button("Read/Unread", id="read", compact=True)
                yield Button("Archive", id="archive", compact=True)
                yield Button("Send", id="send", compact=True)
                yield Button("Delete", id="delete", compact=True)
                yield Button("Fetch", id="fetch", compact=True)
                yield Button("All Read", id="all-read", compact=True)
            yield Input(placeholder="SEL (hash, Message-ID, lore URL, or subject regex)",
                        id="search")
            yield Static("", id="status")
            yield Footer()

        def on_mount(self):
            self.query_one("#home-tree", Tree).show_root = False
            self.query_one("#recent-tree", Tree).show_root = False
            self.query_one("#archive-tree", Tree).show_root = False
            self.query_one("#search", Input).display = False
            self.reload()
            self.set_interval(0.5, self.check_processes)

        def selected(self):
            try:
                node = self.active_tree().cursor_node
            except NoMatches:
                return None
            return node.data if node and node.data else None

        def active_key(self):
            pane = self.query_one("#tabs", TabbedContent).active
            return {"home-pane": "home", "recent-pane": "recent",
                    "archive-pane": "archive"}[pane]

        def active_tree(self):
            return self.query_one(f"#{self.active_key()}-tree", Tree)

        @staticmethod
        def sel_matcher(sel):
            match = re.search(r"lore\.kernel\.org/[^/]+/([^/]+)", sel)
            key = (match.group(1) if match else sel).strip().strip("<>")
            if re.fullmatch(r"[0-9a-f]{7,40}", key):
                return lambda record: record["commit"].startswith(key)
            if "@" in key:
                return lambda record: record["message_id"] == key
            pattern = re.compile(key, re.I)
            return lambda record: pattern.search(record["subject"]) is not None

        def filter_threads(self, records, key):
            sel = self.searches[key]
            if not sel:
                return records
            matches = self.sel_matcher(sel)
            threads = {record["thread"] for record in records if matches(record)}
            return [record for record in records if record["thread"] in threads]

        @classmethod
        def label(cls, record, parent, inherited=False):
            flags = []
            if record["archived"]:
                flags.append("A")
            elif inherited:
                flags.append("a")
            suffix = f" [{' '.join(flags)}]" if flags else ""
            date = local_time(record["timestamp"])
            depth = 0
            ancestor = parent
            while ancestor.parent is not None:
                depth += 1
                ancestor = ancestor.parent
            gap = " " * max(1, cls.AUTHOR_COLUMN - depth * MailTree.GUIDE_DEPTH
                            - len(date))
            label = Text(f"{date}{gap}"
                         f"{record['author'][:20]:20} {record['subject']}{suffix}")
            if not record["read"]:
                label.stylize("bold cyan")
            elif record["own"]:
                label.stylize("dim")
            return label

        @staticmethod
        def draft_label(record):
            subject = re.sub(r"^(re:\s*)+", "", record["subject"], flags=re.I)
            return Text(f"  ✎ Draft: Re: {subject}", style="italic yellow")

        @staticmethod
        def record_key(record):
            return record["kind"], record["commit"]

        @staticmethod
        def forest(records):
            by_id = {record["message_id"]: record for record in records}
            children = {}
            for record in records:
                parent = record["parent"] if record["parent"] in by_id else None
                children.setdefault(parent, []).append(record)
            for values in children.values():
                values.sort(key=lambda record: record["timestamp"])
            return children

        def add_draft(self, parent, record, tree_key, selected_key, selected_nodes):
            draft = {"kind": "draft", "commit": record["commit"]}
            node = parent.add_leaf(self.draft_label(record), data=draft)
            if self.record_key(draft) == selected_key:
                selected_nodes[tree_key] = node

        def add_home(self, parent, record, children, selected_key, selected_nodes):
            if record["archived"]:
                return
            node = parent.add(self.label(record, parent), data=record,
                              expand=True, allow_expand=False)
            if self.record_key(record) == selected_key:
                selected_nodes["home"] = node
            if record["has_draft"]:
                self.add_draft(node, record, "home", selected_key, selected_nodes)
            for child in children.get(record["message_id"], []):
                self.add_home(node, child, children, selected_key, selected_nodes)

        def add_recent(self, parent, record, children, selected_key, selected_nodes):
            node = parent.add(self.label(record, parent, record["archive_inherited"]),
                              data=record,
                              expand=True, allow_expand=False)
            if self.record_key(record) == selected_key:
                selected_nodes["recent"] = node
            if record["has_draft"]:
                self.add_draft(node, record, "recent", selected_key, selected_nodes)
            for child in children.get(record["message_id"], []):
                self.add_recent(node, child, children, selected_key, selected_nodes)

        def add_archive(self, parent, record, children, inherited,
                        selected_key, selected_nodes):
            shown = dict(record)
            shown["archive_inherited"] = inherited and not record["archived"]
            node = parent.add(self.label(record, parent, inherited), data=shown,
                              expand=True, allow_expand=False)
            if self.record_key(shown) == selected_key:
                selected_nodes["archive"] = node
            if record["has_draft"]:
                self.add_draft(node, record, "archive", selected_key, selected_nodes)
            for child in children.get(record["message_id"], []):
                self.add_archive(node, child, children, True,
                                 selected_key, selected_nodes)

        def reload(self):
            selected = self.selected() if self.is_mounted else None
            selected_key = self.record_key(selected) if selected else None
            home_rows = args.index.related_messages(name, address)
            recent_rows = args.index.recent_messages(7, name, address)
            archive_rows = args.index.messages_for_commits(
                state.archived_commits(), name, address)
            all_rows = home_rows + recent_rows + archive_rows
            stored = state.get(list({row["commit"] for row in all_rows}))
            for row in all_rows:
                values = stored.get(row["commit"], {})
                row["kind"] = "mail"
                row["own"] = bool(row["own"])
                row["read"] = row["own"] or values.get("read", False)
                row["archived"] = values.get("archived", False)
                row["has_draft"] = os.path.isfile(draft_path(row["commit"]))
                row["archive_inherited"] = False

            home = self.query_one("#home-tree", Tree)
            recent = self.query_one("#recent-tree", Tree)
            archive = self.query_one("#archive-tree", Tree)
            home.reset("Home")
            recent.reset("Recent")
            archive.reset("Archive")
            home.root.expand()
            home.root.allow_expand = False
            recent.root.expand()
            recent.root.allow_expand = False
            archive.root.expand()
            archive.root.allow_expand = False
            selected_nodes = {}

            shown_home_rows = self.filter_threads(home_rows, "home")
            home_threads = {}
            for row in shown_home_rows:
                home_threads.setdefault(row["thread"], []).append(row)
            home_ordered = sorted(
                home_threads.values(),
                key=lambda records: max(r["timestamp"] for r in records),
                reverse=True)
            for records in home_ordered:
                children = self.forest(records)
                roots = children.get(None, [])
                visible_roots = [record for record in roots if not record["archived"]]
                missing = None
                for record in visible_roots:
                    parent = home.root
                    if record["parent"] is not None:
                        if missing is None:
                            missing = home.root.add(
                                Text("[missing]", style="dim italic"),
                                expand=True, allow_expand=False)
                        parent = missing
                    self.add_home(parent, record, children, selected_key, selected_nodes)

            archive_threads = {}
            for row in archive_rows:
                archive_threads.setdefault(row["thread"], []).append(row)
            archive_ordered = sorted(
                archive_threads.values(),
                key=lambda records: max(r["timestamp"] for r in records),
                reverse=True)
            archived_commits = set()
            shown_archive_rows = self.filter_threads(archive_rows, "archive")
            shown_archive_threads = {row["thread"] for row in shown_archive_rows}
            for records in archive_ordered:
                children = self.forest(records)
                roots = children.get(None, [])
                archived_roots = []

                def find_archived(record, inherited=False):
                    now_inherited = inherited or record["archived"]
                    if now_inherited:
                        archived_commits.add(record["commit"])
                    if record["archived"] and not inherited:
                        archived_roots.append(record)
                    for child in children.get(record["message_id"], []):
                        find_archived(child, now_inherited)

                for record in roots:
                    find_archived(record)
                if records[0]["thread"] not in shown_archive_threads:
                    continue
                missing = None
                for record in archived_roots:
                    parent = archive.root
                    if record["parent"] is not None:
                        if missing is None:
                            missing = archive.root.add(
                                Text("[missing]", style="dim italic"),
                                expand=True, allow_expand=False)
                        parent = missing
                    self.add_archive(parent, record, children, False,
                                     selected_key, selected_nodes)

            recent_rows = [row for row in recent_rows
                           if row["commit"] not in archived_commits]
            shown_recent_rows = self.filter_threads(recent_rows, "recent")
            recent_threads = {}
            for row in shown_recent_rows:
                recent_threads.setdefault(row["thread"], []).append(row)
            recent_ordered = sorted(
                recent_threads.values(),
                key=lambda records: max(r["timestamp"] for r in records),
                reverse=True)
            for records in recent_ordered:
                children = self.forest(records)
                missing = None
                for record in children.get(None, []):
                    parent = recent.root
                    if record["parent"] is not None:
                        if missing is None:
                            missing = recent.root.add(
                                Text("[missing]", style="dim italic"),
                                expand=True, allow_expand=False)
                        parent = missing
                    self.add_recent(parent, record, children,
                                    selected_key, selected_nodes)

            visible = {
                row["commit"]: row for row in
                home_rows
                + [row for row in archive_rows if row["commit"] in archived_commits]
                + recent_rows
            }
            self.records = list(visible.values())
            self.tab_records = {
                "home": [row for row in shown_home_rows if not row["archived"]],
                "recent": shown_recent_rows,
                "archive": [row for row in shown_archive_rows
                            if row["commit"] in archived_commits],
            }

            pane = self.query_one("#tabs", TabbedContent).active
            key = {
                "home-pane": "home",
                "recent-pane": "recent",
                "archive-pane": "archive",
            }[pane]
            if key in selected_nodes:
                tree = {"home": home, "recent": recent, "archive": archive}[key]
                self.call_after_refresh(tree.move_cursor, selected_nodes[key])
            self.update_status()
            self.update_buttons()

        def set_status(self, message):
            self.query_one("#status", Static).update(Text(message))

        def update_status(self):
            unread = sum(not row["read"] for row in self.records)
            drafts = sum(row["has_draft"] for row in self.records)
            threads = len({row["thread"] for row in self.records})
            message = (f"{threads} threads, {unread} unread, {drafts} drafts  "
                       "[A] explicit archive  [a] inherited archive")
            key = self.active_key()
            if self.searches[key]:
                matched = len({row["thread"] for row in self.tab_records[key]})
                message += f"  /{self.searches[key]}: {matched} matches"
            self.set_status(message)

        def update_buttons(self):
            record = self.selected()
            if not record:
                for button_id in ("view", "reply", "read", "archive", "send", "delete"):
                    self.query_one(f"#{button_id}", Button).disabled = True
                return
            draft = record["kind"] == "draft"
            self.query_one("#view", Button).disabled = False
            self.query_one("#view", Button).label = "Edit" if draft else "View"
            for button_id in ("reply", "read", "archive"):
                self.query_one(f"#{button_id}", Button).disabled = draft
            self.query_one("#send", Button).disabled = not draft
            self.query_one("#delete", Button).disabled = not draft
            if draft:
                self.query_one("#archive", Button).label = "Archive"
                return
            archive_label = "Unarchive" if record["archived"] else "Archive"
            if record.get("archive_inherited"):
                archive_label = "Inherited"
            self.query_one("#archive", Button).label = archive_label

        def on_tree_node_highlighted(self, event: Tree.NodeHighlighted):
            self.update_buttons()

        def on_tabbed_content_tab_activated(self, event: TabbedContent.TabActivated):
            search = self.query_one("#search", Input)
            self.search_open = False
            search.display = False
            self.update_status()
            self.update_buttons()

        def on_input_submitted(self, event: Input.Submitted):
            if event.input.id != "search":
                return
            sel = event.value.strip()
            try:
                self.sel_matcher(sel)
            except re.error as error:
                self.notify(f"Invalid regex: {error}", severity="error")
                event.input.select_all()
                return
            self.searches[self.active_key()] = sel
            self.search_open = False
            event.input.display = False
            self.active_tree().focus()
            self.reload()

        def on_button_pressed(self, event: Button.Pressed):
            actions = {
                "view": self.action_view,
                "reply": self.action_reply,
                "read": self.action_toggle_read,
                "archive": self.action_archive,
                "send": self.action_send,
                "delete": self.action_delete,
                "fetch": self.action_fetch,
                "all-read": self.action_all_read,
            }
            actions[event.button.id]()

        def launch_terminal(self, action, commit, title):
            try:
                process = subprocess.Popen([
                    "xdg-terminal-exec", f"--title=pi-mail: {title}", "--",
                    sys.executable, program, action, commit],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except OSError as error:
                self.notify(str(error), severity="error")
                return
            self.terminals.append(process)
            self.set_status(f"Opened terminal for {title}.")

        def require_selected(self):
            record = self.selected()
            if not record:
                self.notify("Select a mail first.", severity="warning")
            return record

        def action_next_mail(self):
            self.active_tree().action_cursor_down()

        def action_previous_mail(self):
            self.active_tree().action_cursor_up()

        def action_search(self):
            search = self.query_one("#search", Input)
            search.value = self.searches[self.active_key()]
            self.search_open = True
            search.display = True
            search.focus()
            search.cursor_position = len(search.value)

        def action_clear_search(self):
            search = self.query_one("#search", Input)
            if search.display:
                self.search_open = False
                search.display = False
                self.active_tree().focus()
                return
            key = self.active_key()
            if self.searches[key]:
                self.searches[key] = ""
                self.reload()

        def action_view(self):
            record = self.require_selected()
            if not record:
                return
            if record["kind"] == "draft":
                self.launch_terminal("--internal-draft-edit", record["commit"], "edit draft")
                return
            if not record["own"]:
                state.set(record["commit"], "read")
            self.launch_terminal("--internal-view-mail", record["commit"], "view mail")
            self.reload()

        def action_reply(self):
            record = self.require_selected()
            if not record:
                return
            if record["kind"] == "draft":
                self.notify("Select a mail to reply.", severity="warning")
                return
            try:
                create_draft(args.index, record["commit"])
            except (OSError, ValueError, subprocess.SubprocessError) as error:
                self.notify(str(error), severity="error")
                return
            if not record["own"]:
                state.set(record["commit"], "read")
            self.launch_terminal("--internal-draft-edit", record["commit"], "edit reply")
            self.reload()

        def action_toggle_read(self):
            record = self.require_selected()
            if not record:
                return
            if record["kind"] == "draft":
                self.notify("Read state applies to mail only.", severity="warning")
                return
            if record["own"]:
                self.notify("Mail from yourself is always read.")
                return
            state.set(record["commit"], "read", not record["read"])
            self.reload()

        def action_archive(self):
            record = self.require_selected()
            if not record:
                return
            if record["kind"] == "draft":
                self.notify("Archive applies to mail only.", severity="warning")
                return
            if record.get("archive_inherited"):
                self.notify("Unarchive the explicit [A] ancestor first.", severity="warning")
                return
            state.set(record["commit"], "archived", not record["archived"])
            self.reload()

        def action_send(self):
            record = self.require_selected()
            if not record:
                return
            if record["kind"] != "draft":
                self.notify("Select a draft to send.", severity="warning")
                return
            self.launch_terminal("--internal-draft-send", record["commit"], "send reply")

        def action_delete(self):
            record = self.require_selected()
            if not record:
                return
            if record["kind"] != "draft":
                self.notify("Select a draft to delete.", severity="warning")
                return
            try:
                delete_draft(record["commit"])
            except (OSError, subprocess.SubprocessError) as error:
                self.notify(str(error), severity="error")
                return
            self.reload()
            self.notify("Draft deleted.")

        def action_fetch(self):
            if self.fetch_process and self.fetch_process.poll() is None:
                self.notify("Fetch is already running.")
                return
            try:
                self.fetch_process = subprocess.Popen(
                    [sys.executable, program, "fetch", "--days", "30"],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except OSError as error:
                self.notify(str(error), severity="error")
                return
            self.set_status("Fetching mail…")
            self.query_one("#fetch", Button).disabled = True

        def action_all_read(self):
            state.mark_read([record["commit"] for record in self.records
                             if not record["own"]])
            self.reload()

        def check_processes(self):
            finished = [process for process in self.terminals if process.poll() is not None]
            if finished:
                self.terminals = [process for process in self.terminals
                                  if process.poll() is None]
                self.reload()
            if self.fetch_process and self.fetch_process.poll() is not None:
                returncode = self.fetch_process.returncode
                self.fetch_process = None
                self.query_one("#fetch", Button).disabled = False
                if returncode:
                    self.notify(f"Fetch failed with status {returncode}.", severity="error")
                    self.set_status("Fetch failed.")
                else:
                    self.reload()
                    self.notify("Fetch complete.")

    try:
        PiMailApp().run()
    finally:
        state.close()


def cmd_tree(args):
    targets, threads = set(), []
    for _, commit in resolve_many(args.index, args.sels, args.days):
        message_sid, thread_sid = args.index.thread_target(commit)
        targets.add(message_sid)
        if thread_sid not in threads:
            threads.append(thread_sid)
    for i, thread_sid in enumerate(threads):
        if i:
            print()
        print_tree(args.index.thread_nodes(thread_sid, args.days), targets)


def print_tree(nodes, targets):
    """nodes: Message-ID -> (commit, author, ts, subject, parent)"""
    children = {}
    for mid, (*_, parent) in nodes.items():
        children.setdefault(parent if parent in nodes else None, []).append(mid)
    for kids in children.values():
        kids.sort(key=lambda k: nodes[k][2])

    def walk(mid, prefix, last):
        c, author, ts, subject, _ = nodes[mid]
        mark = " *" if mid in targets else ""
        print(f"{c[:10]} {local_time(ts)} {prefix}{'└─' if last else '├─'} {author}: {subject}{mark}")
        kids = children.get(mid, [])
        for i, k in enumerate(kids):
            walk(k, prefix + ("   " if last else "│  "), i == len(kids) - 1)

    tops = children.get(None, [])
    for i, mid in enumerate(tops):
        walk(mid, "", i == len(tops) - 1)


def main():
    internal = {
        "--internal-draft-edit": cmd_draft_edit,
        "--internal-draft-send": cmd_draft_send,
        "--internal-view-mail": cmd_view_mail,
    }
    if len(sys.argv) == 3 and sys.argv[1] in internal:
        args = argparse.Namespace(commit=sys.argv[2])
        if sys.argv[1] == "--internal-view-mail":
            args.index = Index()
            try:
                internal[sys.argv[1]](args)
            finally:
                args.index.db.close()
        else:
            internal[sys.argv[1]](args)
        return

    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd")
    ls = sub.add_parser("ls")
    ls.add_argument("--days", type=int, default=3)
    ls.add_argument("-a", "--author")
    ls.add_argument("-g", "--grep", help="regex on subject")
    fetch = sub.add_parser("fetch")
    fetch.add_argument("--days", type=int, default=30)
    sub.add_parser("stats")
    sub.add_parser("tui")
    config = sub.add_parser("config")
    config_sub = config.add_subparsers(dest="config_cmd", required=True)
    config_sub.add_parser("edit")
    for name in ("show", "reply", "tree"):
        p = sub.add_parser(name)
        if name in ("show", "tree"):
            p.add_argument("sels", metavar="SEL", nargs="+")
        else:
            p.add_argument("sel")
        p.add_argument("--days", type=int, default=30)
        if name == "show":
            p.add_argument("-v", "--verbose", action="store_true", help="show all headers")
        elif name == "reply":
            p.add_argument("-o", "--output", help="write a template without editing")
    argv = sys.argv[1:]
    if not argv or argv[0] not in (*sub.choices, "-h", "--help"):
        argv = ["ls", *argv]
    args = ap.parse_args(argv)
    if args.cmd == "config":
        cmd_config(args)
        return
    args.index = Index()
    try:
        if args.cmd in ("fetch", "stats", "tui"):
            {"fetch": cmd_fetch, "stats": cmd_stats, "tui": cmd_tui}[args.cmd](args)
        else:
            args.index.sync(args.days)
            {"ls": cmd_ls, "show": cmd_show, "reply": cmd_reply, "tree": cmd_tree}[args.cmd](args)
    finally:
        args.index.db.close()


if __name__ == "__main__":
    main()
