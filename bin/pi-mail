#!/usr/bin/env python3
"""Browse a public-inbox v2 mirror through an on-demand SQLite index.

  pi-mail [ls] [--days N] [-a AUTHOR] [-g SUBJECT]    list recent mails
  pi-mail show  SEL... [--days N] [-v]                print the mail(s)
  pi-mail reply SEL [-o FILE]                         reply template for git send-email
  pi-mail tree  SEL... [--days N]                     thread tree(s)
  pi-mail fetch                                       update every registered inbox
  pi-mail stats                                       show index statistics
  pi-mail config edit                                 edit the Python configuration

SEL is a commit hash shown by `ls`/`tree`, a Message-ID, a lore URL, or
otherwise a regex matched against subjects within --days. `show` and `tree`
accept multiple selectors and handle every match; `reply` needs exactly one.
`reply` drops your own addresses from Cc; add extra ones with
`git config --global --add pimail.self ADDRESS`.
The inbox defaults to ~/public-inbox/git/git (override with $PI_INBOX).
Update every inbox recorded in the index with `pi-mail fetch`.
"""

import argparse
import email
import email.policy
import email.utils
import glob
import io
import os
import re
import runpy
import shlex
import sqlite3
import subprocess
import sys
import time
from datetime import datetime

INBOX = os.path.expanduser(os.environ.get("PI_INBOX", "~/public-inbox/git/git"))
CACHE = os.path.join(os.path.expanduser(os.environ.get("XDG_CACHE_HOME", "~/.cache")),
                     "pi-mail", "index.sqlite3")
CONFIG = os.path.join(os.path.expanduser(os.environ.get("XDG_CONFIG_HOME", "~/.config")),
                      "pi-mail", "config.py")
POLICY = email.policy.default
THREAD_HEADERS = {b"message-id", b"in-reply-to", b"references"}
BYTE_IDS = re.compile(rb"<([^>]+)>")
CONFIG_TEMPLATE = '''\
def prepare_reply_body(body, headers):
    """Post-process the body generated by `pi-mail reply`."""
    return body
'''


def epochs():
    dirs = glob.glob(os.path.join(INBOX, "*.git"))
    if not dirs:
        sys.exit(f"no epochs under {INBOX}")
    return sorted(dirs, key=lambda d: int(os.path.basename(d).split(".")[0]), reverse=True)


def git(gitdir, *args):
    return subprocess.run(["git", f"--git-dir={gitdir}", *args],
                          capture_output=True, text=True, check=True).stdout


def ids(header):
    return re.findall(r"<([^>]+)>", str(header or ""))


def first_id(header):
    found = ids(header)
    return found[0] if found else None


class Blobs:
    """Read `<commit>:m` blobs through one `git cat-file --batch` per epoch."""

    def __init__(self):
        self.procs = {}

    def read(self, gitdir, commit):
        p = self.procs.get(gitdir)
        if p is None:
            p = self.procs[gitdir] = subprocess.Popen(
                ["git", f"--git-dir={gitdir}", "cat-file", "--batch"],
                stdin=subprocess.PIPE, stdout=subprocess.PIPE)
        p.stdin.write(f"{commit}:m\n".encode())
        p.stdin.flush()
        hdr = p.stdout.readline().split()
        if len(hdr) < 3:
            return None
        data = p.stdout.read(int(hdr[2]))
        p.stdout.read(1)
        return data


def thread_ids(data):
    """Extract thread IDs without parsing unrelated mail headers."""
    values = {}
    current = None
    for line in io.BytesIO(data):
        line = line.rstrip(b"\r\n")
        if not line:
            break
        if line[:1] in (b" ", b"\t"):
            if current is not None:
                values[current] += b" " + line.strip()
            continue
        name, separator, value = line.partition(b":")
        name = name.lower()
        if separator and name in THREAD_HEADERS and name not in values:
            values[name] = value.strip()
            current = name
        else:
            current = None

    def extract(name):
        return [value.decode("ascii", "replace")
                for value in BYTE_IDS.findall(values.get(name, b""))]

    return extract(b"message-id"), extract(b"in-reply-to"), extract(b"references")


class Progress:
    def __init__(self, start=None):
        self.count = 0
        self.start = start or time.perf_counter()
        self.tty = sys.stderr.isatty()

    def update(self, timestamp):
        self.count += 1
        if self.tty and (self.count == 1 or self.count % 100 == 0):
            date = datetime.fromtimestamp(timestamp).strftime("%Y-%m-%d")
            sys.stderr.write(f"\rIndexing {self.count} messages ({date})")
            sys.stderr.flush()

    def finish(self):
        elapsed = time.perf_counter() - self.start
        prefix = "\r" if self.tty else ""
        print(f"{prefix}Indexed {self.count} messages in {elapsed:.1f} seconds.", file=sys.stderr)


class Index:
    SCHEMA = """
        CREATE TABLE epochs (
            id INTEGER PRIMARY KEY,
            path TEXT NOT NULL UNIQUE,
            tip_oid TEXT,
            oldest_indexed_oid TEXT,
            oldest_indexed_time INTEGER,
            indexed_since_time INTEGER,
            history_complete INTEGER NOT NULL DEFAULT 0
        );
        CREATE TABLE strings (
            id INTEGER PRIMARY KEY,
            value TEXT NOT NULL UNIQUE
        );
        CREATE TABLE messages (
            id INTEGER PRIMARY KEY,
            epoch_id INTEGER NOT NULL REFERENCES epochs(id),
            git_commit_oid TEXT NOT NULL UNIQUE,
            message_sid INTEGER NOT NULL REFERENCES strings(id),
            parent_sid INTEGER REFERENCES strings(id),
            thread_sid INTEGER NOT NULL REFERENCES strings(id),
            commit_time INTEGER NOT NULL,
            author_sid INTEGER NOT NULL REFERENCES strings(id),
            subject TEXT NOT NULL
        );
        CREATE INDEX messages_message_sid ON messages(message_sid);
        CREATE INDEX messages_thread_sid ON messages(thread_sid);
        CREATE INDEX messages_author_sid ON messages(author_sid);
        CREATE INDEX messages_commit_time ON messages(commit_time DESC);
        PRAGMA user_version = 1;
    """

    def __init__(self):
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        self.db = sqlite3.connect(CACHE, timeout=30)
        self.db.execute("PRAGMA foreign_keys = ON")
        self.db.execute("PRAGMA busy_timeout = 30000")
        version = self.db.execute("PRAGMA user_version").fetchone()[0]
        if version == 0:
            self.db.executescript(self.SCHEMA)
        elif version != 1:
            sys.exit(f"unsupported index version {version}; remove {CACHE} to rebuild")
        self.gitdirs = [os.path.realpath(path) for path in epochs()]
        with self.db:
            self.db.executemany("INSERT OR IGNORE INTO epochs(path) VALUES (?)",
                                ((path,) for path in self.gitdirs))
        rows = self.db.execute(
            f"SELECT id, path FROM epochs WHERE path IN ({','.join('?' * len(self.gitdirs))})",
            self.gitdirs).fetchall()
        ids = {path: epoch_id for epoch_id, path in rows}
        self.epoch_ids = [ids[path] for path in self.gitdirs]

    @property
    def scope(self):
        return ",".join("?" * len(self.epoch_ids))

    @staticmethod
    def _log_entries(gitdir, rev, since=None):
        args = ["log", "--first-parent", "--format=%H%x00%an%x00%at%x00%s"]
        if since is not None:
            args.append(f"--since=@{since}")
        args.append(rev)
        out = git(gitdir, *args)
        entries = []
        for line in out.splitlines():
            commit, author, timestamp, subject = line.split("\0", 3)
            entries.append((commit, author, int(timestamp), subject))
        return entries

    @staticmethod
    def _log_entry(gitdir, commit):
        out = git(gitdir, "log", "-1", "--format=%H%x00%an%x00%at%x00%s", commit)
        oid, author, timestamp, subject = out.rstrip("\n").split("\0", 3)
        return oid, author, int(timestamp), subject

    def _unindexed(self, entries):
        if not entries:
            return []
        existing = set()
        oids = [entry[0] for entry in entries]
        for start in range(0, len(oids), 500):
            chunk = oids[start:start + 500]
            rows = self.db.execute(
                f"SELECT git_commit_oid FROM messages WHERE git_commit_oid IN "
                f"({','.join('?' * len(chunk))})", chunk)
            existing.update(row[0] for row in rows)
        return [entry for entry in entries if entry[0] not in existing]

    def _index_entries(self, gitdir, epoch_id, entries, blobs, progress):
        rows = []
        values = set()
        for commit, author, timestamp, subject in entries:
            message_ids, in_reply_to, refs = thread_ids(blobs.read(gitdir, commit) or b"")
            # Broken mail occasionally has an empty Message-ID. Keep it in the
            # index under an internal identity so it does not block the batch.
            message_id = (message_ids or [f"oid:{commit}"])[0]
            parent = (in_reply_to or [None])[0] or (refs or [None])[-1]
            thread = refs[0] if refs else message_id
            rows.append((commit, message_id, parent, thread, timestamp, author, subject))
            values.update((message_id, thread, author))
            if parent:
                values.add(parent)
            progress.update(timestamp)

        self.db.executemany("INSERT OR IGNORE INTO strings(value) VALUES (?)",
                            ((value,) for value in values))
        string_ids = {}
        values = list(values)
        for start in range(0, len(values), 500):
            chunk = values[start:start + 500]
            found = self.db.execute(
                f"SELECT id, value FROM strings WHERE value IN ({','.join('?' * len(chunk))})",
                chunk)
            string_ids.update((value, sid) for sid, value in found)
        self.db.executemany(
            "INSERT INTO messages(epoch_id, git_commit_oid, message_sid, parent_sid, "
            "thread_sid, commit_time, author_sid, subject) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
            ((epoch_id, commit, string_ids[message_id],
              string_ids[parent] if parent else None, string_ids[thread], timestamp,
              string_ids[author], subject)
             for commit, message_id, parent, thread, timestamp, author, subject in rows))

    def sync(self, days):
        started = time.perf_counter()
        cutoff = int(time.time()) - days * 86400
        plans = []
        for gitdir, epoch_id in zip(self.gitdirs, self.epoch_ids):
            tip, oldest, oldest_time, covered, complete = self.db.execute(
                "SELECT tip_oid, oldest_indexed_oid, oldest_indexed_time, "
                "indexed_since_time, history_complete FROM epochs WHERE id = ?",
                (epoch_id,)).fetchone()
            head = git(gitdir, "rev-parse", "HEAD").strip()
            reset = False
            if tip and tip != head:
                ancestor = subprocess.run(
                    ["git", f"--git-dir={gitdir}", "merge-base", "--is-ancestor", tip, head])
                if ancestor.returncode:
                    tip = oldest = oldest_time = covered = None
                    complete = 0
                    reset = True

            entries = []
            if tip and tip != head:
                entries.extend(self._log_entries(gitdir, f"{tip}..{head}"))

            if not complete and (covered is None or cutoff < covered):
                if oldest:
                    parents = git(gitdir, "log", "-1", "--format=%P", oldest).split()
                    start = parents[0] if parents else None
                else:
                    start = head
                older = self._log_entries(gitdir, start, cutoff) if start else []
                entries.extend(older)
                covered = cutoff
                if older:
                    oldest, _, oldest_time, _ = older[-1]
                    complete = not bool(git(gitdir, "log", "-1", "--format=%P", oldest).strip())
                elif start is None:
                    complete = 1

            unique = []
            seen = set()
            for entry in entries:
                if entry[0] not in seen:
                    seen.add(entry[0])
                    unique.append(entry)
            entries = unique if reset else self._unindexed(unique)
            plans.append((gitdir, epoch_id, reset, entries, head, oldest,
                          oldest_time, covered, complete))

        count = sum(len(plan[3]) for plan in plans)
        progress = Progress(started) if count else None
        blobs = Blobs()
        try:
            with self.db:
                for (gitdir, epoch_id, reset, entries, head, oldest,
                     oldest_time, covered, complete) in plans:
                    if reset:
                        self.db.execute("DELETE FROM messages WHERE epoch_id = ?", (epoch_id,))
                    if entries:
                        self._index_entries(gitdir, epoch_id, entries, blobs, progress)
                    self.db.execute(
                        "UPDATE epochs SET tip_oid = ?, oldest_indexed_oid = ?, "
                        "oldest_indexed_time = ?, indexed_since_time = ?, history_complete = ? "
                        "WHERE id = ?",
                        (head, oldest, oldest_time, covered, complete, epoch_id))
        except Exception:
            if progress and progress.tty:
                print(file=sys.stderr)
            raise
        if progress:
            progress.finish()

    def recent(self, days):
        cutoff = int(time.time()) - days * 86400
        yield from self.db.execute(
            f"SELECT e.path, m.git_commit_oid, a.value, m.commit_time, m.subject "
            f"FROM messages m JOIN epochs e ON e.id = m.epoch_id "
            f"JOIN strings a ON a.id = m.author_sid "
            f"WHERE m.epoch_id IN ({self.scope}) AND m.commit_time >= ? "
            f"ORDER BY m.commit_time DESC, m.id DESC",
            (*self.epoch_ids, cutoff))

    def update_dirs(self):
        found = set()
        for path, in self.db.execute("SELECT path FROM epochs"):
            directory = os.path.dirname(path)
            while not os.path.isfile(os.path.join(directory, "Makefile")):
                parent = os.path.dirname(directory)
                if parent == directory:
                    sys.exit(f"no Makefile found above registered epoch {path}")
                directory = parent
            found.add(directory)
        return sorted(found)

    def stats(self):
        messages = self.db.execute("SELECT count(*) FROM messages").fetchone()[0]
        epochs = self.db.execute(
            "SELECT path, tip_oid, oldest_indexed_oid, history_complete "
            "FROM epochs ORDER BY path").fetchall()
        return messages, epochs

    def resolve(self, sel, days):
        """Return [(gitdir, commit)] for a hash, Message-ID, lore URL, or subject regex."""
        match = re.search(r"lore\.kernel\.org/[^/]+/([^/]+)", sel)
        key = (match.group(1) if match else sel).strip().strip("<>")
        if re.fullmatch(r"[0-9a-f]{7,40}", key):
            found = self.db.execute(
                f"SELECT e.path, m.git_commit_oid FROM messages m "
                f"JOIN epochs e ON e.id = m.epoch_id "
                f"WHERE m.epoch_id IN ({self.scope}) AND m.git_commit_oid GLOB ?",
                (*self.epoch_ids, key + "*")).fetchall()
            if found:
                return found
            for gitdir, epoch_id in zip(self.gitdirs, self.epoch_ids):
                check = subprocess.run(
                    ["git", f"--git-dir={gitdir}", "cat-file", "-e", f"{key}^{{commit}}"],
                    capture_output=True)
                if check.returncode == 0:
                    commit = git(gitdir, "rev-parse", f"{key}^{{commit}}").strip()
                    entries = self._unindexed([self._log_entry(gitdir, commit)])
                    if entries:
                        progress = Progress()
                        with self.db:
                            self._index_entries(gitdir, epoch_id, entries, Blobs(), progress)
                        progress.finish()
                    return [(gitdir, commit)]

        cutoff = int(time.time()) - days * 86400
        if "@" in key:
            found = self.db.execute(
                f"SELECT e.path, m.git_commit_oid FROM messages m "
                f"JOIN epochs e ON e.id = m.epoch_id "
                f"JOIN strings s ON s.id = m.message_sid "
                f"WHERE m.epoch_id IN ({self.scope}) AND m.commit_time >= ? AND s.value = ? "
                f"ORDER BY m.commit_time DESC",
                (*self.epoch_ids, cutoff, key)).fetchall()
        else:
            found = [(gitdir, commit) for gitdir, commit, _, _, subject in self.recent(days)
                     if re.search(key, subject, re.I)]
        if not found:
            sys.exit(f"{sel} not found within {days} days; try --days")
        return found

    def thread_target(self, commit):
        return self.db.execute(
            f"SELECT message_sid, thread_sid FROM messages "
            f"WHERE epoch_id IN ({self.scope}) AND git_commit_oid = ?",
            (*self.epoch_ids, commit)).fetchone()

    def thread_nodes(self, thread_sid, days):
        cutoff = int(time.time()) - days * 86400
        rows = self.db.execute(
            f"SELECT m.message_sid, m.git_commit_oid, a.value, m.commit_time, "
            f"m.subject, m.parent_sid FROM messages m "
            f"JOIN strings a ON a.id = m.author_sid "
            f"WHERE m.epoch_id IN ({self.scope}) AND m.thread_sid = ? "
            f"AND m.commit_time >= ?",
            (*self.epoch_ids, thread_sid, cutoff))
        return {message_sid: (commit, author, timestamp, subject, parent_sid)
                for message_sid, commit, author, timestamp, subject, parent_sid in rows}


def describe(gitdir, commit):
    author, ts, subject = git(gitdir, "log", "-1", "--format=%an%x00%at%x00%s", commit).rstrip("\n").split("\0", 2)
    return f"{commit[:10]} {local_time(int(ts))} {author[:20]:20} {subject}"


def load(gitdir, commit):
    return email.message_from_bytes(Blobs().read(gitdir, commit), policy=POLICY)


def local_time(ts):
    return datetime.fromtimestamp(ts).strftime("%m-%d %H:%M")


def format_size(size):
    for unit in ("bytes", "KiB", "MiB", "GiB"):
        if size < 1024 or unit == "GiB":
            return f"{size:.0f} {unit}" if unit == "bytes" else f"{size:.1f} {unit}"
        size /= 1024


def resolve_many(index, sels, days):
    found = []
    seen = set()
    for sel in sels:
        for match in index.resolve(sel, days):
            if match not in seen:
                seen.add(match)
                found.append(match)
    return found


def cmd_ls(args):
    for gitdir, commit, author, ts, subject in args.index.recent(args.days):
        if args.author and args.author.casefold() not in author.casefold():
            continue
        if args.grep and not re.search(args.grep, subject, re.I):
            continue
        print(f"{commit[:10]} {local_time(ts)} {author[:20]:20} {subject}")


def cmd_fetch(args):
    for directory in args.index.update_dirs():
        subprocess.run(["make", "update"], cwd=directory, check=True)


def cmd_stats(args):
    messages, epochs = args.index.stats()
    print(f"Database: {os.path.abspath(CACHE)}")
    print(f"Size: {format_size(os.path.getsize(CACHE))}")
    print(f"Messages: {messages}")
    print("Epochs:")
    for path, tip, oldest, complete in epochs:
        print(f"  {path}")
        print(f"    Tip: {tip or 'unknown'}")
        print(f"    Oldest indexed: {oldest or 'none'}")
        print(f"    Complete: {'yes' if complete else 'no'}")


def cmd_show(args):
    for gitdir, commit in resolve_many(args.index, args.sels, args.days):
        if args.verbose:
            sys.stdout.write(f"From {commit} Mon Sep 17 00:00:00 2001\n")
        message = load(gitdir, commit)
        text = message.as_string(unixfrom=False).rstrip("\n")
        headers, separator, body = text.partition("\n\n")
        if not args.verbose:
            subject = message["Subject"]
            headers = subject.fold(policy=POLICY).rstrip("\n") if subject else "Subject:"
        if sys.stdout.isatty():
            body = re.sub(r"(?m)^>.*$", "\x1b[36m\\g<0>\x1b[0m", body)
        sys.stdout.write(headers + separator + body + "\n\n")


def self_addresses():
    """Addresses to drop from Cc: sendemail.from, user.email, and any pimail.self."""
    found = set()
    for key in ("sendemail.from", "user.email", "pimail.self"):
        r = subprocess.run(["git", "config", "--get-all", key], capture_output=True, text=True)
        found |= {a.lower() for _, a in email.utils.getaddresses(r.stdout.splitlines()) if a}
    return found


def prepare_reply_body(body, headers):
    if not os.path.exists(CONFIG):
        return body
    hook = runpy.run_path(CONFIG).get("prepare_reply_body")
    if hook is None:
        return body
    if not callable(hook):
        sys.exit(f"prepare_reply_body in {CONFIG} is not callable")
    body = hook(body, headers)
    if not isinstance(body, str):
        sys.exit(f"prepare_reply_body in {CONFIG} did not return a string")
    return body


def cmd_reply(args):
    found = args.index.resolve(args.sel, args.days)
    if len(found) > 1:
        print("\n".join(describe(*f) for f in found), file=sys.stderr)
        sys.exit(f"{len(found)} mails match; pick one by commit hash")
    m = load(*found[0])
    msgid = first_id(m["Message-ID"])
    if not msgid:
        sys.exit(f"{found[0][1]} has no Message-ID; cannot reply")
    sender = email.utils.getaddresses([str(m["Reply-To"] or m["From"])])
    seen = {a.lower() for _, a in sender} | self_addresses()
    cc = []
    for name, addr in email.utils.getaddresses([str(m["To"] or ""), str(m["Cc"] or "")]):
        if addr and addr.lower() not in seen:
            seen.add(addr.lower())
            cc.append(email.utils.formataddr((name, addr)))
    subject = re.sub(r"^(re:\s*)+", "", str(m["Subject"]), flags=re.I)
    refs = " ".join(f"<{r}>" for r in ids(m["References"]) + [msgid])
    name = email.utils.parseaddr(str(m["From"]))[0] or str(m["From"])
    part = m.get_body(preferencelist=("plain",))
    body = part.get_content() if part else ""
    headers = {
        "To": ", ".join(email.utils.formataddr(a) for a in sender),
        **({"Cc": ", ".join(cc)} if cc else {}),
        "Subject": f"Re: {subject}",
        "In-Reply-To": f"<{msgid}>",
        "References": refs,
        "MIME-Version": "1.0",
        "Content-Type": "text/plain; charset=UTF-8",
        "Content-Transfer-Encoding": "8bit",
    }
    body = "\n".join([
        f"On {m['Date']}, {name} wrote:",
        *(("> " + l).rstrip() for l in body.rstrip().splitlines()),
        "",
    ])
    body = prepare_reply_body(body, headers)
    lines = ["From git Mon Sep 17 00:00:00 2001",
             *(f"{key}: {value}" for key, value in headers.items()), "", body]
    out = open(args.output, "w") if args.output else sys.stdout
    out.write("\n".join(lines))


def cmd_config(args):
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    try:
        with open(CONFIG, "x") as f:
            f.write(CONFIG_TEMPLATE)
    except FileExistsError:
        pass
    editor = os.environ.get("VISUAL") or os.environ.get("EDITOR") or "vi"
    try:
        command = shlex.split(editor)
    except ValueError as error:
        sys.exit(f"invalid editor: {error}")
    if not command:
        sys.exit("editor is empty")
    subprocess.run([*command, CONFIG], check=True)


def cmd_tree(args):
    targets, threads = set(), []
    for _, commit in resolve_many(args.index, args.sels, args.days):
        message_sid, thread_sid = args.index.thread_target(commit)
        targets.add(message_sid)
        if thread_sid not in threads:
            threads.append(thread_sid)
    for i, thread_sid in enumerate(threads):
        if i:
            print()
        print_tree(args.index.thread_nodes(thread_sid, args.days), targets)


def print_tree(nodes, targets):
    """nodes: Message-ID -> (commit, author, ts, subject, parent)"""
    children = {}
    for mid, (*_, parent) in nodes.items():
        children.setdefault(parent if parent in nodes else None, []).append(mid)
    for kids in children.values():
        kids.sort(key=lambda k: nodes[k][2])

    def walk(mid, prefix, last):
        c, author, ts, subject, _ = nodes[mid]
        mark = " *" if mid in targets else ""
        print(f"{c[:10]} {local_time(ts)} {prefix}{'└─' if last else '├─'} {author}: {subject}{mark}")
        kids = children.get(mid, [])
        for i, k in enumerate(kids):
            walk(k, prefix + ("   " if last else "│  "), i == len(kids) - 1)

    tops = children.get(None, [])
    for i, mid in enumerate(tops):
        walk(mid, "", i == len(tops) - 1)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd")
    ls = sub.add_parser("ls")
    ls.add_argument("--days", type=int, default=3)
    ls.add_argument("-a", "--author")
    ls.add_argument("-g", "--grep", help="regex on subject")
    sub.add_parser("fetch")
    sub.add_parser("stats")
    config = sub.add_parser("config")
    config_sub = config.add_subparsers(dest="config_cmd", required=True)
    config_sub.add_parser("edit")
    for name in ("show", "reply", "tree"):
        p = sub.add_parser(name)
        if name in ("show", "tree"):
            p.add_argument("sels", metavar="SEL", nargs="+")
        else:
            p.add_argument("sel")
        p.add_argument("--days", type=int, default=30)
        if name == "show":
            p.add_argument("-v", "--verbose", action="store_true", help="show all headers")
        elif name == "reply":
            p.add_argument("-o", "--output")
    argv = sys.argv[1:]
    if not argv or argv[0] not in (*sub.choices, "-h", "--help"):
        argv = ["ls", *argv]
    args = ap.parse_args(argv)
    if args.cmd == "config":
        cmd_config(args)
        return
    args.index = Index()
    try:
        if args.cmd in ("fetch", "stats"):
            {"fetch": cmd_fetch, "stats": cmd_stats}[args.cmd](args)
        else:
            args.index.sync(args.days)
            {"ls": cmd_ls, "show": cmd_show, "reply": cmd_reply, "tree": cmd_tree}[args.cmd](args)
    finally:
        args.index.db.close()


if __name__ == "__main__":
    main()
