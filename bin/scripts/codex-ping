#!/usr/bin/env python3

import json
import subprocess
import sys
from pathlib import Path

CODEX = "codex"
PING_DIR = Path("/tmp/codex-ping")


def send(proc, obj):
    proc.stdin.write(json.dumps(obj) + "\n")
    proc.stdin.flush()


def recv_id(proc, wanted_id):
    while True:
        line = proc.stdout.readline()
        if not line:
            raise RuntimeError("codex app-server exited unexpectedly")

        msg = json.loads(line)

        if msg.get("id") == wanted_id:
            if "error" in msg:
                raise RuntimeError(f"JSON-RPC error: {msg['error']}")
            return msg["result"]


def get_rate_limits():
    proc = subprocess.Popen(
        [CODEX, "app-server", "--stdio"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        bufsize=1,
    )

    try:
        # 1. JSON-RPC initialization.
        send(proc, {
            "id": 1,
            "method": "initialize",
            "params": {
                "clientInfo": {
                    "name": "codex-window-starter",
                    "version": "1",
                },
                "capabilities": {},
            },
        })
        recv_id(proc, 1)

        # 2. Initialization notification.
        send(proc, {
            "method": "initialized",
            "params": {},
        })

        # 3. Read account limits.
        send(proc, {
            "id": 2,
            "method": "account/rateLimits/read",
        })

        return recv_id(proc, 2)

    finally:
        proc.terminate()
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            proc.kill()


def find_five_hour_window(result):
    # Prefer the modern multi-bucket form.
    by_id = result.get("rateLimitsByLimitId") or {}
    snapshot = by_id.get("codex")

    # Backward-compatible fallback.
    if snapshot is None:
        snapshot = result.get("rateLimits")

    if not snapshot:
        return None

    for name in ("primary", "secondary"):
        window = snapshot.get(name)

        if (
            window is not None
            and window.get("windowDurationMins") == 300
        ):
            return window

    return None


def start_window():
    PING_DIR.mkdir(parents=True, exist_ok=True)

    subprocess.run(
        [
            CODEX,
            "exec",
            "--ephemeral",
            "--ignore-user-config",
            "--ignore-rules",
            "--skip-git-repo-check",
            "--disable", "plugins",
            "--disable", "apps",
            "--disable", "tool_suggest",
            "-m", "gpt-5.6-luna",
            "-c", 'model_reasoning_effort="low"',
            "-c",
            'instructions="Reply only with the single word pong. '
            'Do not run commands or take any other action."',
            "-c", "include_permissions_instructions=false",
            "-c", "include_apps_instructions=false",
            "-c", "include_collaboration_mode_instructions=false",
            "-c", "include_environment_context=false",
            "-c", "skills.include_instructions=false",
            "-C", str(PING_DIR),
            "Reply with exactly: pong",
        ],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=30,
        check=True,
    )


def main():
    try:
        limits = get_rate_limits()
        window = find_five_hour_window(limits)

        if window is None:
            print("5-hour rate-limit window not found; doing nothing",
                  file=sys.stderr)
            return 2

        used = window["usedPercent"]

        if used != 0:
            print(f"5-hour window already active: {used}% used")
            return 0

        print("5-hour usage is 0%; starting a new window")
        start_window()
        return 0

    except Exception as e:
        print(f"error: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
