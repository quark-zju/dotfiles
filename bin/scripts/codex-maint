#!/usr/bin/env python3

"""Codex account maintenance utilities."""

import contextlib
import json
import pprint
import subprocess
import sys
from pathlib import Path

CODEX = "codex"


def send(proc, obj):
    proc.stdin.write(json.dumps(obj) + "\n")
    proc.stdin.flush()


def recv_id(proc, wanted_id):
    while True:
        line = proc.stdout.readline()
        if not line:
            raise RuntimeError("codex app-server exited unexpectedly")

        msg = json.loads(line)

        if msg.get("id") == wanted_id:
            if "error" in msg:
                raise RuntimeError(f"JSON-RPC error: {msg['error']}")
            return msg["result"]


class CodexAppServer:
    """Line-delimited JSON-RPC client for "codex app-server --stdio"."""

    def __init__(self, proc):
        self._proc = proc
        self._next_id = 1

    def call(self, method, params=None):
        request = {"id": self._next_id, "method": method}
        if params is not None:
            request["params"] = params
        self._next_id += 1

        send(self._proc, request)
        return recv_id(self._proc, request["id"])

    def initialize(self, client_name):
        self.call(
            "initialize",
            {
                "clientInfo": {"name": client_name, "version": "1"},
                "capabilities": {},
            },
        )
        send(self._proc, {"method": "initialized", "params": {}})

    def rate_limits(self):
        return self.call("account/rateLimits/read")


@contextlib.contextmanager
def codex_app_server(client_name="codex-maint"):
    proc = subprocess.Popen(
        [CODEX, "app-server", "--stdio"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        bufsize=1,
    )

    try:
        server = CodexAppServer(proc)
        server.initialize(client_name)
        yield server
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            proc.kill()


def command_show():
    with codex_app_server() as server:
        pprint.pprint(server.rate_limits())
    return 0


def main():
    return command_show()


if __name__ == "__main__":
    sys.exit(main())
