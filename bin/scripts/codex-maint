#!/usr/bin/env python3

import json
import subprocess
import sys

CODEX = "codex"


def send(proc, obj):
    proc.stdin.write(json.dumps(obj) + "\n")
    proc.stdin.flush()


def recv_id(proc, wanted_id):
    while True:
        line = proc.stdout.readline()
        if not line:
            raise RuntimeError("codex app-server exited unexpectedly")

        msg = json.loads(line)

        if msg.get("id") == wanted_id:
            if "error" in msg:
                raise RuntimeError(f"JSON-RPC error: {msg['error']}")
            return msg["result"]


def process_banked_resets():
    proc = subprocess.Popen(
        [CODEX, "app-server", "--stdio"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        bufsize=1,
    )

    try:
        # 1. JSON-RPC initialization.
        send(
            proc,
            {
                "id": 1,
                "method": "initialize",
                "params": {
                    "clientInfo": {
                        "name": "codex-reset-check",
                        "version": "1",
                    },
                    "capabilities": {},
                },
            },
        )
        recv_id(proc, 1)

        # 2. Initialization notification.
        send(
            proc,
            {
                "method": "initialized",
                "params": {},
            },
        )

        # 3. Read account limits.
        send(
            proc,
            {
                "id": 2,
                "method": "account/rateLimits/read",
            },
        )

        rate_limits = recv_id(proc, 2)

        # {'accountId': '...',
        #  'ordinaryUsageAllowed': True,
        #  'rateLimitResetCredits': {'availableCount': 2,
        #                            'credits': [{'description': 'Thanks for using '
        #                                                        "Codex! You've been "
        #                                                        'granted one free rate '
        #                                                        'limit reset.',
        #                                         'expiresAt': 1791090872,
        #                                         'grantedAt': 1788498872,
        #                                         'id': 'RateLimitResetCredit_f7...',
        #                                         'resetType': 'codexRateLimits',
        #                                         'status': 'available',
        #                                         'title': 'Full reset (Weekly + 5 hr)'},
        #                                        {'description': 'Thanks for using '
        #                                                        "Codex! You've been "
        #                                                        'granted one free rate '
        #                                                        'limit reset.',
        #                                         'expiresAt': 1791157198,
        #                                         'grantedAt': 1788565198,
        #                                         'id': 'RateLimitResetCredit_9d...',
        #                                         'resetType': 'codexRateLimits',
        #                                         'status': 'available',
        #                                         'title': 'Full reset (Weekly + 5 '
        #                                                  'hr)'}]},
        #  'rateLimitUpsell': None,
        #  'rateLimits': {'credits': {'balance': '0',
        #                             'hasCredits': False,
        #                             'unlimited': False},
        #                 'individualLimit': None,
        #                 'limitId': 'codex',
        #                 'limitName': None,
        #                 'normalModelSlug': None,
        #                 'planType': 'plus',
        #                 'primary': {'resetsAt': 1789977628,
        #                             'usedPercent': 0,
        #                             'windowDurationMins': 300},
        #                 'rateLimitReachedType': None,
        #                 'secondary': {'resetsAt': 1790476607,
        #                               'usedPercent': 46,
        #                               'windowDurationMins': 10080},
        #                 'spendControlReached': False},
        #  'rateLimitsByLimitId': {'codex': {'credits': {'balance': '0',
        #                                                'hasCredits': False,
        #                                                'unlimited': False},
        #                                    'individualLimit': None,
        #                                    'limitId': 'codex',
        #                                    'limitName': None,
        #                                    'normalModelSlug': None,
        #                                    'planType': 'plus',
        #                                    'primary': {'resetsAt': 1789977628,
        #                                                'usedPercent': 0,
        #                                                'windowDurationMins': 300},
        #                                    'rateLimitReachedType': None,
        #                                    'secondary': {'resetsAt': 1790476607,
        #                                                  'usedPercent': 46,
        #                                                  'windowDurationMins': 10080},
        #                                    'spendControlReached': False}}}

        import pprint

        pprint.pprint(rate_limits)

    finally:
        proc.terminate()
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            proc.kill()


def main():
    process_banked_resets()


if __name__ == "__main__":
    sys.exit(main())
