#!/usr/bin/env python3

"""Codex account maintenance.

Actions:
  (default)       Print the raw account rate-limit response.
  --schedule      Create a one-off systemd user timer that runs
                  "--consume <id>" 10 minutes before the next banked reset
                  expires, so the reset is not wasted.
  --consume ID    Spend one banked reset (RATE_LIMIT_RESET_CREDIT_ID).
  --start-window  Start a fresh 5-hour usage window while it is still unused.

Side effects and checks are appended to /tmp/codex-maint.log.
"""

import argparse
import contextlib
import hashlib
import json
import pprint
import shutil
import subprocess
import sys
import time
from pathlib import Path

CODEX = "codex"
PING_DIR = Path("/tmp/codex-ping")
LOG = Path("/tmp/codex-maint.log")

# systemd user units created by --schedule.
UNIT_NAME = "codex-maint-consume"
UNIT_PATTERN = f"{UNIT_NAME}*"
UNIT_DIR = Path("~/.config/systemd/user").expanduser()

# Consume a banked reset this long before it expires.
SCHEDULE_LEAD_SECONDS = 10 * 60

# Refuse to burn a banked reset that still has more than this much life left,
# unless --force is given.
FORCE_THRESHOLD_SECONDS = 60 * 60


def log(message):
    line = f"{time.strftime('%Y-%m-%d %H:%M:%S%z')} {message}"
    print(line, file=sys.stderr)
    try:
        with LOG.open("a") as log_file:
            log_file.write(line + "\n")
    except OSError as error:
        print(f"warning: cannot append to {LOG}: {error}", file=sys.stderr)


def format_time(timestamp):
    return time.strftime("%Y-%m-%d %H:%M:%S UTC", time.gmtime(timestamp))


def send(proc, obj):
    proc.stdin.write(json.dumps(obj) + "\n")
    proc.stdin.flush()


def recv_id(proc, wanted_id):
    while True:
        line = proc.stdout.readline()
        if not line:
            raise RuntimeError("codex app-server exited unexpectedly")

        msg = json.loads(line)

        if msg.get("id") == wanted_id:
            if "error" in msg:
                raise RuntimeError(f"JSON-RPC error: {msg['error']}")
            return msg["result"]


class CodexAppServer:
    """Line-delimited JSON-RPC client for "codex app-server --stdio"."""

    def __init__(self, proc):
        self._proc = proc
        self._next_id = 1

    def call(self, method, params=None):
        request = {"id": self._next_id, "method": method}
        if params is not None:
            request["params"] = params
        self._next_id += 1

        send(self._proc, request)
        return recv_id(self._proc, request["id"])

    def initialize(self, client_name):
        self.call(
            "initialize",
            {
                "clientInfo": {"name": client_name, "version": "1"},
                "capabilities": {},
            },
        )
        send(self._proc, {"method": "initialized", "params": {}})

    def rate_limits(self):
        return self.call("account/rateLimits/read")

    def consume_reset_credit(self, credit_id):
        return self.call(
            "account/rateLimitResetCredit/consume",
            {
                "idempotencyKey": reset_idempotency_key(credit_id),
                "creditId": credit_id,
            },
        )


@contextlib.contextmanager
def codex_app_server(client_name="codex-maint"):
    proc = subprocess.Popen(
        [CODEX, "app-server", "--stdio"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        bufsize=1,
    )

    try:
        server = CodexAppServer(proc)
        server.initialize(client_name)
        yield server
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            proc.kill()


def reset_idempotency_key(credit_id):
    return "auto-reset-" + hashlib.sha256(credit_id.encode()).hexdigest()[:32]


def available_credits(rate_limits):
    """Return available banked resets, the soonest expiring one first.

    rateLimitResetCredits looks like:
        {'availableCount': 2,
         'credits': [{'description': '...',
                      'expiresAt': 1791090872,
                      'grantedAt': 1788498872,
                      'id': 'RateLimitResetCredit_f7...',
                      'resetType': 'codexRateLimits',
                      'status': 'available',
                      'title': 'Full reset (Weekly + 5 hr)'}]}
    """
    credits = rate_limits.get("rateLimitResetCredits") or {}
    credits = credits.get("credits") or []

    available = [
        credit for credit in credits if credit.get("status", "available") == "available"
    ]
    available.sort(key=lambda credit: credit.get("expiresAt") or 0)
    return available


def find_credit(credits, credit_id):
    for credit in credits:
        if credit.get("id") == credit_id:
            return credit
    return None


def find_five_hour_window(rate_limits):
    """Find the 5-hour usage window in a rate-limit response.

    rateLimits / rateLimitsByLimitId['codex'] looks like:
        {'limitId': 'codex',
         'planType': 'plus',
         'primary': {'resetsAt': 1789977628,
                     'usedPercent': 0,
                     'windowDurationMins': 300},
         'secondary': {'resetsAt': 1790476607,
                       'usedPercent': 46,
                       'windowDurationMins': 10080}}
    """
    # Prefer the modern multi-bucket form.
    by_id = rate_limits.get("rateLimitsByLimitId") or {}
    snapshot = by_id.get("codex")

    # Backward-compatible fallback.
    if snapshot is None:
        snapshot = rate_limits.get("rateLimits")

    if not snapshot:
        return None

    for name in ("primary", "secondary"):
        window = snapshot.get(name)

        if window is not None and window.get("windowDurationMins") == 300:
            return window

    return None


def start_window():
    PING_DIR.mkdir(parents=True, exist_ok=True)

    subprocess.run(
        [
            CODEX,
            "exec",
            "--ephemeral",
            "--ignore-user-config",
            "--ignore-rules",
            "--skip-git-repo-check",
            "--disable",
            "plugins",
            "--disable",
            "apps",
            "--disable",
            "tool_suggest",
            "-m",
            "gpt-5.6-luna",
            "-c",
            'model_reasoning_effort="low"',
            "-c",
            (
                'instructions="Reply only with the single word pong. '
                'Do not run commands or take any other action."'
            ),
            "-c",
            "include_permissions_instructions=false",
            "-c",
            "include_apps_instructions=false",
            "-c",
            "include_collaboration_mode_instructions=false",
            "-c",
            "include_environment_context=false",
            "-c",
            "skills.include_instructions=false",
            "-C",
            str(PING_DIR),
            "Reply with exactly: pong",
        ],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=30,
        check=True,
    )


def systemctl(*args, check=True):
    if shutil.which("systemctl") is None:
        raise RuntimeError(
            "systemctl not found; --schedule needs a systemd user manager "
            "(run this on the machine whose timer should consume the reset)"
        )

    return subprocess.run(
        ["systemctl", "--user", *args],
        capture_output=True,
        text=True,
        check=check,
    )


def pending_schedule():
    """Return the pending --schedule timer, or None if there is none.

    This is checked before talking to codex, so that repeated --schedule runs
    are cheap.
    """
    result = systemctl(
        "list-timers", "--all", "--output=json", UNIT_PATTERN, check=False
    )

    if result.returncode != 0:
        raise RuntimeError(
            f"systemctl --user list-timers failed: {result.stderr.strip()}"
        )

    try:
        timers = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise RuntimeError(
            f"unexpected list-timers output: {result.stdout!r}"
        ) from error

    for timer in timers:
        # A one-shot timer that already elapsed reports next=null; only a real
        # upcoming elapse counts as pending.
        if timer.get("next"):
            return timer

    return None


def service_path():
    """PATH for the one-shot service, which otherwise lacks the login PATH."""
    codex_path = shutil.which(CODEX)

    if codex_path is None:
        return "%h/.local/bin:/usr/local/bin:/usr/bin:/bin"

    codex_dir = str(Path(codex_path).parent)
    return f"{codex_dir}:%h/.local/bin:/usr/local/bin:/usr/bin:/bin"


def write_schedule_units(credit_id, fire_at):
    UNIT_DIR.mkdir(parents=True, exist_ok=True)

    script = Path(__file__).resolve()
    service = UNIT_DIR / f"{UNIT_NAME}.service"
    timer = UNIT_DIR / f"{UNIT_NAME}.timer"

    service.write_text(
        "[Unit]\n"
        f"Description=Consume Codex banked reset {credit_id}\n"
        "\n"
        "[Service]\n"
        "Type=oneshot\n"
        f"ExecStart={script} --consume {credit_id}\n"
        f"Environment=PATH={service_path()}\n"
    )
    timer.write_text(
        "[Unit]\n"
        f"Description=Consume Codex banked reset {credit_id} before it expires\n"
        "\n"
        "[Timer]\n"
        f"OnCalendar={format_time(fire_at)}\n"
        "RemainAfterElapse=false\n"
        "\n"
        "[Install]\n"
        "WantedBy=timers.target\n"
    )

    return service, timer


def schedule_consume(credit_id, fire_at):
    service, timer = write_schedule_units(credit_id, fire_at)

    # daemon-reload picks up the rewritten unit files, and enable --now makes
    # the timer both boot persistent and start waiting now. Deliberately not
    # restart: restarting a timer that has already triggered runs its service
    # once immediately, which would fire --consume hours before the reset is
    # due, refuse it as too healthy, and waste the elapse.
    systemctl("daemon-reload")
    systemctl("enable", "--now", timer.name)

    return service, timer


def command_schedule():
    timer = pending_schedule()

    if timer is not None:
        fire_at = (timer["next"] or 0) / 1_000_000
        log(
            f"schedule: {timer['unit']} already pending for "
            f"{format_time(fire_at)}; skipping codex check"
        )
        return 0

    with codex_app_server() as server:
        rate_limits = server.rate_limits()

    now = time.time()
    credits = [
        credit
        for credit in available_credits(rate_limits)
        if (credit.get("expiresAt") or 0) > now
    ]

    if not credits:
        log("schedule: no available banked reset; nothing to do")
        return 0

    credit = credits[0]
    credit_id = credit["id"]
    expires_at = credit["expiresAt"]
    # Run 10 minutes before expiry, but never in the past.
    fire_at = max(expires_at - SCHEDULE_LEAD_SECONDS, now + 30)

    _service, timer = schedule_consume(credit_id, fire_at)
    log(
        f"schedule: {credit_id} expires {format_time(expires_at)}; "
        f"{timer.name} will consume it at {format_time(fire_at)}"
    )
    return 0


def command_consume(credit_id, force):
    with codex_app_server() as server:
        credits = available_credits(server.rate_limits())
        credit = find_credit(credits, credit_id)

        if credit is None:
            log(f"consume: {credit_id} is no longer available; nothing to do")
            return 0

        seconds_left = (credit.get("expiresAt") or 0) - time.time()

        if seconds_left > FORCE_THRESHOLD_SECONDS and not force:
            log(
                f"consume: {credit_id} is valid for another "
                f"{seconds_left / 3600:.1f}h; pass --force to spend it now"
            )
            return 3

        log(
            f"consume: spending {credit_id} "
            f"({max(seconds_left, 0) / 3600:.2f}h left, force={force})"
        )
        result = server.consume_reset_credit(credit_id)
        log(f"consume: {credit_id} done: {json.dumps(result, sort_keys=True)}")

    return 0


def command_start_window():
    with codex_app_server() as server:
        rate_limits = server.rate_limits()

    window = find_five_hour_window(rate_limits)

    if window is None:
        log("start-window: 5-hour rate-limit window not found; doing nothing")
        return 2

    used = window["usedPercent"]

    if used != 0:
        log(f"start-window: 5-hour window already active: {used}% used")
        return 0

    log("start-window: 5-hour usage is 0%; starting a new window")
    start_window()
    log("start-window: done")
    return 0


def command_show():
    with codex_app_server() as server:
        pprint.pprint(server.rate_limits())
    return 0


def parse_args(argv):
    parser = argparse.ArgumentParser(
        description="Codex account maintenance.",
        epilog="With no action given, print the raw rate-limit response.",
    )
    actions = parser.add_mutually_exclusive_group()
    actions.add_argument(
        "--schedule",
        action="store_true",
        help="systemd timer to consume the next expiring banked reset",
    )
    actions.add_argument(
        "--consume",
        metavar="RATE_LIMIT_CREDIT_ID",
        help="spend one banked reset (no-op if it no longer exists)",
    )
    actions.add_argument(
        "--start-window",
        action="store_true",
        help="start a 5-hour usage window if it is still unused",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="with --consume: spend a reset that has more than 1h left",
    )

    args = parser.parse_args(argv)

    if args.force and args.consume is None:
        parser.error("--force requires --consume")

    return args


def main(argv=None):
    args = parse_args(sys.argv[1:] if argv is None else argv)

    try:
        if args.consume is not None:
            return command_consume(args.consume, args.force)
        if args.schedule:
            return command_schedule()
        if args.start_window:
            return command_start_window()
        return command_show()
    except Exception as error:
        log(f"error: {error}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
