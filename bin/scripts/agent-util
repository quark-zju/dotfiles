#!/usr/bin/env python3
"""Inspect local coding-agent sessions, wait for them, or send Codex input."""

from __future__ import annotations

import argparse
import base64
import hashlib
import json
import os
import socket
import struct
import sys
import time
from collections.abc import Callable
from datetime import datetime
from pathlib import Path
from typing import Any

LIB_DIR = Path(__file__).resolve().parents[2] / ".local/lib/python"
sys.path.insert(0, str(LIB_DIR))

import ssh_sync_ops  # noqa: E402

Agent = dict[str, Any]
APP_SERVER_TIMEOUT = 5
TAIL_MESSAGE_TYPES = frozenset(("user", "commentary", "final"))


class AppServerClient:
    def __init__(self, socket_path: Path) -> None:
        self.socket = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            self.socket.settimeout(APP_SERVER_TIMEOUT)
            self.socket.connect(str(socket_path))
            self.buffer = b""
            self.notifications = []
            self._upgrade_websocket()
            self.next_id = 1
            self.request(
                "initialize",
                {"clientInfo": {"name": "agent-util", "version": "1"}},
            )
            self.notify("initialized", {})
        except Exception:
            self.socket.close()
            raise

    def close(self) -> None:
        self.socket.close()

    def set_timeout(self, timeout: float | None) -> None:
        self.socket.settimeout(timeout)

    def __enter__(self) -> AppServerClient:
        return self

    def __exit__(self, *_args: object) -> None:
        self.close()

    def notify(self, method: str, params: dict[str, Any]) -> None:
        self._write({"method": method, "params": params})

    def request(self, method: str, params: dict[str, Any]) -> Any:
        request_id = self.next_id
        self.next_id += 1
        self._write({"id": request_id, "method": method, "params": params})
        while True:
            response = self._read_message()
            if response.get("id") != request_id:
                if "method" in response and "id" not in response:
                    self.notifications.append(response)
                continue
            if "error" in response:
                error = response["error"]
                detail = (
                    error.get("message", error) if isinstance(error, dict) else error
                )
                raise RuntimeError(f"app-server {method} failed: {detail}")
            return response.get("result")

    def next_notification(self) -> dict[str, Any]:
        if self.notifications:
            return self.notifications.pop(0)
        while True:
            message = self._read_message()
            if "method" in message and "id" not in message:
                return message

    def _read_message(self) -> dict[str, Any]:
        message = json.loads(self._read_text())
        if not isinstance(message, dict):
            raise RuntimeError("app-server returned a non-object message")
        return message

    def _write(self, message: dict[str, Any]) -> None:
        payload = json.dumps(message, separators=(",", ":")).encode()
        self._write_frame(0x1, payload)

    def _upgrade_websocket(self) -> None:
        key = base64.b64encode(os.urandom(16)).decode()
        request = (
            "GET /rpc HTTP/1.1\r\n"
            "Host: localhost\r\n"
            "Upgrade: websocket\r\n"
            "Connection: Upgrade\r\n"
            f"Sec-WebSocket-Key: {key}\r\n"
            "Sec-WebSocket-Version: 13\r\n"
            "\r\n"
        )
        self.socket.sendall(request.encode())
        headers = self._read_until(b"\r\n\r\n").decode("ascii")
        lines = headers.split("\r\n")
        if not lines[0].startswith("HTTP/1.1 101 "):
            raise RuntimeError(f"app-server WebSocket upgrade failed: {lines[0]}")
        fields = {
            name.lower(): value.strip()
            for line in lines[1:]
            if ":" in line
            for name, value in [line.split(":", 1)]
        }
        expected = base64.b64encode(
            hashlib.sha1(
                (key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode(),
                usedforsecurity=False,
            ).digest()
        ).decode()
        if fields.get("sec-websocket-accept") != expected:
            raise RuntimeError("app-server returned an invalid WebSocket accept key")

    def _read_until(self, marker: bytes) -> bytes:
        while marker not in self.buffer:
            chunk = self.socket.recv(65536)
            if not chunk:
                raise RuntimeError("app-server closed the connection")
            self.buffer += chunk
        end = self.buffer.index(marker) + len(marker)
        result, self.buffer = self.buffer[:end], self.buffer[end:]
        return result

    def _read_exact(self, length: int) -> bytes:
        while len(self.buffer) < length:
            chunk = self.socket.recv(max(65536, length - len(self.buffer)))
            if not chunk:
                raise RuntimeError("app-server closed the connection")
            self.buffer += chunk
        result, self.buffer = self.buffer[:length], self.buffer[length:]
        return result

    def _read_text(self) -> str:
        while True:
            first, second = self._read_exact(2)
            final = bool(first & 0x80)
            opcode = first & 0x0F
            length = second & 0x7F
            if length == 126:
                length = struct.unpack("!H", self._read_exact(2))[0]
            elif length == 127:
                length = struct.unpack("!Q", self._read_exact(8))[0]
            if second & 0x80:
                mask = self._read_exact(4)
                payload = bytes(
                    value ^ mask[index % 4]
                    for index, value in enumerate(self._read_exact(length))
                )
            else:
                payload = self._read_exact(length)
            if opcode == 0x9:
                self._write_frame(0xA, payload)
                continue
            if opcode == 0x8:
                raise RuntimeError("app-server closed the WebSocket")
            if opcode != 0x1 or not final:
                raise RuntimeError("app-server returned an unsupported WebSocket frame")
            return payload.decode()

    def _write_frame(self, opcode: int, payload: bytes) -> None:
        mask = os.urandom(4)
        length = len(payload)
        if length < 126:
            header = bytes((0x80 | opcode, 0x80 | length))
        elif length < 2**16:
            header = bytes((0x80 | opcode, 0xFE)) + struct.pack("!H", length)
        else:
            header = bytes((0x80 | opcode, 0xFF)) + struct.pack("!Q", length)
        masked = bytes(value ^ mask[index % 4] for index, value in enumerate(payload))
        self.socket.sendall(header + mask + masked)


def state(agent: Agent) -> str:
    if agent.get("suspended"):
        return "suspended"
    if agent.get("working"):
        return "working"
    if agent.get("status") == "waiting":
        return "waiting"
    return "idle"


def compact(value: object) -> str:
    return " ".join(str(value).split())


def last_message(agent: Agent) -> str:
    messages = agent.get("user_messages")
    if not isinstance(messages, list) or not messages:
        return ""
    message = messages[-1]
    return compact(message.get("message", "")) if isinstance(message, dict) else ""


def print_agents(agents: list[Agent]) -> None:
    headings = ("SESSION", "HARNESS", "STATE", "PID", "REPO", "CWD", "MESSAGE")
    rows = [
        (
            str(agent.get("session_id", "")),
            str(agent.get("harness", "codex")),
            state(agent),
            str(agent.get("pid", "")),
            compact(agent.get("repo_name") or ""),
            compact(agent.get("cwd") or ""),
            last_message(agent),
        )
        for agent in agents
    ]
    widths = [
        max(len(row[index]) for row in (headings, *rows))
        for index in range(len(headings) - 1)
    ]

    def format_row(row: tuple[str, ...]) -> str:
        fields = [row[index].ljust(widths[index]) for index in range(len(widths))]
        fields.append(row[-1])
        return "  ".join(fields).rstrip()

    print(format_row(headings))
    for row in rows:
        print(format_row(row))


def resolve_session(agents: list[Agent], query: str) -> Agent:
    exact = [agent for agent in agents if agent.get("session_id") == query]
    if exact:
        return exact[0]
    matches = [
        agent
        for agent in agents
        if isinstance(agent.get("session_id"), str)
        and agent["session_id"].startswith(query)
    ]
    if not matches:
        raise ValueError(f"no current session matches {query!r}")
    if len(matches) > 1:
        ids = ", ".join(str(agent["session_id"]) for agent in matches)
        raise ValueError(f"session prefix {query!r} is ambiguous: {ids}")
    return matches[0]


def wait_for_session(
    query: str,
    interval: float,
    list_agents: Callable[[], list[Agent]] = ssh_sync_ops.list_running_agents,
    sleep: Callable[[float], None] = time.sleep,
) -> tuple[str, Agent | None]:
    agent = resolve_session(list_agents(), query)
    session_id = agent["session_id"]
    while state(agent) == "working":
        sleep(interval)
        agent = next(
            (
                candidate
                for candidate in list_agents()
                if candidate.get("session_id") == session_id
            ),
            None,
        )
        if agent is None:
            break
    return session_id, agent


def app_server_sessions(
    socket_dir: Path | None = None,
    client_factory: Callable[[Path], AppServerClient] = AppServerClient,
) -> list[Agent]:
    if socket_dir is None:
        runtime_dir = os.environ.get("XDG_RUNTIME_DIR")
        if not runtime_dir or not os.path.isabs(runtime_dir):
            raise RuntimeError("XDG_RUNTIME_DIR must be set to an absolute path")
        socket_dir = Path(runtime_dir, "codex-app-server")

    agents = {}
    for socket_path in sorted(socket_dir.glob("*.sock")):
        try:
            with client_factory(socket_path) as client:
                cursor = None
                while True:
                    params = {"limit": 100, "useStateDbOnly": True}
                    if cursor is not None:
                        params["cursor"] = cursor
                    result = client.request("thread/list", params)
                    for thread in result.get("data", []):
                        session_id = thread.get("id")
                        status = thread.get("status")
                        if (
                            isinstance(session_id, str)
                            and isinstance(status, dict)
                            and status.get("type") != "notLoaded"
                        ):
                            agents[session_id] = {
                                "session_id": session_id,
                                "app_server_socket": socket_path,
                            }
                    cursor = result.get("nextCursor")
                    if not cursor:
                        break
        except (OSError, RuntimeError, json.JSONDecodeError):
            continue
    return list(agents.values())


def send_message(
    query: str,
    message: str,
    wait: bool = False,
    socket_dir: Path | None = None,
    client_factory: Callable[[Path], AppServerClient] = AppServerClient,
    on_intermediate: Callable[[str], None] | None = None,
) -> tuple[str, str | None]:
    agent = resolve_session(
        app_server_sessions(socket_dir, client_factory),
        query,
    )
    session_id = agent["session_id"]
    with client_factory(agent["app_server_socket"]) as client:
        if wait:
            client.request(
                "thread/resume",
                {"threadId": session_id, "excludeTurns": True},
            )
        result = client.request(
            "turn/start",
            {
                "threadId": session_id,
                "input": [{"type": "text", "text": message}],
            },
        )
        if not wait:
            return session_id, None
        client.set_timeout(None)
        turn_id = result["turn"]["id"]
        final_message = ""
        while True:
            notification = client.next_notification()
            params = notification.get("params", {})
            if params.get("threadId") != session_id:
                continue

            if (
                notification.get("method") == "item/completed"
                and params.get("turnId") == turn_id
            ):
                item = params.get("item", {})
                if item.get("type") != "agentMessage":
                    continue
                text = item.get("text", "")
                phase = item.get("phase")
                if phase == "commentary" and text and on_intermediate is not None:
                    on_intermediate(text)
                elif phase in (None, "final_answer") and isinstance(text, str):
                    final_message = text
                continue

            if notification.get("method") != "turn/completed":
                continue
            turn = params.get("turn", {})
            if turn.get("id") != turn_id:
                continue
            summary = next(
                (
                    item.get("text", "")
                    for item in reversed(turn.get("items", []))
                    if item.get("type") == "agentMessage"
                    and item.get("phase") in (None, "final_answer")
                ),
                final_message,
            )
            if turn.get("status") == "failed" and not summary:
                error = turn.get("error") or {}
                raise RuntimeError(error.get("message", "Codex turn failed"))
            return session_id, summary


def tail_messages(
    query: str,
    count: int = 10,
    message_types: frozenset[str] = TAIL_MESSAGE_TYPES,
    socket_dir: Path | None = None,
    client_factory: Callable[[Path], AppServerClient] = AppServerClient,
) -> tuple[str, list[tuple[str, str, int | None]]]:
    if count <= 0:
        raise ValueError("message count must be positive")
    agent = resolve_session(
        app_server_sessions(socket_dir, client_factory),
        query,
    )
    session_id = agent["session_id"]
    messages = []
    with client_factory(agent["app_server_socket"]) as client:
        cursor = None
        while len(messages) < count:
            params = {
                "threadId": session_id,
                "limit": min(max(count, 20), 100),
                "sortDirection": "desc",
            }
            if cursor is not None:
                params["cursor"] = cursor
            result = client.request("thread/items/list", params)
            for entry in result.get("data", []):
                item = entry.get("item", {})
                item_type = item.get("type")
                if item_type == "userMessage" and "user" in message_types:
                    text = "\n".join(
                        part.get("text", "")
                        for part in item.get("content", [])
                        if part.get("type") == "text"
                    )
                    message_type = "user"
                elif item_type == "agentMessage":
                    phase = item.get("phase")
                    if phase == "commentary":
                        message_type = "commentary"
                    elif phase in (None, "final_answer"):
                        message_type = "final"
                    else:
                        continue
                    if message_type not in message_types:
                        continue
                    text = item.get("text", "")
                else:
                    continue
                if text:
                    messages.append((message_type, text, entry.get("turnId")))
                    if len(messages) == count:
                        break
            cursor = result.get("nextCursor")
            if not cursor:
                break

        # Persisted items do not have timestamps, so use their turn boundaries.
        turn_times = {}
        remaining_turns = {turn_id for _, _, turn_id in messages if turn_id}
        cursor = None
        while remaining_turns:
            params = {
                "threadId": session_id,
                "limit": min(max(len(remaining_turns), 20), 100),
                "sortDirection": "desc",
                "itemsView": "notLoaded",
            }
            if cursor is not None:
                params["cursor"] = cursor
            result = client.request("thread/turns/list", params)
            for turn in result.get("data", []):
                turn_id = turn.get("id")
                if turn_id in remaining_turns:
                    turn_times[turn_id] = (
                        turn.get("startedAt"),
                        turn.get("completedAt"),
                    )
                    remaining_turns.remove(turn_id)
            cursor = result.get("nextCursor")
            if not cursor:
                break
    messages.reverse()
    timestamped_messages = []
    for message_type, text, turn_id in messages:
        started_at, completed_at = turn_times.get(turn_id, (None, None))
        timestamp = started_at if message_type == "user" else completed_at or started_at
        timestamped_messages.append((message_type, text, timestamp))
    return session_id, timestamped_messages


def local_timestamp(timestamp: float) -> str:
    return datetime.fromtimestamp(timestamp).strftime("%Y-%m-%d %H:%M:%S")


def message_text(parts: list[str], input_stream: Any = None) -> str:
    if parts:
        return " ".join(parts)
    if input_stream is None:
        input_stream = sys.stdin
    message = input_stream.read()
    if not message.strip():
        raise ValueError("message must be provided as arguments or stdin")
    return message


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="inspect local Codex and Claude Code agent sessions",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("list", help="list current sessions")
    tail_parser = subparsers.add_parser(
        "tail", help="show recent messages from a Codex app-server session"
    )
    tail_parser.add_argument("session", help="session ID or unique ID prefix")
    tail_parser.add_argument(
        "-n",
        "--count",
        type=int,
        default=10,
        metavar="COUNT",
        help="number of messages to show (default: 10)",
    )
    tail_parser.add_argument(
        "--user",
        dest="message_types",
        action="append_const",
        const="user",
        help="show user messages",
    )
    tail_parser.add_argument(
        "--commentary",
        dest="message_types",
        action="append_const",
        const="commentary",
        help="show agent commentary messages",
    )
    tail_parser.add_argument(
        "--final",
        "--summary",
        dest="message_types",
        action="append_const",
        const="final",
        help="show final summary messages",
    )
    tail_parser.add_argument(
        "--no-timestamp",
        dest="timestamp",
        action="store_false",
        help="omit local timestamps",
    )
    tail_parser.epilog = "If no message type is selected, all types are shown."
    wait_parser = subparsers.add_parser(
        "wait", help="wait for a session to stop working"
    )
    wait_parser.add_argument("session", help="session ID or unique ID prefix")
    wait_parser.add_argument(
        "--interval",
        type=float,
        default=1.0,
        metavar="SECONDS",
        help="poll interval (default: 1 second)",
    )
    send_parser = subparsers.add_parser(
        "send", help="send a message to a Codex app-server session"
    )
    send_parser.add_argument("session", help="session ID or unique ID prefix")
    send_parser.add_argument(
        "message",
        nargs="*",
        help="message text (default: read from stdin)",
    )
    send_parser.add_argument(
        "--wait",
        action="store_true",
        help="print agent commentary and wait for the final message",
    )
    send_parser.add_argument(
        "--no-timestamp",
        dest="timestamp",
        action="store_false",
        help="omit local timestamps from waited messages",
    )
    args = parser.parse_args()
    if args.command == "wait" and args.interval <= 0:
        parser.error("--interval must be positive")
    if args.command == "tail" and args.count <= 0:
        parser.error("--count must be positive")
    return args


def main() -> int:
    args = parse_args()
    if args.command == "list":
        print_agents(ssh_sync_ops.list_running_agents())
        return 0

    if args.command == "tail":
        try:
            _session_id, messages = tail_messages(
                args.session,
                args.count,
                frozenset(args.message_types or TAIL_MESSAGE_TYPES),
            )
        except (OSError, RuntimeError, ValueError, json.JSONDecodeError) as error:
            print(f"agent-util: {error}", file=sys.stderr)
            return 1
        for index, (message_type, text, timestamp) in enumerate(messages):
            if index:
                print()
            timestamp_hint = (
                f" [{local_timestamp(timestamp)}]"
                if args.timestamp and timestamp is not None
                else ""
            )
            print(f"--- {message_type}{timestamp_hint} ---")
            print(text)
        return 0

    if args.command == "send":

        def print_intermediate(text: str) -> None:
            timestamp_hint = (
                f"[{local_timestamp(time.time())}] " if args.timestamp else ""
            )
            print(f"{timestamp_hint}{text}", end="\n\n", flush=True)

        try:
            session_id, summary = send_message(
                args.session,
                message_text(args.message),
                args.wait,
                on_intermediate=print_intermediate,
            )
        except KeyboardInterrupt:
            return 130
        except (OSError, RuntimeError, ValueError, json.JSONDecodeError) as error:
            print(f"agent-util: {error}", file=sys.stderr)
            return 1
        if args.wait:
            if summary:
                timestamp_hint = (
                    f" [{local_timestamp(time.time())}]" if args.timestamp else ""
                )
                print(f"--- final{timestamp_hint} ---")
                print(summary)
        else:
            print(f"{session_id}  sent")
        return 0

    try:
        session_id, agent = wait_for_session(args.session, args.interval)
    except ValueError as error:
        print(f"agent-util: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130

    if agent is None:
        print(f"{session_id}  exited")
    else:
        print(f"{session_id}  {state(agent)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
